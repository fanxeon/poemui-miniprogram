<view class="{{rootClass}} {{customClass}}" style="{{customStyle}};{{rootStyle}}" role="{{clickable ? 'button' : 'region'}}" aria-label="{{ariaLabel}}" aria-disabled="{{disabled}}" hover-class="{{clickable && !disabled ? 'pui-card--hover' : 'none'}}" bindtap="onTap"><view wx:if="{{showHeader || title || description}}" class="pui-card__header"><view wx:if="{{title}}" class="pui-card__title">{{title}}</view><view wx:if="{{description}}" class="pui-card__description">{{description}}</view><slot name="header"></slot></view><view class="pui-card__content"><slot></slot></view><view wx:if="{{showFooter}}" class="pui-card__footer" catchtap="onFooterTap"><slot name="footer"></slot></view></view>
