<pui-config-provider class="codex-config-provider" use-global-config>
  <view class="codex-page {{backgroundGradientEnabled ? 'codex-page--gradient' : ''}}">
    <view id="codex-navbar" class="codex-page__navbar">
      <pui-navbar
        title="安装"
        left-arrow="{{false}}"
        fixed="{{false}}"
        capsule="{{true}}"
        safe-area-inset-top="{{true}}"
        bordered="{{false}}"
      >
        <view slot="left" class="pui-flex pui-items-center pui-gap-xxs pui-min-w-0">
          <pui-button
            id="codex-info"
            theme="default"
            variant="text"
            surface="transparent"
            size="extra-small"
            shape="circle"
            icon="info-circle"
            icon-only
            aria-label="查看安装页说明"
            bind:click="onOpenInfo"
          />
          <pui-button
            id="codex-appearance-menu"
            theme="default"
            variant="text"
            surface="transparent"
            size="extra-small"
            shape="circle"
            icon="menu"
            icon-only
            aria-label="打开外观设置"
            bind:click="onOpenAppearance"
          />
        </view>
      </pui-navbar>
    </view>

    <view class="codex-page__content-row" style="height: {{contentHeight}};">
      <pui-scroll-area
        wx:if="{{layoutReady}}"
        class="codex-page__scroll-area"
        height="{{contentHeight}}"
        gradient-overlay
        gradient-overlay-size="md"
        aria-label="安装使用说明"
      >
        <view class="codex-page__content">
          <pui-top-loading
            id="codex-page-top-loading"
            state="{{codePageLoadingState}}"
            aria-label="{{codePageLoadingState === 'success' ? '云端 Code 内容已同步' : '正在读取云端 Code 内容'}}"
          />

          <view wx:if="{{codePageLoadState === 'loading'}}" class="codex-page__load-state">
            <pui-loading loading text="正在读取云端内容" layout="vertical" aria-label="正在读取云端 Code 内容" />
          </view>

          <view wx:elif="{{codePageLoadState === 'error'}}" class="codex-page__load-state">
            <pui-empty icon="error-circle" description="{{codePageError}}" aria-label="云端 Code 内容读取失败">
              <pui-button slot="action" theme="primary" block content="重新读取" aria-label="重新读取云端 Code 内容" bind:click="onRetryCodePage" />
            </pui-empty>
          </view>

          <view wx:elif="{{codePageLoadState === 'empty'}}" class="codex-page__load-state">
            <pui-empty icon="cloud" description="云端尚未发布 Code 页面内容。" aria-label="云端 Code 内容为空">
              <pui-button slot="action" theme="primary" block content="重新读取" aria-label="重新读取云端 Code 内容" bind:click="onRetryCodePage" />
            </pui-empty>
          </view>

          <block wx:elif="{{codePage}}">
            <component-page-section
              title="{{codePage.quickStart.title}}"
              subtitle="{{codePage.quickStart.subtitle}}"
              description="{{codePage.quickStart.description}}"
            >
              <view class="codex-page__stack">
                <code-snippet
                  wx:for="{{codePage.quickStart.snippets}}"
                  wx:key="id"
                  id="codex-snippet-{{item.id}}"
                  title="{{item.title}}"
                  code="{{item.code}}"
                  aria-label="{{item.ariaLabel}}"
                />
              </view>
            </component-page-section>

            <component-page-section
              title="{{codePage.skillSection.title}}"
              subtitle="{{codePage.skillSection.subtitle}}"
              description="{{codePage.skillSection.description}}"
            >
              <view wx:if="{{skills.length}}" class="codex-page__skills">
                <view wx:for="{{skills}}" wx:key="id" class="codex-page__skill">
                  <pui-card padding="compact" bordered="{{true}}" shadow="{{false}}" aria-label="{{item.name}}">
                    <view class="codex-page__skill-card">
                      <view class="codex-page__skill-icon" aria-hidden="true">
                        <pui-icon name="{{item.icon}}" size="40" />
                      </view>
                      <view class="codex-page__skill-main">
                        <view class="codex-page__skill-heading">
                          <text class="codex-page__skill-name">{{item.name}}</text>
                          <pui-tag wx:if="{{item.version}}" content="{{item.version}}" theme="primary" variant="light" size="small" shape="round" />
                        </view>
                        <text class="codex-page__skill-summary">{{item.summary}}</text>
                        <view wx:if="{{item.capabilities.length}}" class="codex-page__skill-capabilities" aria-label="{{item.name + '能力'}}">
                          <pui-tag wx:for="{{item.capabilities}}" wx:for-item="capability" wx:key="*this" content="{{capability}}" size="small" shape="round" />
                        </view>
                      </view>
                    </view>
                  </pui-card>
                  <code-snippet
                    wx:if="{{item.installCode}}"
                    id="codex-skill-{{item.id}}-snippet"
                    title="{{item.installTitle}}"
                    code="{{item.installCode}}"
                    aria-label="{{'复制 ' + item.name + ' 安装代码'}}"
                  />
                </view>
              </view>
              <pui-empty
                wx:else
                icon="codex"
                description="{{codePage.skillSection.emptyDescription}}"
                aria-label="Skill 暂无已发布内容"
              />
            </component-page-section>
          </block>
        </view>
      </pui-scroll-area>
    </view>

    <pui-dialog
      id="codex-info-dialog"
      visible="{{infoDialogVisible}}"
      title="关于安装"
      content="安装示例与 Skill 均从共享云端读取，仅展示已发布内容。"
      close-btn="{{true}}"
      close-on-overlay-click
      confirm-btn="{{infoDialogConfirmBtn}}"
      using-custom-navbar
      aria-label="安装页说明"
      bind:confirm="onCloseInfo"
      bind:close="onCloseInfo"
    />

    <pui-popup
      id="codex-appearance-popup"
      visible="{{appearancePopupVisible}}"
      placement="bottom"
      card="{{true}}"
      show-header
      title="外观"
      blur-overlay
      prevent-scroll-through
      z-index="11010"
      aria-label="外观设置"
      bind:visible-change="onAppearancePopupVisibleChange"
    >
      <pui-button
        slot="header-left"
        theme="primary"
        variant="base"
        shape="circle"
        size="small"
        icon="refresh"
        icon-only
        aria-label="恢复默认外观"
        bind:click="onResetAppearance"
      />
      <appearance-settings />
    </pui-popup>

    <view id="codex-tabbar" class="codex-page__tabbar">
      <pui-tabbar
        items="{{tabbarItems}}"
        value="{{activeTab}}"
        theme="normal"
        shape="normal"
        split="{{true}}"
        fixed="{{false}}"
        safe-area-inset-bottom="{{true}}"
        bind:change="onTabChange"
      />
    </view>
  </view>
</pui-config-provider>
