.codex-config-provider,
.codex-page {
  display: block;
  width: 100%;
  height: 100%;
  min-height: 0;
}

.codex-page {
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  color: var(--pui-text-primary);
  font-family: var(--pui-font-family-sans);
  background: var(--pui-bg-page);
}

.codex-page--gradient {
  background: linear-gradient(145deg, var(--pui-bg-page), var(--pui-bg-muted));
}

.codex-page__navbar,
.codex-page__tabbar {
  flex: 0 0 auto;
  width: 100%;
  min-width: 0;
}

.codex-page__content-row {
  flex: 0 0 auto;
  width: 100%;
  min-height: 0;
  overflow: hidden;
}

.codex-page__scroll-area,
.codex-page__content {
  box-sizing: border-box;
  width: 100%;
  min-width: 0;
}

.codex-page__content {
  display: flex;
  flex-direction: column;
  gap: var(--pui-section-gap);
  padding: var(--pui-panel-padding);
  padding-bottom: calc(var(--pui-panel-padding) + var(--pui-scroll-area-gradient-overlay-size-md));
}

.codex-page__stack {
  display: flex;
  flex-direction: column;
  gap: var(--pui-content-gap);
  width: 100%;
  min-width: 0;
}

.codex-page__skill-placeholder {
  box-sizing: border-box;
  display: flex;
  min-height: var(--pui-space-xxl);
  align-items: center;
  justify-content: center;
  gap: var(--pui-content-gap);
  color: var(--pui-text-placeholder);
  font-family: var(--pui-font-family-mono);
  font-size: var(--pui-font-size-body-medium);
  font-weight: var(--pui-font-weight-medium);
  line-height: var(--pui-line-height-body-medium);
}
