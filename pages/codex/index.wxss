.codex-config-provider,
.codex-page {
  display: block;
  width: 100%;
  height: 100%;
  min-height: 0;
}

.codex-page {
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  color: var(--pui-text-primary);
  font-family: var(--pui-font-family-sans);
  background: var(--pui-bg-page);
}

.codex-page--gradient {
  background: linear-gradient(145deg, var(--pui-bg-page), var(--pui-bg-muted));
}

.codex-page__navbar,
.codex-page__tabbar {
  flex: 0 0 auto;
  width: 100%;
  min-width: 0;
}

.codex-page__content-row {
  flex: 0 0 auto;
  width: 100%;
  min-height: 0;
  overflow: hidden;
}

.codex-page__scroll-area,
.codex-page__content {
  box-sizing: border-box;
  width: 100%;
  min-width: 0;
}

.codex-page__content {
  display: flex;
  flex-direction: column;
  gap: var(--pui-section-gap);
  padding: var(--pui-panel-padding);
  padding-bottom: calc(var(--pui-panel-padding) + var(--pui-scroll-area-gradient-overlay-size-md));
}

.codex-page__stack {
  display: flex;
  flex-direction: column;
  gap: var(--pui-content-gap);
  width: 100%;
  min-width: 0;
}

.codex-page__load-state {
  box-sizing: border-box;
  display: flex;
  width: 100%;
  min-width: 0;
  flex: 1 1 auto;
  align-items: center;
  justify-content: center;
  padding: var(--pui-space-xxl) 0;
}

.codex-page__skills,
.codex-page__skill,
.codex-page__skill-main {
  box-sizing: border-box;
  display: flex;
  width: 100%;
  min-width: 0;
  flex-direction: column;
}

.codex-page__skills,
.codex-page__skill {
  gap: var(--pui-content-gap);
}

.codex-page__skill-card {
  display: flex;
  width: 100%;
  min-width: 0;
  align-items: flex-start;
  gap: var(--pui-content-gap);
}

.codex-page__skill-icon {
  display: flex;
  flex: 0 0 auto;
  width: var(--pui-space-xxl);
  height: var(--pui-space-xxl);
  align-items: center;
  justify-content: center;
  color: var(--pui-color-brand);
}

.codex-page__skill-main {
  flex: 1 1 0;
  gap: var(--pui-space-sm);
}

.codex-page__skill-heading,
.codex-page__skill-capabilities {
  display: flex;
  min-width: 0;
  align-items: center;
  flex-wrap: wrap;
  gap: var(--pui-space-sm);
}

.codex-page__skill-name {
  color: var(--pui-text-primary);
  font-size: var(--pui-font-size-body-medium);
  font-weight: var(--pui-font-weight-semibold);
  line-height: var(--pui-line-height-body-medium);
}

.codex-page__skill-summary {
  color: var(--pui-text-secondary);
  font-size: var(--pui-font-size-body-small);
  line-height: var(--pui-line-height-body-small);
  overflow-wrap: anywhere;
}
