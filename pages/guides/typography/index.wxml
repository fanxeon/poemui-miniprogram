<pui-config-provider class="component-config-provider" use-global-config><view class="component-page {{backgroundGradientEnabled ? 'component-page--gradient' : ''}}"><view id="component-navbar" class="component-page__navbar"><component-page-navbar title="{{pageTitle}}" bind:back="onBack" /></view><view class="component-page__scroll-row" style="height: {{scrollAreaHeight}};"><pui-scroll-area wx:if="{{layoutReady}}" class="component-page__scroll-area" height="{{scrollAreaHeight}}" gradient-overlay><view class="component-page__content"><component-page-section title="字号与行高" subtitle="可读优先" description="标题、正文和辅助信息使用同名字体与行高 Token，避免以过小文字制造层级。"><view class="component-page__stack"><text class="pui-text-title-md">标题层级清楚</text><text class="pui-text-body-md">正文使用稳定字号与行高，适合连续阅读。</text><text class="pui-text-caption pui-text-secondary">辅助信息仍应保持基本可读性。</text></view></component-page-section><component-page-section title="截断与换行" subtitle="不掩盖信息" description="pui-text-cut 仅用于可省略的次要单行信息，关键状态应换行或调整结构。"><pui-cell title="代码与正文" description="代码使用 mono Token；正文使用 sans Token，组件不在页面重写字体栈。" left-icon="text" /></component-page-section></view></pui-scroll-area></view></view></pui-config-provider>
