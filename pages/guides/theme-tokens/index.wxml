<pui-config-provider class="component-config-provider" use-global-config><view class="component-page {{backgroundGradientEnabled ? 'component-page--gradient' : ''}}"><view id="component-navbar" class="component-page__navbar"><component-page-navbar title="{{pageTitle}}" bind:back="onBack" /></view><view class="component-page__scroll-row" style="height: {{scrollAreaHeight}};"><pui-scroll-area wx:if="{{layoutReady}}" class="component-page__scroll-area" height="{{scrollAreaHeight}}" gradient-overlay><view class="component-page__content"><component-page-section title="主题来源" subtitle="统一变量" description="主题变量来自 common/style/theme.wxss，组件使用语义 Token 而非页面私有颜色。"><pui-cell title="页面与容器" description="--pui-bg-page、--pui-bg-container 和文字 Token 随主题切换。" left-icon="palette" /><pui-cell title="字体与圆角" description="字号、行高、字重和语义圆角由同一主题层提供。" left-icon="text" /></component-page-section><component-page-section title="使用边界" subtitle="Provider" description="通过 ConfigProvider 切换全局或局部主题；不要在页面重新写一套色值。"><pui-tag theme="primary" variant="outline">语义 Token</pui-tag></component-page-section></view></pui-scroll-area></view></view></pui-config-provider>
