<pui-config-provider class="component-config-provider" use-global-config><view class="component-page {{backgroundGradientEnabled ? 'component-page--gradient' : ''}}"><view id="component-navbar" class="component-page__navbar"><component-page-navbar title="{{pageTitle}}" bind:back="onBack" /></view><view class="component-page__scroll-row" style="height: {{scrollAreaHeight}};"><pui-scroll-area wx:if="{{layoutReady}}" class="component-page__scroll-area" height="{{scrollAreaHeight}}" gradient-overlay><view class="component-page__content"><component-page-section title="语义颜色" subtitle="信息层级" description="颜色表达语义和层级，使用现有主题 Token，不在页面写固定十六进制值。"><view class="component-page__row"><pui-tag theme="primary">主要操作</pui-tag><pui-tag theme="success" variant="outline">成功</pui-tag><pui-tag theme="warning" variant="outline">提醒</pui-tag><pui-tag theme="danger" variant="outline">风险</pui-tag></view></component-page-section><component-page-section title="中性色" subtitle="阅读优先级" description="页面、容器、正文和辅助文案分别读取 --pui-bg-* 与 --pui-text-* 语义变量。"><pui-cell title="不以颜色承载唯一信息" description="状态文字、图标和可访问名称共同表达含义。" left-icon="info-circle" /></component-page-section></view></pui-scroll-area></view></view></pui-config-provider>
