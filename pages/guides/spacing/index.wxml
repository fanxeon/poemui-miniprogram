<pui-config-provider class="component-config-provider" use-global-config><view class="component-page {{backgroundGradientEnabled ? 'component-page--gradient' : ''}}"><view id="component-navbar" class="component-page__navbar"><component-page-navbar title="{{pageTitle}}" bind:back="onBack" /></view><view class="component-page__scroll-row" style="height: {{scrollAreaHeight}};"><pui-scroll-area wx:if="{{layoutReady}}" class="component-page__scroll-area" height="{{scrollAreaHeight}}" gradient-overlay><view class="component-page__content"><component-page-section title="语义节奏" subtitle="从分区到控件" description="分区、面板、列表、内容组合、控件内部和紧密信息按既有空间 Token 递减。"><view class="component-page__stack"><pui-cell title="分区" description="使用 --pui-section-gap，建立主要内容层级。" left-icon="layers" /><pui-cell title="内容组合" description="使用 --pui-content-gap，保持关联内容一致。" left-icon="rows" /><pui-cell title="紧密信息" description="使用 --pui-space-xs 或更小语义 Token。" left-icon="align-left" /></view></component-page-section><component-page-section title="工具类" subtitle="按需组合" description="pui-gap、pui-p 与 pui-m 工具类均映射到同一组空间 Token。"><pui-tag theme="primary" variant="outline">避免页面魔法间距</pui-tag></component-page-section></view></pui-scroll-area></view></view></pui-config-provider>
