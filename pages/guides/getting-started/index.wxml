<pui-config-provider class="component-config-provider" use-global-config><view class="component-page {{backgroundGradientEnabled ? 'component-page--gradient' : ''}}"><view id="component-navbar" class="component-page__navbar"><component-page-navbar title="{{pageTitle}}" bind:back="onBack" /></view><view class="component-page__scroll-row" style="height: {{scrollAreaHeight}};"><pui-scroll-area wx:if="{{layoutReady}}" class="component-page__scroll-area" height="{{scrollAreaHeight}}" gradient-overlay><view class="component-page__content"><component-page-section title="安装" subtitle="真实包入口" description="项目依赖 poemui-miniprogram，本地工程用 npm 安装后再执行微信 npm 构建。"><view class="component-page__stack"><pui-cell title="安装依赖" description="npm install poemui-miniprogram" left-icon="package" /><pui-cell title="构建 npm" description="在微信开发者工具中执行构建 npm。" left-icon="command" /></view></component-page-section><component-page-section title="按需引用" subtitle="页面组合" description="在页面 JSON 声明 usingComponents，再使用 PUI 组件与 ConfigProvider 组合。"><pui-cell title="外观 Provider" description="每个页面根挂载 pui-config-provider use-global-config。" left-icon="palette" /><pui-button theme="primary" block bind:click="onOpenQuickStyles">打开快速样式</pui-button><text class="component-page__status" aria-live="polite">{{guideStatus}}</text></component-page-section></view></pui-scroll-area></view></view></pui-config-provider>
