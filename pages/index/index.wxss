page {
  height: 100vh;
  overflow: hidden;
  background: var(--pui-bg-page);
}

.home-config-provider,
.home-page {
  display: block;
  width: 100%;
  height: 100%;
  min-height: 0;
}

.home-page {
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background: var(--pui-bg-page);
  color: var(--pui-text-primary);
  font-family: var(--pui-font-family-sans);
}

.home-page--gradient {
  background: linear-gradient(145deg, var(--pui-bg-page), var(--pui-bg-muted));
}

.home-navbar,
.home-tabbar {
  flex: 0 0 auto;
  width: 100%;
}

.home-tabbar {
  min-width: 0;
}

.home-scroll-row {
  box-sizing: border-box;
  flex: 0 0 auto;
  width: 100%;
  min-height: 0;
  overflow: hidden;
}

.home-scroll-area {
  width: 100%;
  height: 100%;
}

.home-scroll-content {
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  gap: var(--pui-section-gap);
  width: 100%;
  min-width: 0;
  min-height: 100%;
  padding: var(--pui-panel-padding) var(--pui-panel-padding) var(--pui-section-gap);
}

.home-brand {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--pui-content-gap);
  padding-top: var(--pui-content-gap);
}

.home-brand__logo {
  box-shadow: var(--pui-shadow-none);
}

.home-brand__tagline {
  max-width: 100%;
  color: var(--pui-text-secondary);
  font-size: var(--pui-font-size-body-medium);
  line-height: var(--pui-line-height-body-medium);
  text-align: center;
}

.home-components {
  width: 100%;
  min-width: 0;
}

.home-component-list {
  display: flex;
  flex-direction: column;
  gap: var(--pui-content-gap);
  padding-top: var(--pui-content-gap);
}

.home-search-overlay__content {
  box-sizing: border-box;
  position: absolute;
  top: 50%;
  right: var(--pui-panel-padding);
  left: var(--pui-panel-padding);
  transform: translateY(-50%);
}

.home-search-combobox {
  width: 100%;
}
