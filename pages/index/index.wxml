<pui-config-provider class="home-config-provider" use-global-config>
  <view class="home-page {{canvasGradientEnabled ? 'home-page--gradient' : ''}}">
    <view id="home-navbar" class="home-navbar">
      <pui-navbar
        title="Poem UI"
        left-arrow="{{false}}"
        left-btn="{{navbarLeftBtn}}"
        right-btn="{{navbarRightBtn}}"
        fixed="{{false}}"
        capsule="{{true}}"
        safe-area-inset-top="{{true}}"
        bind:leftBtn="onOpenSearch"
        bind:rightBtn="onOpenAppearance"
      />
    </view>

    <view class="home-scroll-row" style="height: {{scrollAreaHeight}};">
      <pui-scroll-area
        wx:if="{{layoutReady}}"
        class="home-scroll-area"
        height="{{scrollAreaHeight}}"
        gradient-overlay
        gradient-overlay-size="md"
        aria-label="首页内容"
      >
        <view class="home-scroll-content">
          <view class="home-brand">
            <pui-image
              class="home-brand__logo"
              src="{{brandLogo}}"
              mode="aspectFit"
              width="144rpx"
              height="144rpx"
              shape="round"
              aria-label="月下成行"
            />
            <text class="home-brand__tagline">为原生小程序而生，让界面拥有清晰的节奏与留白。</text>
          </view>

          <pui-collapsible
            class="home-components"
            label="基础组件"
            aria-label="基础组件列表"
            open="{{componentsOpen}}"
            custom-content="{{true}}"
            bind:change="onComponentsToggle"
          >
            <view class="home-component-list">
              <block wx:for="{{componentCatalog}}" wx:key="key">
                <pui-cell
                  title="{{item.name}}"
                  description="{{item.description}}"
                  left-icon="{{item.icon}}"
                  arrow
                  clickable
                  hover
                  url="{{item.url}}"
                  jump-type="navigateTo"
                  aria-label="{{'打开 ' + item.name + ' 组件页面'}}"
                />
              </block>
            </view>
          </pui-collapsible>
        </view>
      </pui-scroll-area>
    </view>

    <pui-overlay
      visible="{{searchOverlayVisible}}"
      duration="{{searchOverlayDuration}}"
      blur
      prevent-scroll-through
      z-index="11000"
      aria-label="关闭组件搜索"
      bind:click="onSearchOverlayClick"
    >
      <view class="home-search-overlay__content" catchtap="onSearchContentTap">
        <pui-combobox
          class="home-search-combobox"
          options="{{searchOptions}}"
          query="{{searchQuery}}"
          visible="{{searchComboboxVisible}}"
          filterable
          clearable="{{false}}"
          show-check="{{false}}"
          show-panel-close="{{false}}"
          shape="round"
          placeholder="选择组件"
          search-placeholder="搜索组件"
          aria-label="搜索组件"
          bind:query-input="onSearchQueryInput"
          bind:visible-input="onSearchVisibleInput"
          bind:select="onSearchSelect"
        />
      </view>
    </pui-overlay>

    <pui-popup
      visible="{{appearancePopupVisible}}"
      placement="bottom"
      card="{{true}}"
      show-header
      title="外观"
      blur-overlay
      prevent-scroll-through
      z-index="11010"
      aria-label="外观设置"
      bind:visible-change="onAppearancePopupVisibleChange"
    >
        <pui-button
          slot="header-left"
          theme="primary"
          variant="base"
          shape="circle"
          size="small"
          icon="refresh"
          icon-only
          aria-label="恢复默认外观"
          bind:click="onResetAppearance"
        />
        <pui-cell-group aria-label="全局外观设置">
          <pui-cell title="果味" description="一键应用视觉组合">
            <pui-switch
              slot="right"
              value="{{fruitFlavorEnabled}}"
              aria-label="一键果味"
              bind:change="onFruitFlavorChange"
            />
          </pui-cell>
          <pui-cell title="边框">
            <pui-switch
              slot="right"
              value="{{visualConfig.bordered}}"
              aria-label="组件边框"
              bind:change="onAppearanceSwitchChange"
              data-setting="bordered"
            />
          </pui-cell>
          <pui-cell title="阴影">
            <pui-switch
              slot="right"
              value="{{visualConfig.shadow}}"
              aria-label="组件阴影"
              bind:change="onAppearanceSwitchChange"
              data-setting="shadow"
            />
          </pui-cell>
          <pui-cell title="毛玻璃">
            <pui-switch
              slot="right"
              value="{{visualConfig.frostedGlass}}"
              aria-label="组件毛玻璃"
              bind:change="onAppearanceSwitchChange"
              data-setting="frostedGlass"
            />
          </pui-cell>
          <pui-cell title="大圆角">
            <pui-switch
              slot="right"
              value="{{visualConfig.largeRadius}}"
              aria-label="组件大圆角"
              bind:change="onAppearanceSwitchChange"
              data-setting="largeRadius"
            />
          </pui-cell>
          <pui-cell title="渐变">
            <pui-switch
              slot="right"
              value="{{canvasGradientEnabled}}"
              aria-label="页面渐变背景"
              bind:change="onCanvasGradientChange"
            />
          </pui-cell>
          <pui-cell title="深色">
            <pui-switch
              slot="right"
              value="{{visualConfig.theme === 'dark'}}"
              aria-label="深色模式"
              bind:change="onAppearanceSwitchChange"
              data-setting="theme"
            />
          </pui-cell>
        </pui-cell-group>
    </pui-popup>

    <view id="home-tabbar" class="home-tabbar">
      <pui-tabbar
        items="{{tabbarItems}}"
        value="{{activeTab}}"
        theme="normal"
        shape="normal"
        split="{{true}}"
        fixed="{{false}}"
        safe-area-inset-bottom="{{true}}"
        bind:change="onTabChange"
      />
    </view>
  </view>
</pui-config-provider>
