<pui-config-provider class="home-config-provider" use-global-config bind:themechange="onProviderThemeChange">
  <view class="home-page {{backgroundGradientEnabled ? 'home-page--gradient' : ''}}">
    <view id="home-navbar" class="home-navbar">
      <pui-navbar
        title="Poem UI"
        left-arrow="{{false}}"
        left-btn="{{navbarLeftBtn}}"
        right-btn="{{navbarRightBtn}}"
        fixed="{{false}}"
        capsule="{{true}}"
        safe-area-inset-top="{{true}}"
        bordered="{{false}}"
        bind:leftBtn="onOpenSearch"
        bind:rightBtn="onOpenAppearance"
      />
    </view>

    <view class="home-scroll-row" style="height: {{scrollAreaHeight}};">
      <pui-scroll-area
        wx:if="{{layoutReady}}"
        class="home-scroll-area"
        height="{{scrollAreaHeight}}"
        scroll-top="{{homeScrollTop}}"
        scroll-into-view="{{homeScrollIntoView}}"
        gradient-overlay
        gradient-overlay-size="md"
        aria-label="首页内容"
        bind:scroll="onHomeScroll"
      >
        <view class="home-scroll-content">
          <view class="home-brand">
            <view class="home-brand__headline">
              <view class="home-brand__identity">
                <view class="home-brand__name-row">
                  <text class="home-brand__name">Poem UI</text>
                  <pui-tag
                    content="{{currentVersion}}"
                    theme="default"
                    variant="light"
                    size="small"
                    shape="round"
                    aria-label="{{'当前版本 ' + currentVersion}}"
                  />
                </view>
                <text class="home-brand__stanza">月下成行</text>
              </view>
              <pui-image
                class="home-brand__mark"
                src="{{brandMark}}"
                mode="aspectFit"
                width="144rpx"
                height="144rpx"
                shape="rectangle"
                custom-style="background: transparent; border: 0;"
                aria-label="月下成行标记"
              />
            </view>
            <text class="home-brand__description">面向 AI 的原生小程序组件库。</text>
            <text class="home-brand__catalog">组件目录 / {{catalogSummary.componentCount}} 个组件 / {{catalogSummary.guideCount}} 份规范</text>
          </view>

          <block wx:for="{{catalogSections}}" wx:for-item="section" wx:key="key">
            <view id="home-section-{{section.key}}" class="home-components">
              <pui-collapsible
                class="home-components__collapsible"
                label="{{section.label}}"
                aria-label="{{section.ariaLabel}}"
                open="{{activeCatalogSection === section.key}}"
                duration="{{catalogSectionMotionDuration}}"
                shadow
                custom-trigger="{{section.hasPremiumIcon}}"
                data-section="{{section.key}}"
                custom-content="{{true}}"
                bind:change="onCatalogSectionChange"
              >
                <view wx:if="{{section.hasPremiumIcon}}" slot="trigger" class="home-components__advanced-trigger">
                  <text class="home-components__advanced-label">{{section.label}}</text>
                  <pui-icon name="premium" size="30" custom-class="home-components__advanced-icon" />
                </view>
                <view class="home-component-list">
                  <block wx:for="{{section.items}}" wx:for-item="component" wx:key="key">
                    <pui-cell
                      title="{{component.name}}"
                      description="{{component.description}}"
                      left-icon="{{component.icon}}"
                      arrow
                      clickable
                      hover
                      url="{{component.url}}"
                      jump-type="navigateTo"
                      aria-label="{{'打开 ' + component.name + (component.kind === 'guide' ? '规范页面' : '组件页面')}}"
                    />
                  </block>
                </view>
              </pui-collapsible>
            </view>
          </block>
        </view>
      </pui-scroll-area>
    </view>

    <pui-overlay
      visible="{{searchOverlayVisible}}"
      duration="{{searchOverlayDuration}}"
      blur
      prevent-scroll-through
      z-index="11000"
      aria-label="关闭组件搜索"
      bind:click="onSearchOverlayClick"
    >
      <view class="home-search-overlay__content" catchtap="onSearchContentTap">
        <pui-search
          class="home-search-input"
          value="{{searchQuery}}"
          focus="{{searchInputFocus}}"
          placeholder="搜索组件"
          shape="round"
          center
          aria-label="搜索组件"
          bind:change="onSearchChange"
        />
        <pui-combobox
          class="home-search-combobox"
          options="{{searchOptions}}"
          visible="{{searchComboboxVisible}}"
          list-height="360"
          clearable="{{false}}"
          show-check="{{false}}"
          shape="round"
          placeholder="选择组件"
          aria-label="搜索组件"
          bind:visible-input="onSearchVisibleInput"
          bind:select="onSearchSelect"
        />
      </view>
    </pui-overlay>

    <pui-popup
      visible="{{appearancePopupVisible}}"
      placement="bottom"
      card="{{true}}"
      show-header
      title="外观"
      blur-overlay
      prevent-scroll-through
      z-index="11010"
      aria-label="外观设置"
      bind:visible-change="onAppearancePopupVisibleChange"
    >
        <pui-button
          slot="header-left"
          theme="primary"
          variant="base"
          shape="circle"
          size="small"
          icon="refresh"
          icon-only
          aria-label="恢复默认外观"
          bind:click="onResetAppearance"
        />
        <appearance-settings />
    </pui-popup>

    <view id="home-tabbar" class="home-tabbar">
      <pui-tabbar
        items="{{tabbarItems}}"
        value="{{activeTab}}"
        theme="normal"
        shape="normal"
        split="{{true}}"
        fixed="{{true}}"
        placeholder="{{false}}"
        safe-area-inset-bottom="{{true}}"
        bind:change="onTabChange"
      />
    </view>
  </view>
</pui-config-provider>
