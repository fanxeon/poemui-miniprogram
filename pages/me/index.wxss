.me-config-provider,
.me-page {
  display: block;
  width: 100%;
  height: 100%;
  min-height: 0;
}

.me-page {
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  color: var(--pui-text-primary);
  font-family: var(--pui-font-family-sans);
  background: var(--pui-bg-page);
}

.me-page--gradient {
  background: linear-gradient(145deg, var(--pui-bg-page), var(--pui-bg-muted));
}

.me-page__navbar,
.me-page__tabbar {
  flex: 0 0 auto;
  width: 100%;
  min-width: 0;
}

.me-page__content-row {
  flex: 0 0 auto;
  width: 100%;
  min-height: 0;
  overflow: hidden;
}

.me-page__scroll-area,
.me-page__content {
  box-sizing: border-box;
  width: 100%;
  min-width: 0;

}

.me-page__content {
  display: flex;
  flex-direction: column;
  gap: var(--pui-section-gap);
  padding: var(--pui-panel-padding);
  padding-bottom: calc(var(--pui-panel-padding) + var(--pui-scroll-area-gradient-overlay-size-md));
}

.me-page__dashboard {
  box-sizing: border-box;
  width: 100%;
  min-width: 0;
}

.me-page__dashboard-content {
  display: flex;
  width: 100%;
  min-width: 0;
  flex-direction: column;
  gap: var(--pui-content-gap);
}

.me-page__dashboard-metrics {
  display: grid;
  box-sizing: border-box;
  width: 100%;
  min-width: 0;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: var(--pui-content-gap);
}

.me-page__dashboard-metric {
  display: flex;
  min-width: 0;
  align-items: center;
  flex-direction: column;
  gap: var(--pui-space-xs);
  text-align: center;
}

.me-page__dashboard-metric-label-row {
  display: inline-flex;
  min-width: 0;
  align-items: center;
  justify-content: center;
  gap: var(--pui-space-xxs);
}

.me-page__dashboard-metric-value {
  color: var(--pui-text-primary);
  font-size: var(--pui-font-size-title-medium);
  font-variant-numeric: tabular-nums;
  font-weight: var(--pui-font-weight-semibold);
  line-height: var(--pui-line-height-title-medium);
}

.me-page__dashboard-metric-label {
  color: var(--pui-text-secondary);
  font-size: var(--pui-font-size-body-small);
  line-height: var(--pui-line-height-body-small);
}

.me-page__dashboard-chart {
  display: flex;
  width: 100%;
  min-width: 0;
  flex-direction: column;
  gap: var(--pui-content-gap);
}

.me-page__dashboard-chart-viewport {
  box-sizing: border-box;
  width: 100%;
  min-width: 0;
  overflow: hidden;
  transition-property: height;
  transition-duration: var(--pui-duration-normal);
  transition-timing-function: var(--pui-ease-standard);
}

.me-page__dashboard-version-tags {
  display: flex;
  width: 100%;
  min-width: 0;
  align-items: center;
  flex-wrap: wrap;
  gap: var(--pui-space-xs);
}

@media (prefers-reduced-motion: reduce) {
  .me-page__dashboard-chart-viewport {
    transition-duration: 1ms;
  }
}

.me-page__services {
  display: flex;
  box-sizing: border-box;
  width: 100%;
  min-width: 0;
  flex-direction: column;
  gap: var(--pui-content-gap);
}

.me-announcement-popup__content {
  box-sizing: border-box;
  width: 100%;
  min-width: 0;
  min-height: 0;
}

.me-announcements,
.me-announcement,
.me-announcement__title-group {
  display: flex;
  box-sizing: border-box;
  width: 100%;
  min-width: 0;
  flex-direction: column;
}

.me-announcements {
  gap: var(--pui-surface-section-gap);
}

.me-announcement {
  gap: var(--pui-surface-stack-gap);
}

.me-announcement__heading {
  display: flex;
  min-width: 0;
  align-items: flex-start;
  justify-content: space-between;
  gap: var(--pui-content-gap);
}

.me-announcement__title-group {
  flex: 1 1 0;
  gap: var(--pui-space-xs);
}

.me-announcement__title {
  color: var(--pui-text-primary);
  font-size: var(--pui-font-size-title-small);
  font-weight: var(--pui-font-weight-semibold);
  line-height: var(--pui-line-height-title-small);
}

.me-announcement__summary,
.me-announcement__date {
  color: var(--pui-text-secondary);
  font-size: var(--pui-font-size-body-small);
  line-height: var(--pui-line-height-body-small);
}

.me-announcement__meta {
  display: flex;
  flex: 0 0 auto;
  align-items: flex-end;
  flex-direction: column;
  gap: var(--pui-space-xs);
}

.me-announcement__highlights {
  display: flex;
  box-sizing: border-box;
  width: 100%;
  min-width: 0;
  flex-direction: column;
}

.me-announcement__highlight {
  display: flex;
  box-sizing: border-box;
  width: 100%;
  min-width: 0;
  align-items: flex-start;
  gap: var(--pui-content-gap);
  padding: var(--pui-space-lg) 0;
  border-bottom: 1rpx solid var(--pui-border-color);
}

.me-announcement__highlight-icon {
  display: flex;
  flex: 0 0 auto;
  width: var(--pui-space-xxl);
  height: var(--pui-space-xxl);
  align-items: center;
  justify-content: center;
  color: var(--pui-color-brand);
}

.me-announcement__highlight-main {
  display: flex;
  flex: 1 1 0;
  min-width: 0;
  flex-direction: column;
  gap: var(--pui-space-sm);
}

.me-announcement__highlight-heading {
  display: flex;
  min-width: 0;
  align-items: center;
  flex-wrap: wrap;
  gap: var(--pui-space-sm);
}

.me-announcement__highlight-title {
  color: var(--pui-text-primary);
  font-size: var(--pui-font-size-body-medium);
  font-weight: var(--pui-font-weight-semibold);
  line-height: var(--pui-line-height-body-medium);
}

.me-announcement__highlight-description {
  color: var(--pui-text-secondary);
  font-size: var(--pui-font-size-body-small);
  line-height: var(--pui-line-height-body-small);
}
