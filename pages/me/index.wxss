.me-config-provider,
.me-page {
  display: block;
  width: 100%;
  height: 100%;
  min-height: 0;
}

.me-page {
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  color: var(--pui-text-primary);
  font-family: var(--pui-font-family-sans);
  background: var(--pui-bg-page);
}

.me-page--gradient {
  background: linear-gradient(145deg, var(--pui-bg-page), var(--pui-bg-muted));
}

.me-page__navbar,
.me-page__tabbar {
  flex: 0 0 auto;
  width: 100%;
  min-width: 0;
}

.me-page__content-row {
  flex: 0 0 auto;
  width: 100%;
  min-height: 0;
  overflow: hidden;
}

.me-page__scroll-area,
.me-page__content {
  box-sizing: border-box;
  width: 100%;
  min-width: 0;
}

.me-page__content {
  display: flex;
  flex-direction: column;
  gap: var(--pui-section-gap);
  padding: var(--pui-panel-padding);
  padding-bottom: calc(var(--pui-panel-padding) + var(--pui-scroll-area-gradient-overlay-size-md));
}

.me-profile {
  display: flex;
  flex-direction: column;
  gap: var(--pui-surface-content-gap, var(--pui-content-gap));
  width: 100%;
  min-width: 0;
}

.me-profile__summary {
  display: flex;
  align-items: center;
  gap: var(--pui-content-gap);
  min-width: 0;
}

.me-profile__identity {
  display: flex;
  flex: 1 1 0;
  min-width: 0;
  flex-direction: column;
  gap: var(--pui-space-xs);
}

.me-profile__nickname {
  color: var(--pui-text-primary);
  font-size: var(--pui-font-size-title-medium);
  font-weight: var(--pui-font-weight-semibold);
  line-height: var(--pui-line-height-title-medium);
  overflow-wrap: anywhere;
}

.me-profile__caption {
  color: var(--pui-text-secondary);
  font-size: var(--pui-font-size-body-small);
  line-height: var(--pui-line-height-body-small);
}

.me-profile__editor {
  display: flex;
  flex-direction: column;
  gap: var(--pui-content-gap);
  width: 100%;
  min-width: 0;
}
