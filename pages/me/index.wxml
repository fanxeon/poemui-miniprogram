<pui-config-provider class="me-config-provider" use-global-config>
  <view class="me-page {{backgroundGradientEnabled ? 'me-page--gradient' : ''}}">
    <view id="me-navbar" class="me-page__navbar">
      <pui-navbar
        title="我的"
        left-arrow="{{false}}"
        fixed="{{false}}"
        capsule="{{true}}"
        safe-area-inset-top="{{true}}"
        bordered="{{false}}"
      >
        <view slot="left" class="pui-flex pui-items-center pui-gap-xxs pui-min-w-0">
          <pui-button
            id="me-contact-service"
            theme="default"
            variant="text"
            surface="transparent"
            size="extra-small"
            shape="circle"
            icon="comment"
            icon-only
            open-type="contact"
            aria-label="联系 PoemUI 客服"
            bind:error="onContactError"
          />
          <pui-button
            id="me-appearance-menu"
            theme="default"
            variant="text"
            surface="transparent"
            size="extra-small"
            shape="circle"
            icon="menu"
            icon-only
            aria-label="打开外观设置"
            bind:click="onOpenAppearance"
          />
        </view>
      </pui-navbar>
    </view>

    <view class="me-page__content-row" style="height: {{contentHeight}};">
      <pui-scroll-area
        wx:if="{{layoutReady}}"
        class="me-page__scroll-area"
        height="{{contentHeight}}"
        gradient-overlay
        gradient-overlay-size="md"
        aria-label="PoemUI 组件状态、服务与信息"
      >
        <view class="me-page__content" style="min-height: {{contentHeight}};">
          <view id="me-component-status" class="me-page__dashboard">
            <pui-card
              padding="compact"
              shadow
              aria-label="PoemUI 组件状态仪表盘"
            >
              <view class="me-page__dashboard-content">
                <view
                  id="me-component-status-metrics"
                  class="me-page__dashboard-metrics"
                  role="group"
                  aria-label="{{componentStatusMetricsAriaLabel}}"
                >
                  <view
                    wx:for="{{componentStatusMetrics}}"
                    wx:key="key"
                    class="me-page__dashboard-metric"
                    aria-label="{{item.value}} 个{{item.label}}"
                  >
                    <text class="me-page__dashboard-metric-value">{{item.value}}</text>
                    <view class="me-page__dashboard-metric-label-row">
                      <text class="me-page__dashboard-metric-label">{{item.label}}</text>
                      <pui-icon
                        wx:if="{{item.icon}}"
                        name="{{item.icon}}"
                        size="{{20}}"
                        color="{{item.iconColor}}"
                      />
                    </view>
                  </view>
                </view>
                <view
                  class="me-page__dashboard-chart"
                  role="group"
                  aria-label="PoemUI 组件分类版本增量"
                  aria-expanded="{{componentStatusChartExpanded}}"
                >
                  <view
                    id="me-component-status-chart-viewport"
                    class="me-page__dashboard-chart-viewport"
                    style="{{componentStatusChartViewportStyle}}"
                    bindtransitionend="onComponentStatusChartTransitionEnd"
                  >
                    <pui-bar-chart
                      id="me-component-status-chart"
                      items="{{componentStatusVisibleCategoryItems}}"
                      max="{{componentStatusMaximum}}"
                      orientation="horizontal"
                      mode="stacked"
                      size="small"
                      duration="{{componentStatusAnimationDuration}}"
                      show-value
                      show-legend="{{false}}"
                      aria-label="{{componentStatusAriaLabel}}"
                    />
                  </view>
                  <view
                    class="me-page__dashboard-version-tags"
                    role="group"
                    aria-label="{{componentStatusVersionLegendAriaLabel}}"
                  >
                    <pui-tag
                      wx:for="{{componentStatusVersionLegendItems}}"
                      wx:key="key"
                      content="{{item.label}}"
                      theme="default"
                      variant="light"
                      size="small"
                      shape="round"
                      custom-style="{{item.customStyle}}"
                    />
                  </view>
                  <pui-button
                    wx:if="{{componentStatusChartToggleVisible}}"
                    id="me-component-status-chart-toggle"
                    block
                    theme="default"
                    variant="transparent"
                    size="small"
                    icon="{{componentStatusChartToggleIcon}}"
                    content="{{componentStatusChartToggleLabel}}"
                    disabled="{{componentStatusChartTransitioning}}"
                    aria-label="{{componentStatusChartExpanded ? '收起组件分类图表' : '查看更多组件分类图表'}}"
                    bind:click="onToggleComponentStatusChart"
                  />
                </view>
              </view>
            </pui-card>
          </view>
          <view id="me-services" class="me-page__services">
            <pui-cell-group card="{{true}}" bordered="{{true}}" aria-label="PoemUI 服务与信息">
              <pui-cell
                title="高级版商业授权"
                description="授权范围与版本权益"
                value="查阅详情"
                left-icon="crown"
                clickable
                arrow
                aria-label="查阅高级版商业授权详情"
                bind:click="onOpenLicense"
              />
              <pui-cell
                title="我的订单"
                description="授权与订单记录"
                value="暂无订单"
                left-icon="receipt"
                clickable
                arrow
                aria-label="我的订单"
                bind:click="onOpenOrders"
              />
              <pui-cell
                id="me-update-announcement-cell"
                title="更新公告"
                description="版本与组件改动"
                value="{{latestAnnouncementVersion}}"
                left-icon="bell"
                clickable
                arrow
                aria-label="查看更新公告"
                bind:click="onOpenAnnouncements"
              />
              <pui-cell
                title="用户私隐协议"
                description="微信隐私保护指引"
                left-icon="shield-check"
                clickable
                arrow
                aria-label="查看用户私隐协议"
                bind:click="onOpenPrivacy"
              />
              <pui-cell
                title="关于诗上"
                description="诗上科技小程序"
                left-icon="poemcoder-mark"
                right-icon="external-link"
                clickable
                aria-label="打开诗上科技小程序"
                bind:click="onOpenShishang"
              />
            </pui-cell-group>
          </view>
        </view>
      </pui-scroll-area>
    </view>

    <pui-dialog
      id="me-license-dialog"
      visible="{{licenseDialogVisible}}"
      title="查看商业授权详情"
      content="桌面端浏览体验更佳。你可以复制链接在电脑浏览器打开，或直接进入小程序 WebView 查看。"
      close-btn="{{true}}"
      close-on-overlay-click="{{!licenseNavigating}}"
      actions="{{licenseDialogActions}}"
      using-custom-navbar
      aria-label="选择商业授权详情的访问方式"
      bind:action="onLicenseDialogAction"
      bind:close="onLicenseDialogClose"
    />

    <pui-popup
      id="me-update-announcement-popup"
      visible="{{announcementPopupVisible}}"
      placement="bottom"
      card="{{true}}"
      show-header
      title="更新公告"
      subtitle="{{latestAnnouncementVersion}}"
      show-footer
      content-scrollable="{{false}}"
      custom-style="{{announcementPopupStyle}}"
      close-on-overlay-click
      prevent-scroll-through
      show-overlay
      aria-label="PoemUI 更新公告"
      bind:visible-change="onAnnouncementPopupVisibleChange"
    >
      <pui-top-loading
        id="me-announcement-top-loading"
        slot="surface-top"
        state="{{announcementLoadingState}}"
        aria-label="{{announcementLoadingState === 'success' ? '更新公告已同步' : '正在读取更新公告'}}"
      />
      <view id="me-announcement-content" slot="content" class="me-announcement-popup__content">
        <pui-scroll-area
          id="me-announcement-scroll-area"
          height="auto"
          max-height="60vh"
          scroll-top="{{announcementScrollTop}}"
          scroll-into-view="{{announcementScrollTarget}}"
          content-padding-bottom="0"
          gradient-overlay-size="sm"
          aria-label="PoemUI 更新公告内容"
          bind:scroll="onAnnouncementScroll"
        >
          <view id="me-announcement-top-a" aria-hidden="true"></view>
          <view id="me-announcement-top-b" aria-hidden="true"></view>
          <view class="me-announcements">
            <view
              wx:for="{{announcements}}"
              wx:key="id"
              wx:for-item="announcement"
              class="me-announcement"
            >
              <view class="me-announcement__heading">
                <view class="me-announcement__title-group">
                  <text class="me-announcement__title">{{announcement.title}}</text>
                  <text class="me-announcement__summary">{{announcement.summary}}</text>
                </view>
                <view class="me-announcement__meta">
                  <pui-tag
                    content="{{announcement.version}}"
                    theme="primary"
                    variant="light"
                    size="small"
                    shape="round"
                  />
                  <text class="me-announcement__date">{{announcement.date}}</text>
                </view>
              </view>
              <view class="me-announcement__highlights" aria-label="{{announcement.title + '组件改动'}}">
                <view
                  wx:for="{{announcement.highlights}}"
                  wx:key="component"
                  wx:for-item="highlight"
                  class="me-announcement__highlight"
                >
                  <view class="me-announcement__highlight-icon" aria-hidden="true">
                    <pui-icon name="{{highlight.icon}}" size="36" />
                  </view>
                  <view class="me-announcement__highlight-main">
                    <view class="me-announcement__highlight-heading">
                      <pui-tag
                        content="{{highlight.component}}"
                        theme="primary"
                        variant="light"
                        size="small"
                        shape="round"
                      />
                      <text class="me-announcement__highlight-title">{{highlight.title}}</text>
                    </view>
                    <text class="me-announcement__highlight-description">{{highlight.description}}</text>
                  </view>
                </view>
              </view>
            </view>
          </view>
        </pui-scroll-area>
      </view>
      <pui-button
        id="me-announcement-close"
        slot="footer"
        block
        theme="primary"
        content="知道了"
        aria-label="关闭更新公告"
        bind:click="onCloseAnnouncements"
      />
    </pui-popup>

    <pui-popup
      id="me-appearance-popup"
      visible="{{appearancePopupVisible}}"
      placement="bottom"
      card="{{true}}"
      show-header
      title="外观"
      blur-overlay
      prevent-scroll-through
      z-index="11010"
      aria-label="外观设置"
      bind:visible-change="onAppearancePopupVisibleChange"
    >
      <pui-button
        slot="header-left"
        theme="primary"
        variant="base"
        shape="circle"
        size="small"
        icon="refresh"
        icon-only
        aria-label="恢复默认外观"
        bind:click="onResetAppearance"
      />
      <appearance-settings />
    </pui-popup>

    <view id="me-tabbar" class="me-page__tabbar">
      <pui-tabbar
        items="{{tabbarItems}}"
        value="{{activeTab}}"
        theme="normal"
        shape="normal"
        split="{{true}}"
        fixed="{{false}}"
        safe-area-inset-bottom="{{true}}"
        bind:change="onTabChange"
      />
    </view>

    <pui-toast id="me-toast" />
  </view>
</pui-config-provider>
