<pui-config-provider class="component-config-provider" use-global-config><view class="component-page {{backgroundGradientEnabled ? 'component-page--gradient' : ''}}"><view id="component-navbar" class="component-page__navbar"><component-page-navbar title="{{pageTitle}}" bind:back="onBack" /></view><view class="component-page__scroll-row" style="height: {{scrollAreaHeight}};"><pui-scroll-area wx:if="{{layoutReady}}" class="component-page__scroll-area" height="{{scrollAreaHeight}}" gradient-overlay aria-label="AspectRatio 组件用法"><view class="component-page__content"><component-page-section title="保持封面比例" subtitle="核心示例" description="无论屏幕宽度如何变化，封面都保持稳定比例，不会在加载前后跳动。"><pui-aspect-ratio ratio="{{ratio}}" bordered overflow="{{overflow}}"><view class="layout-page__ratio-content"><pui-icon name="image" size="48" /><text>{{ratio}}</text></view></pui-aspect-ratio><text class="component-page__status">{{ratioStatus}}</text></component-page-section><component-page-section title="比较方形与宽屏封面" subtitle="重要变化" description="切换为 1:1 或 16:9，观察容器高度和边缘裁切如何变化。"><view class="component-page__row component-page__row--actions"><pui-button block content="切换比例" theme="primary" bind:click="onChangeRatio" /><pui-button block content="{{overflow ? '允许内容溢出' : '裁切超出内容'}}" variant="outline" bind:click="onToggleOverflow" /></view></component-page-section></view></pui-scroll-area></view></view></pui-config-provider>
