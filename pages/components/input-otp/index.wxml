<pui-config-provider class="component-config-provider" use-global-config><view class="component-page {{backgroundGradientEnabled ? 'component-page--gradient' : ''}}"><view id="component-navbar" class="component-page__navbar"><component-page-navbar title="{{pageTitle}}" bind:back="onBack" /></view><view class="component-page__scroll-row" style="height: {{scrollAreaHeight}};"><pui-scroll-area wx:if="{{layoutReady}}" class="component-page__scroll-area" height="{{scrollAreaHeight}}" gradient-overlay><view class="component-page__content"><component-page-section title="输入六位验证码" subtitle="核心示例" description="每输入一位都会更新进度；填满六位只表示输入完成，并不代表验证成功。"><pui-input-otp value="{{otpValue}}" length="6" type="number" aria-label="六位验证码" bind:change="onOtpChange" bind:complete="onOtpComplete" /><text class="component-page__status" aria-live="polite">{{otpStatus}}</text></component-page-section><component-page-section title="保护敏感验证码" subtitle="重要状态" description="需要遮挡内容时可使用掩码；错误信息应直接说明下一步。"><view class="component-page__stack"><pui-input-otp value="4821" length="4" mask readonly aria-label="已遮挡的四位验证码" /><pui-input-otp value="1357" length="4" error error-message="验证码已过期，请重新获取" readonly aria-label="已过期的四位验证码" /></view></component-page-section></view></pui-scroll-area></view></view></pui-config-provider>
