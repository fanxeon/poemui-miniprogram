<pui-config-provider class="component-config-provider" use-global-config><view class="component-page {{backgroundGradientEnabled ? 'component-page--gradient' : ''}}"><view id="component-navbar" class="component-page__navbar"><component-page-navbar title="{{pageTitle}}" bind:back="onBack" /></view><view class="component-page__scroll-row" style="height: {{scrollAreaHeight}};"><pui-scroll-area wx:if="{{layoutReady}}" class="component-page__scroll-area" height="{{scrollAreaHeight}}" gradient-overlay><view class="component-page__content"><component-page-section title="滑动查看快捷操作" subtitle="核心示例" description="向右滑显示置顶，向左滑显示删除；点击动作后条目不会假装业务已经完成。"><pui-swipe-cell left="{{swipeLeft}}" right="{{swipeRight}}" bind:click="onSwipeAction"><pui-cell title="Tabs 验收记录" description="向两侧滑动查看可用操作。" left-icon="component" /></pui-swipe-cell><text class="component-page__status">{{swipeStatus}}</text></component-page-section><component-page-section title="保留不可滑动的条目" subtitle="禁用状态" description="内容仍可阅读，但所有滑动和快捷操作都会被阻止。"><pui-swipe-cell disabled right="{{swipeRight}}"><pui-cell title="已归档记录" description="当前没有快捷操作。" left-icon="lock" /></pui-swipe-cell></component-page-section></view></pui-scroll-area></view></view></pui-config-provider>
