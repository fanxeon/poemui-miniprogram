<pui-config-provider class="component-config-provider" use-global-config><view class="component-page {{backgroundGradientEnabled ? 'component-page--gradient' : ''}}"><view id="component-navbar" class="component-page__navbar"><component-page-navbar title="{{pageTitle}}" bind:back="onBack" /></view><view class="component-page__scroll-row" style="height: {{scrollAreaHeight}};"><pui-scroll-area wx:if="{{layoutReady}}" class="component-page__scroll-area" height="{{scrollAreaHeight}}" gradient-overlay><view class="component-page__content"><component-page-section title="比较组件验收结果" subtitle="核心示例" description="固定组件名称列，横向查看分区和验收状态；可选择多行并按状态排序。"><pui-table columns="{{tableColumns}}" data="{{tableRows}}" row-key="id" selectable multiple selected-row-keys="{{tableSelected}}" sortable height="520" stripe aria-label="组件验收表格" bind:change="onTableChange" bind:sort-change="onTableSort" /><text class="component-page__status">{{tableStatus}}</text></component-page-section></view></pui-scroll-area></view></view></pui-config-provider>
