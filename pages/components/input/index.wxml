<pui-config-provider class="component-config-provider" use-global-config><view class="component-page {{backgroundGradientEnabled ? 'component-page--gradient' : ''}}"><view id="component-navbar" class="component-page__navbar"><component-page-navbar title="{{pageTitle}}" bind:back="onBack" /></view><view class="component-page__scroll-row" style="height: {{scrollAreaHeight}};"><pui-scroll-area wx:if="{{layoutReady}}" class="component-page__scroll-area" height="{{scrollAreaHeight}}" gradient-overlay><view class="component-page__content"><component-page-section title="填写组件名称" subtitle="核心示例" description="前缀图标帮助识别内容，清除按钮和键盘确认都可直接操作。"><pui-input value="{{inputValue}}" label="组件名称" placeholder="例如 Calendar" prefix-icon="component" clearable required bind:change="onInputChange" bind:clear="onInputClear" bind:enter="onInputEnter" /><text class="component-page__status" aria-live="polite">{{inputStatus}}</text></component-page-section><component-page-section title="辨认不可编辑状态" subtitle="重要状态" description="只读内容仍可查看，禁用内容则明确表示当前不可操作。"><view class="component-page__stack"><pui-input value="Poem UI" label="只读名称" readonly /><pui-input value="等待管理员解锁" label="禁用内容" disabled /></view></component-page-section></view></pui-scroll-area></view></view></pui-config-provider>
