<pui-config-provider class="component-config-provider" use-global-config><view class="component-page {{backgroundGradientEnabled ? 'component-page--gradient' : ''}}"><view id="component-navbar" class="component-page__navbar"><component-page-navbar title="{{pageTitle}}" bind:back="onBack" /></view><view class="component-page__scroll-row" style="height: {{scrollAreaHeight}};"><pui-scroll-area wx:if="{{layoutReady}}" class="component-page__scroll-area" height="{{scrollAreaHeight}}" gradient-overlay><view class="component-page__content"><component-page-section title="按需查看补充说明" subtitle="核心示例" description="一个标题只控制一段内容，适合不必始终占用页面空间的辅助信息。"><pui-collapsible label="发布前需要检查什么？" open="{{collapsibleOpen}}" shadow custom-content bind:change="onCollapsibleChange"><pui-cell title="检查清单" description="确认 390px、深浅色、交互结果和取消路径。" left-icon="file-text" /></pui-collapsible><text class="component-page__status">{{collapsibleStatus}}</text></component-page-section><component-page-section title="保留可读但不可更改的说明" subtitle="只读状态" description="内容可以展开阅读，但不会响应开合请求。"><pui-collapsible label="组织发布规范" content="该说明由管理员维护，当前页面只能阅读。" default-open readonly /></component-page-section></view></pui-scroll-area></view></view></pui-config-provider>
