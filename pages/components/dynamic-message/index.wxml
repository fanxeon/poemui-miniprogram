<pui-config-provider class="component-config-provider" use-global-config>
  <view class="component-page {{backgroundGradientEnabled ? 'component-page--gradient' : ''}}">
    <view id="component-navbar" class="component-page__navbar">
      <component-page-navbar title="{{pageTitle}}" bind:back="onBack" />
    </view>
    <view class="component-page__scroll-row" style="height: {{scrollAreaHeight}};">
      <pui-scroll-area wx:if="{{layoutReady}}" class="component-page__scroll-area" height="{{scrollAreaHeight}}" gradient-overlay aria-label="DynamicMessage 组件用法">
        <view class="component-page__content dynamic-message-page__content">
          <component-page-section title="通知外观" subtitle="组件私有开关" description="这里的设置只影响 DynamicMessage；关闭后不改写页面的全局外观。">
            <pui-cell-group aria-label="DynamicMessage 外观设置">
              <pui-cell title="通知阴影" description="让通知与下方页面形成清晰层级">
                <pui-switch slot="right" value="{{messageShadow}}" aria-label="通知阴影" bind:change="onMessageShadowChange" />
              </pui-cell>
              <pui-cell title="通知毛玻璃" description="保留黑色身份面并模糊背后内容">
                <pui-switch slot="right" value="{{messageFrostedGlass}}" aria-label="通知毛玻璃" bind:change="onMessageFrostedGlassChange" />
              </pui-cell>
            </pui-cell-group>
          </component-page-section>
          <component-page-section title="生成任务通知" subtitle="同 key 原位更新" description="通知不使用遮罩，页面内容和滚动始终可用。">
            <view class="dynamic-message-page__actions">
              <pui-button id="dynamic-message-start" content="开始生成" theme="primary" block bind:click="onStartTask" />
              <pui-button id="dynamic-message-update" content="更新进度" variant="outline" block bind:click="onUpdateTask" />
              <pui-button id="dynamic-message-success" content="真实成功" variant="outline" block bind:click="onCompleteTask" />
              <pui-button id="dynamic-message-error" content="真实失败" theme="danger" variant="outline" block bind:click="onFailTask" />
              <pui-button id="dynamic-message-queue" content="加入队列" variant="outline" block bind:click="onQueueMessage" />
              <pui-button id="dynamic-message-close" content="关闭当前" variant="outline" block bind:click="onCloseCurrent" />
            </view>
            <text class="component-page__status" aria-live="polite">{{notificationStatus}}</text>
          </component-page-section>
          <component-page-section title="页面仍可操作" subtitle="非模态、不锁滚动" description="下面的 Cell 保持正常阅读，通知显示时仍可继续滚动。">
            <block wx:for="{{feedRows}}" wx:key="*this">
              <pui-cell title="发布检查 {{item}}" description="源码、合同、H5、小程序与安装产物" left-icon="component" />
            </block>
          </component-page-section>
          <pui-button content="{{reduceMotion ? '恢复标准动效' : '开启低动效'}}" variant="outline" block bind:click="onToggleMotion" />
        </view>
      </pui-scroll-area>
    </view>
    <pui-dynamic-message id="dynamic-message" duration="3000" safe-area shadow="{{messageShadow}}" frosted-glass="{{messageFrostedGlass}}" reduce-motion="{{reduceMotion}}" bind:click="onNotificationClick" bind:action="onNotificationAction" bind:close="onNotificationClose" />
  </view>
</pui-config-provider>
