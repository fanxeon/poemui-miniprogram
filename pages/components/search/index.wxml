<pui-config-provider class="component-config-provider" use-global-config><view class="component-page {{backgroundGradientEnabled ? 'component-page--gradient' : ''}}"><view id="component-navbar" class="component-page__navbar"><component-page-navbar title="{{pageTitle}}" bind:back="onBack" /></view><view class="component-page__scroll-row" style="height: {{scrollAreaHeight}};"><pui-scroll-area wx:if="{{layoutReady}}" class="component-page__scroll-area" height="{{scrollAreaHeight}}" gradient-overlay><view class="component-page__content"><component-page-section title="查找组件" subtitle="核心示例" description="输入中文名或英文名，按搜索键确认；取消后回到完整目录。"><pui-search id="search-primary" value="{{searchValue}}" placeholder="例如 Tabs 或 标签页" show-cancel aria-label="组件搜索" bind:change="onSearchChange" bind:search="onSearchConfirm" bind:cancel="onSearchCancel" /><text class="component-page__status" aria-live="polite">{{searchStatus}}</text></component-page-section><component-page-section title="适应不同页面位置" subtitle="常见形态" description="圆角搜索适合独立入口；禁用状态明确表示当前无法检索。"><view class="component-page__stack"><pui-search shape="round" placeholder="搜索帮助内容" aria-label="圆角搜索框" /><pui-search value="目录更新中" disabled aria-label="暂不可用的搜索框" /></view></component-page-section></view></pui-scroll-area></view></view></pui-config-provider>
