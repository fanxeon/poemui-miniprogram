<pui-config-provider class="component-config-provider" use-global-config>
  <view class="component-page {{backgroundGradientEnabled ? 'component-page--gradient' : ''}}">
    <view id="component-navbar" class="component-page__navbar"><component-page-navbar title="{{pageTitle}}" bind:back="onBack" /></view>
    <view class="component-page__scroll-row" style="height: {{scrollAreaHeight}};">
      <pui-scroll-area wx:if="{{layoutReady}}" class="component-page__scroll-area" height="{{scrollAreaHeight}}" gradient-overlay gradient-overlay-size="md" aria-label="Skeleton 组件用法">
        <view class="component-page__content">
          <component-page-section title="内容加载前" subtitle="保持页面结构稳定" description="在资料尚未返回时先展示接近真实内容的轮廓，减少页面跳动。">
            <pui-skeleton loading="{{skeletonLoading}}" animation="gradient" row-col="{{skeletonRows}}">
              <pui-cell title="头像组件" description="用于展示用户、团队或内容作者。" />
            </pui-skeleton>
            <pui-button content="{{skeletonLoading ? '显示内容' : '重新显示占位'}}" theme="primary" block bind:click="onToggleSkeleton" />
          </component-page-section>
          <component-page-section title="头像与段落轮廓" subtitle="匹配即将出现的内容" description="根据实际版式选择占位结构，避免用同一种骨架替代所有页面。">
            <view class="component-page__stack">
              <pui-skeleton theme="avatar" animation="flashed" row-col="{{skeletonAvatarRows}}" />
              <pui-skeleton theme="paragraph" animation="gradient" row-col="{{skeletonParagraphRows}}" />
            </view>
          </component-page-section>
        </view>
      </pui-scroll-area>
    </view>
  </view>
</pui-config-provider>
