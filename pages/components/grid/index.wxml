<pui-config-provider class="component-config-provider" use-global-config><view class="component-page {{backgroundGradientEnabled ? 'component-page--gradient' : ''}}"><view id="component-navbar" class="component-page__navbar"><component-page-navbar title="{{pageTitle}}" bind:back="onBack" /></view><view class="component-page__scroll-row" style="height: {{scrollAreaHeight}};"><pui-scroll-area wx:if="{{layoutReady}}" class="component-page__scroll-area" height="{{scrollAreaHeight}}" gradient-overlay aria-label="Grid 组件用法"><view class="component-page__content"><component-page-section title="进入常用功能" subtitle="核心示例" description="图标、名称和简短说明组成清晰入口；不可用项目会直接标明。"><pui-grid items="{{gridItems}}" column="{{gridColumn}}" gutter="{{gridGutter}}" error="{{gridError}}" error-text="组件目录暂时无法读取" retry-text="重新加载" aria-label="组件目录入口" bind:click="onGridClick" bind:retry="onGridRetry" /><text class="component-page__status">{{gridStatus}}</text></component-page-section><component-page-section title="适应不同内容密度" subtitle="布局与恢复" description="两列适合带说明的入口，三列适合简短入口；恢复操作由页面重新提供目录。"><view class="component-page__row component-page__row--actions"><pui-button block content="切换列数" theme="primary" bind:click="onToggleGridLayout" /><pui-button wx:if="{{!gridError}}" block content="模拟加载失败" variant="outline" bind:click="onSetGridError" /><pui-button wx:else block content="恢复目录" variant="outline" bind:click="onRestoreGrid" /></view></component-page-section></view></pui-scroll-area></view></view></pui-config-provider>
