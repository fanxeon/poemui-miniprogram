@import "../../../styles/component-page.wxss";
@import "../../../styles/navigation-pages.wxss";

.navbar-page__visibility-control,
.navbar-page__visibility-copy {
  display: flex;
  min-width: 0;
}

.navbar-page__visibility-control {
  align-items: center;
  justify-content: space-between;
  gap: var(--pui-content-gap);
}

.navbar-page__visibility-copy {
  flex: 1 1 0;
  flex-direction: column;
  gap: var(--pui-space-xxs);
}

.navbar-page__visibility-title {
  color: var(--pui-text-primary);
  font-size: var(--pui-font-size-body-medium);
  font-weight: var(--pui-font-weight-semibold);
  line-height: var(--pui-line-height-body-medium);
}

.navbar-page__visibility-description {
  color: var(--pui-text-secondary);
  font-size: var(--pui-font-size-body-small);
  line-height: var(--pui-line-height-body-small);
}

.navbar-page__stage {
  display: block;
  min-height: var(--pui-navbar-content-height-fallback);
  margin-right: calc(0rpx - var(--pui-panel-padding));
  margin-left: calc(0rpx - var(--pui-panel-padding));
}

.navbar-page__slot-actions {
  display: flex;
  min-width: 0;
  align-items: center;
  gap: var(--pui-space-xxs);
}
