<pui-config-provider class="component-config-provider" use-global-config><view class="component-page {{backgroundGradientEnabled ? 'component-page--gradient' : ''}}"><view id="component-navbar" class="component-page__navbar"><component-page-navbar title="{{pageTitle}}" bind:back="onBack" /></view><view class="component-page__scroll-row" style="height: {{scrollAreaHeight}};"><pui-scroll-area wx:if="{{layoutReady}}" class="component-page__scroll-area" height="{{scrollAreaHeight}}" gradient-overlay aria-label="Sticky 滚动宿主" bind:scroll="onStickyHostScroll"><view class="component-page__content"><component-page-section title="让分组标题留在顶部" subtitle="核心示例" description="向上滑动时，“本月更新”会暂时停在顶部，内容仍从它下方经过。"><pui-sticky id="sticky-demo" offset-top="{{stickyOffset}}" disabled="{{stickyDisabled}}"><pui-cell title="本月更新" description="{{stickyDisabled ? '吸顶已暂停' : '向上滑动观察吸顶'}}" left-icon="pin" /></pui-sticky><text class="component-page__status">{{stickyStatus}}</text></component-page-section><component-page-section title="比较偏移和普通文档流" subtitle="关键边界" description="顶部偏移适合避开常驻栏；暂停吸顶后，标题会随正文正常滚动。"><view class="component-page__row component-page__row--actions"><pui-button block content="切换顶部偏移" variant="outline" bind:click="onToggleStickyOffset" /><pui-button block content="{{stickyDisabled ? '恢复吸顶' : '暂停吸顶'}}" variant="outline" bind:click="onToggleStickyDisabled" /></view></component-page-section><block wx:for="{{stickyRows}}" wx:key="*this"><pui-cell title="{{item}}" description="继续滚动查看标题和正文的相对位置。" left-icon="file-text" /></block></view></pui-scroll-area></view></view></pui-config-provider>
