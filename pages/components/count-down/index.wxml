<pui-config-provider class="component-config-provider" use-global-config><view class="component-page {{backgroundGradientEnabled ? 'component-page--gradient' : ''}}"><view id="component-navbar" class="component-page__navbar"><component-page-navbar title="{{pageTitle}}" bind:back="onBack" /></view><view class="component-page__scroll-row" style="height: {{scrollAreaHeight}};"><pui-scroll-area wx:if="{{layoutReady}}" class="component-page__scroll-area" height="{{scrollAreaHeight}}" gradient-overlay><view class="component-page__content"><component-page-section title="显示验证码剩余时间" subtitle="核心示例" description="倒计时可以暂停和继续；归零只说明等待结束，不代表验证码发送成功。"><pui-count-down time="60000" paused="{{countPaused}}" format="mm:ss" bind:finish="onCountFinish" /><text class="component-page__status">{{countStatus}}</text></component-page-section><component-page-section title="控制计时进度" subtitle="开始与暂停" description="页面可以明确暂停或继续同一个计时器，不重新创建一份时间。"><pui-button content="{{countPaused ? '继续倒计时' : '暂停倒计时'}}" theme="primary" block bind:click="onToggleCountDown" /><pui-count-down time="3661000" paused format="HH:mm:ss" split-with-unit theme="round" aria-label="只读长时倒计时" /></component-page-section></view></pui-scroll-area></view></view></pui-config-provider>
