<pui-config-provider class="component-config-provider" use-global-config><view class="component-page {{backgroundGradientEnabled ? 'component-page--gradient' : ''}}"><view id="component-navbar" class="component-page__navbar"><component-page-navbar title="{{pageTitle}}" bind:back="onBack" /></view><view class="component-page__scroll-row" style="height: {{scrollAreaHeight}};"><pui-scroll-area wx:if="{{layoutReady}}" class="component-page__scroll-area" height="{{scrollAreaHeight}}" gradient-overlay><view class="component-page__content"><component-page-section title="数字滚动倒计时" subtitle="核心示例" description="变化的数字位沿垂直方向滚动；归零只说明等待结束，不代表验证码发送成功。"><pui-count-down time="60000" paused="{{countPaused}}" animation="{{countAnimation}}" format="mm:ss" bind:finish="onCountFinish" /><text class="component-page__status">{{countStatus}}</text></component-page-section><component-page-section title="控制计时与风格" subtitle="开始、暂停与切换" description="切换动效不重置剩余时间，页面继续控制同一个计时器。"><view class="component-page__row component-page__row--actions"><pui-button content="{{countPaused ? '继续倒计时' : '暂停倒计时'}}" theme="primary" block bind:click="onToggleCountDown" /><pui-button content="{{countAnimation === 'roll' ? '切换渐隐' : '切换滚动'}}" variant="outline" block bind:click="onToggleCountAnimation" /></view><pui-count-down time="3661000" format="HH:mm:ss" split-with-unit theme="round" animation="roll" aria-label="数字滚动长时倒计时" /></component-page-section></view></pui-scroll-area></view></view></pui-config-provider>
