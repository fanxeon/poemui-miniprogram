<pui-config-provider class="component-config-provider" use-global-config><view class="component-page {{backgroundGradientEnabled ? 'component-page--gradient' : ''}}"><view id="component-navbar" class="component-page__navbar"><component-page-navbar title="{{pageTitle}}" bind:back="onBack" /></view><view class="component-page__scroll-row" style="height: {{scrollAreaHeight}};"><pui-scroll-area wx:if="{{layoutReady}}" class="component-page__scroll-area" height="{{scrollAreaHeight}}" gradient-overlay><view class="component-page__content"><component-page-section title="从较多选项中挑选" subtitle="核心示例" description="候选项同时显示名称、图标和用途，适合需要辨认差异的选择。"><pui-combobox options="{{comboboxOptions}}" value="{{comboboxValue}}" visible="{{comboboxVisible}}" placeholder="选择输入组件" aria-label="输入组件组合框" bind:visible-change="onComboboxVisibleChange" bind:change="onComboboxChange" /><text class="component-page__status" aria-live="polite">{{comboboxStatus}}</text></component-page-section><component-page-section title="辨认等待与不可用" subtitle="重要状态" description="加载中会说明正在准备选项；禁用状态明确表示当前不能选择。"><view class="component-page__stack"><pui-combobox options="{{comboboxOptions}}" loading loading-text="正在加载组件目录…" aria-label="加载中的组合框" /><pui-combobox options="{{comboboxOptions}}" value="search" disabled aria-label="禁用的组合框" /></view></component-page-section></view></pui-scroll-area></view></view></pui-config-provider>
