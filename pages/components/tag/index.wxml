<pui-config-provider class="component-config-provider" use-global-config><view class="component-page {{backgroundGradientEnabled ? 'component-page--gradient' : ''}}"><view id="component-navbar" class="component-page__navbar"><component-page-navbar title="{{pageTitle}}" bind:back="onBack" /></view><view class="component-page__scroll-row" style="height: {{scrollAreaHeight}};"><pui-scroll-area wx:if="{{layoutReady}}" class="component-page__scroll-area" height="{{scrollAreaHeight}}" gradient-overlay><view class="component-page__content"><component-page-section title="标记分类与状态" subtitle="核心示例" description="短标签帮助快速辨认类型、结果和需要注意的内容。"><view class="data-page__row"><pui-tag theme="primary">导航</pui-tag><pui-tag theme="success" variant="outline">已通过</pui-tag><pui-tag theme="warning" size="small">待复核</pui-tag></view></component-page-section><component-page-section title="移除可关闭的筛选条件" subtitle="关闭操作" description="关闭只提出移除请求，页面决定标签何时消失并提供恢复入口。"><pui-tag wx:if="{{tagVisible}}" closable theme="primary" bind:close="onTagClose">仅看导航组件</pui-tag><pui-button wx:else content="恢复筛选条件" theme="primary" bind:click="onRestoreTag" /><text class="component-page__status">{{tagStatus}}</text></component-page-section></view></pui-scroll-area></view></view></pui-config-provider>
