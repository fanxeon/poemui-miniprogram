<pui-config-provider class="component-config-provider" use-global-config><view class="component-page {{backgroundGradientEnabled ? 'component-page--gradient' : ''}}"><view id="component-navbar" class="component-page__navbar"><component-page-navbar title="{{pageTitle}}" bind:back="onBack" /></view><view class="component-page__scroll-row" style="height: {{scrollAreaHeight}};"><pui-scroll-area wx:if="{{layoutReady}}" class="component-page__scroll-area" height="{{scrollAreaHeight}}" gradient-overlay><view class="component-page__content"><component-page-section title="全局配置" subtitle="页面根" description="页面根通过 useGlobalConfig 订阅唯一 visualConfig Store，不维护第二份全局状态。"><pui-cell title="外观入口" description="点击 Navbar 的菜单可修改当前全局外观。" left-icon="palette" /><text class="component-page__status">{{providerStatus}}</text></component-page-section><component-page-section title="局部覆盖" subtitle="嵌套范围" description="局部 Provider 只影响自己的子树，不写入全局 Store。"><pui-config-provider theme="{{localTheme}}" shadow="{{localShadow}}" bordered="{{localBordered}}"><view class="component-page__stack"><pui-cell title="局部预览" description="局部主题与外观仅在这里生效。" left-icon="component" /><pui-tag theme="primary" variant="outline">局部 Provider</pui-tag></view></pui-config-provider><view class="component-page__row"><pui-switch value="{{localTheme === 'dark'}}" aria-label="局部深色主题" bind:change="onLocalThemeChange" /><pui-switch value="{{localShadow}}" aria-label="局部阴影" bind:change="onLocalShadowChange" /><pui-switch value="{{localBordered}}" aria-label="局部边框" bind:change="onLocalBorderedChange" /></view></component-page-section></view></pui-scroll-area></view></view></pui-config-provider>
