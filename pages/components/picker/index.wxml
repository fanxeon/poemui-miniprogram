<pui-config-provider class="component-config-provider" use-global-config><view class="component-page {{backgroundGradientEnabled ? 'component-page--gradient' : ''}}"><view id="component-navbar" class="component-page__navbar"><component-page-navbar title="{{pageTitle}}" bind:back="onBack" /></view><view class="component-page__scroll-row" style="height: {{scrollAreaHeight}};"><pui-scroll-area wx:if="{{layoutReady}}" class="component-page__scroll-area" height="{{scrollAreaHeight}}" gradient-overlay><view class="component-page__content"><component-page-section title="选择发布通道" subtitle="核心示例" description="默认把确定放在 Header 左侧、取消放在右侧；Classic 保留底部操作区。"><view class="component-page__row component-page__row--actions"><pui-button theme="primary" block data-type="default" bind:click="onOpenPicker">默认 Header 操作</pui-button><pui-button variant="outline" block data-type="classic" bind:click="onOpenPicker">Classic 底部操作</pui-button></view><text class="component-page__status" aria-live="polite">{{pickerStatus}}</text></component-page-section><component-page-section title="取消时保留原选择" subtitle="关键边界" description="关闭或取消不会覆盖已经确认的内容，避免误改。"><text class="component-page__status">当前选择：{{pickerValue[0] === 'preview' ? '预览版' : '稳定版'}}</text></component-page-section></view></pui-scroll-area></view><pui-picker columns="{{pickerColumns}}" value="{{pickerValue}}" visible="{{pickerVisible}}" type="{{pickerType}}" title="发布通道" aria-label="发布通道选择器" bind:visible-change="onPickerVisibleChange" bind:change="onPickerChange" bind:cancel="onPickerCancel" /></view></pui-config-provider>
