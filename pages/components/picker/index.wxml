<pui-config-provider class="component-config-provider" use-global-config><view class="component-page {{backgroundGradientEnabled ? 'component-page--gradient' : ''}}"><view id="component-navbar" class="component-page__navbar"><component-page-navbar title="{{pageTitle}}" bind:back="onBack" /></view><view class="component-page__scroll-row" style="height: {{scrollAreaHeight}};"><pui-scroll-area wx:if="{{layoutReady}}" class="component-page__scroll-area" height="{{scrollAreaHeight}}" gradient-overlay><view class="component-page__content"><component-page-section title="选择发布通道" subtitle="核心示例" description="滚动查看选项，只有点击确认才会采用新的选择。"><pui-button theme="primary" block bind:click="onOpenPicker">选择发布通道</pui-button><text class="component-page__status" aria-live="polite">{{pickerStatus}}</text></component-page-section><component-page-section title="取消时保留原选择" subtitle="关键边界" description="关闭或取消不会覆盖已经确认的内容，避免误改。"><text class="component-page__status">当前选择：{{pickerValue[0] === 'preview' ? '预览版' : '稳定版'}}</text></component-page-section></view></pui-scroll-area></view><pui-picker columns="{{pickerColumns}}" value="{{pickerValue}}" visible="{{pickerVisible}}" title="发布通道" aria-label="发布通道选择器" bind:visible-change="onPickerVisibleChange" bind:change="onPickerChange" bind:cancel="onPickerCancel" /></view></pui-config-provider>
