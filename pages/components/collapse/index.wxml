<pui-config-provider class="component-config-provider" use-global-config><view class="component-page {{backgroundGradientEnabled ? 'component-page--gradient' : ''}}"><view id="component-navbar" class="component-page__navbar"><component-page-navbar title="{{pageTitle}}" bind:back="onBack" /></view><view class="component-page__scroll-row" style="height: {{scrollAreaHeight}};"><pui-scroll-area wx:if="{{layoutReady}}" class="component-page__scroll-area" height="{{scrollAreaHeight}}" gradient-overlay><view class="component-page__content"><component-page-section title="查看常见问题" subtitle="核心示例" description="多个问题可以同时展开，用户可对照阅读不同答案。"><pui-collapse items="{{collapseItems}}" value="{{collapseValue}}" bind:change="onCollapseChange" /><text class="component-page__status">{{collapseStatus}}</text></component-page-section><component-page-section title="一次只聚焦一个答案" subtitle="互斥展开" description="内容较长时只保留一个打开项，减少页面来回跳动。"><pui-collapse items="{{collapseItems}}" default-value="{{['install']}}" expand-mutex theme="card" /></component-page-section></view></pui-scroll-area></view></view></pui-config-provider>
