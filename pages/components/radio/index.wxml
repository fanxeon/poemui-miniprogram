<pui-config-provider class="component-config-provider" use-global-config><view class="component-page {{backgroundGradientEnabled ? 'component-page--gradient' : ''}}"><view id="component-navbar" class="component-page__navbar"><component-page-navbar title="{{pageTitle}}" bind:back="onBack" /></view><view class="component-page__scroll-row" style="height: {{scrollAreaHeight}};"><pui-scroll-area wx:if="{{layoutReady}}" class="component-page__scroll-area" height="{{scrollAreaHeight}}" gradient-overlay><view class="component-page__content"><component-page-section title="选择发布通道" subtitle="核心示例" description="同一组内只能选择一个版本，说明文字帮助理解差异。"><pui-radio-group options="{{radioOptions}}" value="{{radioValue}}" aria-label="发布通道" bind:change="onRadioGroupChange" /><text class="component-page__status" aria-live="polite">{{radioStatus}}</text></component-page-section><component-page-section title="识别不可选项目" subtitle="关键边界" description="禁用选项仍显示原因，但不会替换当前选择。"><pui-radio checked="{{false}}" value="internal" label="内部通道" content="仅组织管理员可用。" disabled /></component-page-section></view></pui-scroll-area></view></view></pui-config-provider>
