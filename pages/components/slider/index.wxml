<pui-config-provider class="component-config-provider" use-global-config><view class="component-page {{backgroundGradientEnabled ? 'component-page--gradient' : ''}}"><view id="component-navbar" class="component-page__navbar"><component-page-navbar title="{{pageTitle}}" bind:back="onBack" /></view><view class="component-page__scroll-row" style="height: {{scrollAreaHeight}};"><pui-scroll-area wx:if="{{layoutReady}}" class="component-page__scroll-area" height="{{scrollAreaHeight}}" gradient-overlay><view class="component-page__content"><component-page-section title="调整发布进度" subtitle="核心示例" description="拖动时实时显示百分比，松手后确认最终数值。"><pui-slider value="{{sliderValue}}" min="0" max="100" step="5" show-value show-min-max value-suffix="%" aria-label="发布进度" bind:changing="onSliderChanging" bind:change="onSliderChange" /><text class="component-page__status" aria-live="polite">{{sliderStatus}}</text></component-page-section><component-page-section title="展示固定目标" subtitle="重要状态" description="只读进度保留完整信息；禁用进度明确表示暂不可调整。"><view class="component-page__stack"><pui-slider value="75" show-value value-suffix="%" readonly aria-label="只读进度" /><pui-slider value="30" show-value value-suffix="%" disabled aria-label="禁用进度" /></view></component-page-section></view></pui-scroll-area></view></view></pui-config-provider>
