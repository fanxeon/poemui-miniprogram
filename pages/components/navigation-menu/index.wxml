<pui-config-provider class="component-config-provider" use-global-config>
  <view class="component-page {{backgroundGradientEnabled ? 'component-page--gradient' : ''}}">
    <view id="component-navbar" class="component-page__navbar"><component-page-navbar title="{{pageTitle}}" bind:back="onBack" /></view>
    <view class="component-page__scroll-row" style="height: {{scrollAreaHeight}};">
      <pui-scroll-area wx:if="{{layoutReady}}" class="component-page__scroll-area" height="{{scrollAreaHeight}}" content-padding-bottom="{{pageContentPaddingBottom}}" gradient-overlay gradient-overlay-size="md" aria-label="NavigationMenu 组件用法">
        <view class="component-page__content">
          <component-page-section
            title="从顶部入口展开目录"
            subtitle="浮层导航"
            description="点击菜单自身的入口查看分层目录；关闭后回到原页面，不增加第二个打开按钮。"
          >
            <pui-navigation-menu
              id="horizontal-menu-demo"
              items="{{menuItems}}"
              visible="{{horizontalMenuVisible}}"
              value="{{horizontalMenuValue}}"
              expanded-value="{{horizontalMenuExpandedValue}}"
              checked-values="{{horizontalMenuCheckedValues}}"
              radio-values="{{horizontalMenuRadioValues}}"
              direction="horizontal"
              placement="bottom"
              show-header="{{true}}"
              show-overlay="{{true}}"
              close-on-select="{{true}}"
              close-on-check="{{false}}"
              z-index="{{horizontalMenuVisible ? 3200 : 1000}}"
              aria-label="水平浮层导航"
              bind:visible-change="onHorizontalMenuVisibleChange"
              bind:change="onHorizontalMenuChange"
              bind:expanded-change="onHorizontalMenuExpandedChange"
              bind:checked-change="onHorizontalMenuCheckedChange"
              bind:radio-change="onHorizontalMenuRadioChange"
            />
            <text class="navigation-page__status" aria-live="polite">{{horizontalMenuStatus}}</text>
          </component-page-section>

          <component-page-section
            title="在同一工作区浏览分类"
            subtitle="双栏导航"
            description="左侧选择根分类，右侧查看对应内容；两栏并排工作，不遮住整个页面。"
          >
            <pui-navigation-menu
              id="vertical-menu-demo"
              items="{{menuItems}}"
              visible="{{verticalMenuVisible}}"
              value="{{verticalMenuValue}}"
              expanded-value="{{verticalMenuExpandedValue}}"
              checked-values="{{verticalMenuCheckedValues}}"
              radio-values="{{verticalMenuRadioValues}}"
              direction="vertical"
              show-header="{{true}}"
              show-overlay="{{false}}"
              close-on-select="{{false}}"
              close-on-check="{{false}}"
              max-height="{{520}}"
              z-index="{{900}}"
              aria-label="垂直双栏导航"
              bind:visible-change="onVerticalMenuVisibleChange"
              bind:change="onVerticalMenuChange"
              bind:expanded-change="onVerticalMenuExpandedChange"
              bind:checked-change="onVerticalMenuCheckedChange"
              bind:radio-change="onVerticalMenuRadioChange"
            />
            <text class="navigation-page__status" aria-live="polite">{{verticalMenuStatus}}</text>
          </component-page-section>

          <component-page-section
            title="目录加载失败时继续操作"
            subtitle="恢复路径"
            description="错误只在展开菜单后出现；重新加载后由页面提供可用目录。"
          >
            <view class="navigation-menu-page__state-control">
              <view class="navigation-menu-page__state-copy">
                <text class="navigation-menu-page__state-title">模拟目录加载失败</text>
                <text class="navigation-menu-page__state-description">先开启失败状态，再从菜单入口查看恢复操作。</text>
              </view>
              <pui-switch
                value="{{errorMenuError}}"
                size="small"
                aria-label="模拟目录加载失败"
                bind:change="onErrorModeChange"
              />
            </view>
            <pui-navigation-menu
              id="error-menu-demo"
              items="{{menuItems}}"
              visible="{{errorMenuVisible}}"
              expanded-value="{{errorMenuExpandedValue}}"
              error="{{errorMenuError}}"
              direction="horizontal"
              placement="bottom"
              show-header="{{true}}"
              show-overlay="{{true}}"
              z-index="{{errorMenuVisible ? 3200 : 800}}"
              aria-label="错误恢复导航"
              bind:visible-change="onErrorMenuVisibleChange"
              bind:expanded-change="onErrorMenuExpandedChange"
              bind:retry="onErrorMenuRetry"
            />
            <text class="navigation-page__status" aria-live="polite">{{errorMenuStatus}}</text>
          </component-page-section>
        </view>
      </pui-scroll-area>
    </view>
  </view>
</pui-config-provider>
