<pui-config-provider class="component-config-provider" use-global-config><view class="component-page {{backgroundGradientEnabled ? 'component-page--gradient' : ''}}"><view id="component-navbar" class="component-page__navbar"><component-page-navbar title="{{pageTitle}}" bind:back="onBack" /></view><view class="component-page__scroll-row" style="height: {{scrollAreaHeight}};"><pui-scroll-area wx:if="{{layoutReady}}" class="component-page__scroll-area" height="{{scrollAreaHeight}}" gradient-overlay><view class="component-page__content"><component-page-section title="浏览员工资料" subtitle="连续且易扫描的信息" description="点击加载更多后，页面先回写加载态；真实追加的尾部条目再平滑展开。"><pui-list items="{{listItems}}" show-header show-footer loading="{{listLoading}}" finished="{{listFinished}}" error="{{listError}}" loading-text="正在加载资料" error-text="资料列表加载失败，点击重试" aria-label="员工资料列表" bind:click="onListClick" bind:load="onListLoad" bind:retry="onListRetry" /><text class="component-page__status">{{listStatus}}</text></component-page-section><component-page-section title="网络中断时恢复" subtitle="保留明确的下一步" description="Retry 只发布请求；本示例父级会真实进入 loading 并追加数据。"><pui-button content="模拟加载失败" theme="primary" block disabled="{{listLoading}}" bind:click="onToggleListError" /></component-page-section></view></pui-scroll-area></view></view></pui-config-provider>
