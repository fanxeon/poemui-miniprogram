<pui-config-provider class="component-config-provider" use-global-config><view class="component-page {{backgroundGradientEnabled ? 'component-page--gradient' : ''}}"><view id="component-navbar" class="component-page__navbar"><component-page-navbar title="{{pageTitle}}" bind:back="onBack" /></view><view class="component-page__scroll-row" style="height: {{scrollAreaHeight}};"><pui-scroll-area wx:if="{{layoutReady}}" class="component-page__scroll-area" height="{{scrollAreaHeight}}" gradient-overlay><view class="component-page__content"><component-page-section title="浏览员工资料" subtitle="连续且易扫描的信息" description="标题、说明与可用状态保持清楚，受限资料不会影响其他条目。"><pui-list items="{{listItems}}" show-header show-footer error="{{listError}}" error-text="资料列表加载失败" retry-text="重新加载" aria-label="员工资料列表" bind:click="onListClick" bind:retry="onListRetry" /><text class="component-page__status">{{listStatus}}</text></component-page-section><component-page-section title="网络中断时恢复" subtitle="保留明确的下一步" description="重新加载后继续显示当前状态，只有资料真正回来时才恢复列表。"><pui-button wx:if="{{!listError}}" content="模拟加载失败" theme="primary" block bind:click="onToggleListError" /><pui-button wx:else content="模拟资料已恢复" theme="primary" block bind:click="onRestoreList" /></component-page-section></view></pui-scroll-area></view></view></pui-config-provider>
