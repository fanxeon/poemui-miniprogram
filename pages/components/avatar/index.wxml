<pui-config-provider class="component-config-provider" use-global-config><view class="component-page {{backgroundGradientEnabled ? 'component-page--gradient' : ''}}"><view id="component-navbar" class="component-page__navbar"><component-page-navbar title="{{pageTitle}}" bind:back="onBack" /></view><view class="component-page__scroll-row" style="height: {{scrollAreaHeight}};"><pui-scroll-area wx:if="{{layoutReady}}" class="component-page__scroll-area" height="{{scrollAreaHeight}}" gradient-overlay><view class="component-page__content"><component-page-section title="识别用户与对象" subtitle="核心示例" description="优先显示图片；图片不可用时仍保留文字首字母或人物图标。"><view class="data-page__row"><pui-avatar src="/assets/poemui-moon-lines-black.png" alt="PoemUI" shape="{{avatarShape}}" size="large" /><pui-avatar text="PU" shape="{{avatarShape}}" size="large" /><pui-avatar icon="user" shape="{{avatarShape}}" size="large" /></view><text class="component-page__status">{{avatarStatus}}</text></component-page-section><component-page-section title="比较圆形与圆角头像" subtitle="形状变化" description="切换形状不会改变头像来源，也不会让圆形受到大圆角设置影响。"><pui-button content="切换形状" theme="primary" block bind:click="onToggleAvatarShape" /></component-page-section></view></pui-scroll-area></view></view></pui-config-provider>
