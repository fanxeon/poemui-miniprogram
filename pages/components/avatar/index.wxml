<pui-config-provider class="component-config-provider" use-global-config>
  <view class="component-page {{backgroundGradientEnabled ? 'component-page--gradient' : ''}}">
    <view id="component-navbar" class="component-page__navbar">
      <component-page-navbar title="{{pageTitle}}" bind:back="onBack" />
    </view>
    <view class="component-page__scroll-row" style="height: {{scrollAreaHeight}};">
      <pui-scroll-area wx:if="{{layoutReady}}" class="component-page__scroll-area" height="{{scrollAreaHeight}}" gradient-overlay>
        <view class="component-page__content">
          <component-page-section title="图片与加载" subtitle="组件内部状态" description="真实头像按需请求；持续加载示例也由 Avatar 自己绘制 Loading，不在页面外部拼装。">
            <view class="data-page__row">
              <pui-avatar id="avatar-primary" src="{{avatarSource}}" alt="真实用户头像" lazy shape="{{avatarShape}}" size="large" />
              <pui-avatar id="avatar-loading" loading text="L" aria-label="头像持续加载中" shape="{{avatarShape}}" size="large" />
              <pui-avatar id="avatar-fallback" src="/assets/avatar-missing.png" text="F" alt="失败回退" lazy shape="{{avatarShape}}" size="large" />
            </view>
          </component-page-section>
          <component-page-section title="资源与形状" subtitle="真实重新请求" description="切换 src 会重新进入组件内部加载态；lazy 只决定图片何时开始请求。">
            <view class="component-page__row component-page__row--actions">
              <pui-button content="切换图片" theme="primary" block bind:click="onChangeAvatarSource" />
              <pui-button content="切换形状" variant="outline" block bind:click="onToggleAvatarShape" />
            </view>
          </component-page-section>
        </view>
      </pui-scroll-area>
    </view>
  </view>
</pui-config-provider>
