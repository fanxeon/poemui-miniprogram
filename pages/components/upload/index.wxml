<pui-config-provider class="component-config-provider" use-global-config><view class="component-page {{backgroundGradientEnabled ? 'component-page--gradient' : ''}}"><view id="component-navbar" class="component-page__navbar"><component-page-navbar title="{{pageTitle}}" bind:back="onBack" /></view><view class="component-page__scroll-row" style="height: {{scrollAreaHeight}};"><pui-scroll-area wx:if="{{layoutReady}}" class="component-page__scroll-area" height="{{scrollAreaHeight}}" gradient-overlay><view class="component-page__content"><component-page-section title="添加图片附件" subtitle="核心示例" description="最多选择三张图片；本页只接收本地文件，不会假装已经上传到服务器。"><pui-upload files="{{uploadFiles}}" max="3" picker="media" media-type="{{['image']}}" add-content="选择图片附件" aria-label="图片附件选择" bind:change="onUploadChange" bind:add="onUploadAdd" bind:reject="onUploadReject" bind:error="onUploadError" /><text class="component-page__status" aria-live="polite">{{uploadStatus}}</text></component-page-section><component-page-section title="看懂文件处理状态" subtitle="重要状态" description="等待、上传中和失败都由使用页面明确提供；失败项只突出一次原因，重试入口保持在右侧。"><pui-upload id="upload-state-demo" files="{{uploadStateFiles}}" max="3" add-btn="{{false}}" preview="{{false}}" remove-btn="{{false}}" aria-label="附件状态示例" bind:retry="onUploadRetry" /><text class="component-page__status" aria-live="polite">{{uploadStateStatus}}</text></component-page-section></view></pui-scroll-area></view></view></pui-config-provider>
