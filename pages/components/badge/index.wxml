<pui-config-provider class="component-config-provider" use-global-config><view class="component-page {{backgroundGradientEnabled ? 'component-page--gradient' : ''}}"><view id="component-navbar" class="component-page__navbar"><component-page-navbar title="{{pageTitle}}" bind:back="onBack" /></view><view class="component-page__scroll-row" style="height: {{scrollAreaHeight}};"><pui-scroll-area wx:if="{{layoutReady}}" class="component-page__scroll-area" height="{{scrollAreaHeight}}" gradient-overlay><view class="component-page__content"><component-page-section title="提示未读数量" subtitle="核心示例" description="数字适合明确数量，红点适合只提醒“有新内容”。"><view class="data-page__row"><pui-badge count="{{badgeCount}}" show-zero max-count="99"><pui-icon name="bell" size="48" /></pui-badge><pui-badge dot><pui-icon name="message" size="48" /></pui-badge></view><text class="component-page__status">{{badgeStatus}}</text></component-page-section><component-page-section title="比较 0 与大数量" subtitle="数值边界" description="0 可以按需保留；超过 99 时显示 99+，避免徽标挤压宿主内容。"><pui-button content="切换数量" theme="primary" block bind:click="onCycleBadge" /></component-page-section></view></pui-scroll-area></view></view></pui-config-provider>
