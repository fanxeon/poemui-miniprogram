<pui-config-provider class="component-config-provider" use-global-config><view class="component-page {{backgroundGradientEnabled ? 'component-page--gradient' : ''}}"><view id="component-navbar" class="component-page__navbar"><component-page-navbar title="{{pageTitle}}" bind:back="onBack" /></view><view class="component-page__scroll-row" style="height: {{scrollAreaHeight}};"><pui-scroll-area wx:if="{{layoutReady}}" class="component-page__scroll-area" height="{{scrollAreaHeight}}" gradient-overlay><view class="component-page__content"><component-page-section title="选择发布日期" subtitle="核心示例" description="直接在月历中选择日期，周末不可选，确认后保留最终结果。"><pui-calendar value="{{calendarValue}}" title="选择发布日期" type="single" use-popup="{{false}}" visible="{{true}}" auto-close="{{false}}" disable-weekends aria-label="发布日期选择" bind:change="onCalendarChange" bind:confirm="onCalendarConfirm" /><text class="component-page__status" aria-live="polite">{{calendarStatus}}</text></component-page-section><component-page-section title="日期限制清晰可见" subtitle="关键边界" description="不可选日期仍保留在月历中，用户能理解范围而不会误触。"><text class="component-page__status">本示例禁用周六和周日，工作日可正常选择。</text></component-page-section></view></pui-scroll-area></view></view></pui-config-provider>
