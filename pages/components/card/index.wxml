<pui-config-provider class="component-config-provider" use-global-config>
  <view class="component-page {{backgroundGradientEnabled ? 'component-page--gradient' : ''}}">
    <view id="component-navbar" class="component-page__navbar">
      <component-page-navbar title="{{pageTitle}}" bind:back="onBack" />
    </view>
    <view class="component-page__scroll-row" style="height: {{scrollAreaHeight}};">
      <pui-scroll-area wx:if="{{layoutReady}}" class="component-page__scroll-area" height="{{scrollAreaHeight}}" gradient-overlay>
        <view class="component-page__content">
          <component-page-section title="发布前检查" subtitle="固定右侧 Slot" description="header-right 最多承载三个紧凑操作，业务事件由 Slot 内按钮处理。">
            <pui-card title="Tabs 更新已准备" description="横向滑动、主题和外观开关都将在发布前复核。" clickable shadow show-footer bind:click="onCardClick">
              <view slot="header-right">
                <pui-button icon="star" icon-only size="small" shape="circle" aria-label="收藏验收卡" bind:click="onCardHeaderAction" />
              </view>
              <pui-tag theme="warning" variant="light" content="待用户确认" />
              <pui-direction content="影响范围：组件导航与内容切换" />
              <pui-direction content="下一步：查看验收清单" />
              <pui-button slot="footer" content="查看验收清单" theme="primary" block bind:click="onCardAction" />
            </pui-card>
            <text class="component-page__status">{{cardStatus}}</text>
          </component-page-section>

          <component-page-section title="更多操作" subtitle="默认 More 下拉菜单" description="未提供 header-right Slot 且 menuItems 非空时，Card 自动显示 More 圆形图标按钮。">
            <pui-card id="card-menu-demo" title="发布记录" description="菜单只回传选项，由页面负责更新真实结果。" menu-items="{{cardMenuItems}}" bind:menu-select="onCardMenuSelect">
              <pui-direction content="版本：0.1.1" />
              <pui-direction content="状态：等待复核" />
            </pui-card>
          </component-page-section>

          <component-page-section title="归档记录" subtitle="不可操作但可阅读" description="禁用 Card 保持内容与视觉层级，不再给出无效动作。">
            <pui-card title="上一个发布批次" description="该记录已归档，供阅读核对。" padding="compact" disabled>
              <pui-tag theme="default" variant="outline" content="已归档" />
            </pui-card>
          </component-page-section>
        </view>
      </pui-scroll-area>
    </view>
  </view>
</pui-config-provider>
