<pui-config-provider class="component-config-provider" use-global-config><view class="component-page {{backgroundGradientEnabled ? 'component-page--gradient' : ''}}"><view id="component-navbar" class="component-page__navbar"><component-page-navbar title="{{pageTitle}}" bind:back="onBack" /></view><view class="component-page__scroll-row" style="height: {{scrollAreaHeight}};"><pui-scroll-area wx:if="{{layoutReady}}" class="component-page__scroll-area" height="{{scrollAreaHeight}}" gradient-overlay><view class="component-page__content"><component-page-section title="选择发布通道" subtitle="核心示例" description="选项数量较少且无需搜索时，在 PUI 浮层中完成一次单选。"><pui-select id="select-demo" options="{{selectOptions}}" value="{{selectValue}}" placeholder="请选择发布通道" aria-label="发布通道" bind:change="onSelectChange" /><text class="component-page__status" aria-live="polite">{{selectStatus}}</text></component-page-section><component-page-section title="说明不可更改的选择" subtitle="关键边界" description="只读内容可以查看；禁用内容同时表达当前无法操作。"><view class="component-page__stack"><pui-select options="{{selectOptions}}" value="stable" readonly aria-label="只读发布通道" /><pui-select options="{{selectOptions}}" value="preview" disabled aria-label="禁用发布通道" /></view></component-page-section></view></pui-scroll-area></view></view></pui-config-provider>
