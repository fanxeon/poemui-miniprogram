<pui-config-provider class="component-config-provider" use-global-config><view class="component-page {{backgroundGradientEnabled ? 'component-page--gradient' : ''}}"><view id="component-navbar" class="component-page__navbar"><component-page-navbar title="{{pageTitle}}" bind:back="onBack" /></view><view class="component-page__scroll-row" style="height: {{scrollAreaHeight}};"><pui-scroll-area wx:if="{{layoutReady}}" class="component-page__scroll-area" height="{{scrollAreaHeight}}" gradient-overlay><view class="component-page__content"><component-page-section title="评价组件体验" subtitle="核心示例" description="支持半星选择，并把分数转换成容易理解的评价文字。"><pui-rate value="{{rateValue}}" count="5" allow-half show-text texts="{{rateTexts}}" aria-label="组件评分" bind:change="onRateChange" /><text class="component-page__status" aria-live="polite">{{rateStatus}}</text></component-page-section><component-page-section title="展示已有评分" subtitle="重要状态" description="只读评分适合结果展示；禁用评分表示当前不接受评价。"><view class="component-page__stack"><pui-rate value="4.5" allow-half show-text texts="{{rateTexts}}" readonly aria-label="已有评分" /><pui-rate value="2" disabled aria-label="不可评分" /></view></component-page-section></view></pui-scroll-area></view></view></pui-config-provider>
