<pui-config-provider class="component-config-provider" use-global-config><view class="component-page {{backgroundGradientEnabled ? 'component-page--gradient' : ''}}"><view id="component-navbar" class="component-page__navbar"><component-page-navbar title="{{pageTitle}}" bind:back="onBack" /></view><view class="component-page__scroll-row" style="height: {{scrollAreaHeight}};"><pui-scroll-area wx:if="{{layoutReady}}" class="component-page__scroll-area" height="{{scrollAreaHeight}}" gradient-overlay><view class="component-page__content"><component-page-section title="组织连续对话消息" subtitle="核心示例" description="同一发送者的连续消息共享圆角节奏，对方与自己的消息保持清楚方向。"><view class="component-page__stack"><pui-bubble content="Tabs 超过四项时会露出下一项。" variant="secondary" group-position="first" /><pui-bubble content="这样用户会知道还可以向右滑动。" variant="muted" group-position="last" /><pui-bubble content="这个说明比较长，可以收起成一行；需要时再展开阅读完整内容。" align="end" collapsible expanded="{{bubbleExpanded}}" max-lines="1" reactions="{{bubbleReactions}}" bind:change="onBubbleChange" bind:reaction="onBubbleReaction" /></view><text class="component-page__status">{{bubbleStatus}}</text></component-page-section></view></pui-scroll-area></view></view></pui-config-provider>
