<pui-config-provider class="component-config-provider" use-global-config><view class="component-page {{backgroundGradientEnabled ? 'component-page--gradient' : ''}}"><view id="component-navbar" class="component-page__navbar"><component-page-navbar title="{{pageTitle}}" bind:back="onBack" /></view><view class="component-page__scroll-row" style="height: {{scrollAreaHeight}};"><pui-scroll-area wx:if="{{layoutReady}}" class="component-page__scroll-area" height="{{scrollAreaHeight}}" gradient-overlay><view class="component-page__content"><component-page-section title="安排发布时间" subtitle="核心示例" description="默认 Header 使用左右图标操作；Classic 保留底部操作区。"><view class="component-page__row component-page__row--actions"><pui-button theme="primary" block data-type="default" bind:click="onOpenDateTimePicker">默认 Header 操作</pui-button><pui-button variant="outline" block data-type="classic" bind:click="onOpenDateTimePicker">Classic 底部操作</pui-button></view><text class="component-page__status" aria-live="polite">{{dateTimeStatus}}</text></component-page-section><component-page-section title="取消时不改变安排" subtitle="关键边界" description="滚动中的内容只是临时选择；关闭或取消后仍保留之前确认的时间。"><text class="component-page__status">已安排：2026-07-27 09:00</text></component-page-section></view></pui-scroll-area></view><pui-date-time-picker value="{{dateTimeValue}}" visible="{{dateTimeVisible}}" mode="{{dateTimeMode}}" steps="{{dateTimeSteps}}" show-week type="{{dateTimeType}}" title="选择日期与时间" aria-label="日期时间选择器" bind:visible-change="onDateTimeVisibleChange" bind:change="onDateTimeChange" bind:cancel="onDateTimeCancel" /></view></pui-config-provider>
