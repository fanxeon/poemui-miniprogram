<pui-config-provider class="component-config-provider" use-global-config><view class="component-page {{backgroundGradientEnabled ? 'component-page--gradient' : ''}}"><view id="component-navbar" class="component-page__navbar"><component-page-navbar title="{{pageTitle}}" bind:back="onBack" /></view><view class="component-page__scroll-row" style="height: {{scrollAreaHeight}};"><pui-scroll-area wx:if="{{layoutReady}}" class="component-page__scroll-area" height="{{scrollAreaHeight}}" gradient-overlay aria-label="Direction 组件用法"><view class="component-page__content"><component-page-section title="正确排列双向文字" subtitle="核心示例" description="阅读方向会改变起始边和对齐方式，但不会倒序或改写原文。"><pui-direction direction="{{directionValue}}" language="{{directionLanguage}}" aria-label="阅读方向示例"><pui-cell title="{{directionLanguage === 'ar' ? 'مرحبا بك في Poem UI' : 'Welcome to Poem UI'}}" description="{{directionLanguage === 'ar' ? 'مكتبة مكونات للبرامج المصغرة' : 'A component library for mini programs'}}" left-icon="arrow-left-right" /></pui-direction><text class="component-page__status">{{directionStatus}}</text></component-page-section><component-page-section title="比较从左到右与从右到左" subtitle="重要变化" description="依次切换固定方向和自动识别，再更换中英文内容观察结果。"><view class="component-page__row component-page__row--actions"><pui-button block content="切换方向" theme="primary" bind:click="onCycleDirection" /><pui-button block content="切换语言" variant="outline" bind:click="onToggleLanguage" /></view></component-page-section></view></pui-scroll-area></view></view></pui-config-provider>
