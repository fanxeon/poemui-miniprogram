<pui-config-provider class="component-config-provider" use-global-config><view class="component-page {{backgroundGradientEnabled ? 'component-page--gradient' : ''}}"><view id="component-navbar" class="component-page__navbar"><component-page-navbar title="{{pageTitle}}" bind:back="onBack" /></view><view class="component-page__scroll-row" style="height: {{scrollAreaHeight}};"><pui-scroll-area wx:if="{{layoutReady}}" class="component-page__scroll-area" height="{{scrollAreaHeight}}" gradient-overlay><view class="component-page__content"><component-page-section title="说明输入内容" subtitle="核心示例" description="标签先告诉用户要填写什么，再由必填标记说明是否必须完成。"><view class="component-page__stack"><pui-label content="组件名称" required="{{labelRequired}}" colon="{{labelColon}}" /><pui-input placeholder="例如 NavigationMenu" /></view><text class="component-page__status" aria-live="polite">{{labelSummary}}</text></component-page-section><component-page-section title="比较两种标记" subtitle="可见变化" description="切换必填标记和中文冒号，观察标签本身如何变化。"><view class="component-page__stack"><view class="component-page__row"><pui-switch value="{{labelRequired}}" aria-label="显示必填标记" bind:change="onLabelRequiredChange" /><pui-label content="显示必填标记" /></view><view class="component-page__row"><pui-switch value="{{labelColon}}" aria-label="显示冒号" bind:change="onLabelColonChange" /><pui-label content="显示中文冒号" /></view></view></component-page-section></view></pui-scroll-area></view></view></pui-config-provider>
