<pui-config-provider class="component-config-provider" use-global-config><view class="component-page {{backgroundGradientEnabled ? 'component-page--gradient' : ''}}"><view id="component-navbar" class="component-page__navbar"><component-page-navbar title="{{pageTitle}}" bind:back="onBack" /></view><view class="component-page__scroll-row" style="height: {{scrollAreaHeight}};"><pui-scroll-area wx:if="{{layoutReady}}" class="component-page__scroll-area" height="{{scrollAreaHeight}}" gradient-overlay><view class="component-page__content"><component-page-section title="选择需要的能力" subtitle="核心示例" description="复选框组允许同时选择多项，并把每一项的说明放在名称旁边。"><pui-checkbox-group options="{{checkboxOptions}}" value="{{checkboxValues}}" max="2" aria-label="需要启用的能力" bind:change="onCheckboxGroupChange" /><text class="component-page__status" aria-live="polite">{{checkboxStatus}}</text></component-page-section><component-page-section title="确认单独协议" subtitle="关键边界" description="独立确认项可以决定是否继续；禁用项会保留内容但阻止操作。"><view class="component-page__stack"><pui-checkbox checked="{{checkboxChecked}}" value="agreement" label="同意组件使用规范" content="阅读后可单独确认。" bind:change="onCheckboxChange" /><pui-checkbox checked value="locked" label="组织安全规范" content="由管理员统一启用。" disabled /></view></component-page-section></view></pui-scroll-area></view></view></pui-config-provider>
