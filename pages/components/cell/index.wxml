<pui-config-provider class="component-config-provider" use-global-config><view class="component-page {{backgroundGradientEnabled ? 'component-page--gradient' : ''}}"><view id="component-navbar" class="component-page__navbar"><component-page-navbar title="{{pageTitle}}" bind:back="onBack" /></view><view class="component-page__scroll-row" style="height: {{scrollAreaHeight}};"><pui-scroll-area wx:if="{{layoutReady}}" class="component-page__scroll-area" height="{{scrollAreaHeight}}" gradient-overlay><view class="component-page__content"><component-page-section title="呈现信息、导航与选择" subtitle="核心示例" description="同一种列表行可以承载说明、真实页面入口或轻量选择。"><pui-cell title="Dialog 组件" description="查看对话框的真实独立页面。" left-icon="dialog" arrow clickable url="/pages/components/dialog/index" jump-type="navigateTo" /><pui-cell title="加入常用组件" description="再次点击可以取消选择。" selectable selected="{{cellSelected}}" bind:change="onCellChange" bind:click="onCellClick" /><text class="component-page__status">{{cellStatus}}</text></component-page-section><component-page-section title="说明当前不可操作" subtitle="禁用状态" description="条目仍保留原因说明，但不会触发选择或跳转。"><pui-cell title="组织内部组件" description="当前账号没有访问权限。" disabled left-icon="lock" /></component-page-section></view></pui-scroll-area></view></view></pui-config-provider>
