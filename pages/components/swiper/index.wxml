<pui-config-provider class="component-config-provider" use-global-config><view class="component-page {{backgroundGradientEnabled ? 'component-page--gradient' : ''}}"><view id="component-navbar" class="component-page__navbar"><component-page-navbar title="{{pageTitle}}" bind:back="onBack" /></view><view class="component-page__scroll-row" style="height: {{scrollAreaHeight}};"><pui-scroll-area wx:if="{{layoutReady}}" class="component-page__scroll-area" height="{{scrollAreaHeight}}" gradient-overlay><view class="component-page__content"><component-page-section title="浏览产品亮点" subtitle="同层内容连续切换" description="左右滑动或使用分页切换内容，当前页和总数量始终清楚可见。"><pui-swiper items="{{swiperItems}}" value="{{swiperValue}}" height="320" navigation="{{true}}" aria-label="产品亮点轮播" bind:change="onSwiperChange" /><text class="component-page__status">{{swiperStatus}}</text></component-page-section><component-page-section title="图片暂时无法读取" subtitle="保留恢复入口" description="错误出现时不留下空白区域，重新加载后继续展示同一组内容。"><pui-swiper items="{{swiperItems}}" error="{{swiperError}}" height="240" navigation="{{true}}" error-text="轮播内容加载失败" retry-text="重新加载" aria-label="错误轮播" bind:retry="onSwiperRetry" /></component-page-section></view></pui-scroll-area></view></view></pui-config-provider>
