<pui-config-provider class="component-config-provider" use-global-config><view class="component-page {{backgroundGradientEnabled ? 'component-page--gradient' : ''}}"><view id="component-navbar" class="component-page__navbar"><component-page-navbar title="{{pageTitle}}" bind:back="onBack" /></view><view class="component-page__scroll-row" style="height: {{scrollAreaHeight}};"><pui-scroll-area wx:if="{{layoutReady}}" class="component-page__scroll-area" height="{{scrollAreaHeight}}" gradient-overlay><view class="component-page__content"><component-page-section title="撰写组件说明" subtitle="核心示例" description="输入框会随内容增高，并始终显示剩余字数。"><pui-textarea id="textarea-primary" value="{{textareaValue}}" label="组件说明" placeholder="说明它解决什么问题、适合什么场景" maxcharacter="120" indicator autosize="{{true}}" bind:change="onTextareaChange" /><text class="component-page__status" aria-live="polite">{{textareaStatus}}</text></component-page-section><component-page-section title="保留可读的历史内容" subtitle="重要状态" description="只读内容仍保持完整排版；错误状态把问题放在输入区附近。"><view class="component-page__stack"><pui-textarea value="适用于需要在页面内补充较长说明的场景。" label="只读说明" readonly autosize="{{true}}" /><pui-textarea value="太短" label="提交说明" status="error" tips="请至少写 10 个字" readonly /></view></component-page-section></view></pui-scroll-area></view></view></pui-config-provider>
