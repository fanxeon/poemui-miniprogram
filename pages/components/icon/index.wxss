@import "../../../styles/component-page.wxss";

.component-page__icon-search-row {
  display: flex;
  width: 100%;
  min-width: 0;
}

.component-page__icon-search-host,
.component-page__icon-search {
  flex: 1;
  width: 100%;
  min-width: 0;
}

.component-page__icon-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: var(--pui-content-gap);
  width: 100%;
  min-width: 0;
}

.component-page__icon-grid-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  gap: var(--pui-space-xs);
  min-width: 0;
  padding: var(--pui-content-gap);
}

.component-page__icon-grid-name {
  display: block;
  width: 100%;
  color: var(--pui-text-secondary);
  font-size: var(--pui-font-size-body-small);
  line-height: var(--pui-line-height-body-small);
  overflow-wrap: anywhere;
  text-align: center;
}
