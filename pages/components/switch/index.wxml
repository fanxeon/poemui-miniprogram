<pui-config-provider class="component-config-provider" use-global-config><view class="component-page {{backgroundGradientEnabled ? 'component-page--gradient' : ''}}"><view id="component-navbar" class="component-page__navbar"><component-page-navbar title="{{pageTitle}}" bind:back="onBack" /></view><view class="component-page__scroll-row" style="height: {{scrollAreaHeight}};"><pui-scroll-area wx:if="{{layoutReady}}" class="component-page__scroll-area" height="{{scrollAreaHeight}}" gradient-overlay><view class="component-page__content"><component-page-section title="开启更新通知" subtitle="核心示例" description="开关适合立即生效的独立设置，状态变化会给出清晰反馈。"><view class="component-page__row"><pui-switch value="{{switchValue}}" label="{{switchLabels}}" aria-label="更新通知" bind:change="onSwitchChange" /><text>接收组件更新提醒</text></view><text class="component-page__status" aria-live="polite">{{switchStatus}}</text></component-page-section><component-page-section title="辨认等待与锁定" subtitle="重要状态" description="加载中表示正在处理；只读和禁用状态都不会响应切换。"><view class="component-page__stack"><view class="component-page__row"><pui-switch value loading aria-label="正在保存的开关" /><text>正在保存</text></view><view class="component-page__row"><pui-switch value readonly aria-label="只读开关" /><text>由组织统一开启</text></view><view class="component-page__row"><pui-switch value="{{false}}" disabled aria-label="禁用开关" /><text>当前计划不可用</text></view></view></component-page-section></view></pui-scroll-area></view></view></pui-config-provider>
