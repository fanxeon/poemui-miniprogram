<view
  class="{{rootClass}} {{customClass}}"
  style="{{customStyle}};{{rootStyle}}"
  role="group"
  aria-label="{{semanticLabel}}"
  aria-disabled="{{disabled}}"
  aria-readonly="{{readonly}}"
>
  <view class="pui-stepper__button-track">
    <pui-button
      style="display:block;width:100%;height:100%;"
      custom-class="pui-stepper__button {{atMin ? 'pui-stepper__button--limit' : ''}}"
      custom-style="width:100%;height:100%;"
      theme="default"
      variant="text"
      size="{{buttonSize}}"
      shape="square"
      icon="minus"
      disabled="{{locked}}"
      aria-label="{{minusLabel}}"
      reduce-motion="{{reduceMotion}}"
      color-scheme="{{colorScheme}}"
      bind:click="onMinus"
    />
  </view>
  <view class="pui-stepper__input-track">
    <pui-input
      style="display:block;width:100%;min-width:0;"
      custom-class="pui-stepper__input"
      custom-style="width:100%;min-width:0;"
      value="{{displayValue}}"
      type="{{inputType}}"
      size="{{inputSize}}"
      align="center"
      bordered="{{false}}"
      disabled="{{disabled || disableInput}}"
      readonly="{{readonly}}"
      confirm-type="done"
      aria-label="{{semanticLabel}}"
      reduce-motion="{{reduceMotion}}"
      color-scheme="{{colorScheme}}"
      bind:change="onInputChange"
      bind:enter="onEnter"
      bind:focus="onFocus"
      bind:blur="onBlur"
    />
  </view>
  <view class="pui-stepper__button-track">
    <pui-button
      style="display:block;width:100%;height:100%;"
      custom-class="pui-stepper__button {{atMax ? 'pui-stepper__button--limit' : ''}}"
      custom-style="width:100%;height:100%;"
      theme="default"
      variant="text"
      size="{{buttonSize}}"
      shape="square"
      icon="add"
      disabled="{{locked}}"
      aria-label="{{plusLabel}}"
      reduce-motion="{{reduceMotion}}"
      color-scheme="{{colorScheme}}"
      bind:click="onPlus"
    />
  </view>
</view>
