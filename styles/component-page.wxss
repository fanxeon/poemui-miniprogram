.component-config-provider,
.component-page {
  display: block;
  width: 100%;
  height: 100%;
  min-height: 0;
}

.component-page {
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  color: var(--pui-text-primary);
  font-family: var(--pui-font-family-sans);
  background: var(--pui-bg-page);
  --pui-scroll-area-gradient-overlay-color-context: var(--pui-bg-page);
}

.component-page--gradient {
  background: linear-gradient(145deg, var(--pui-bg-page), var(--pui-bg-muted));
}

.component-page__navbar {
  flex: 0 0 auto;
  width: 100%;
}

.component-page__navbar-actions {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--pui-space-xs);
  width: 100%;
  min-width: 0;
}

.component-page__navbar-action {
  display: flex;
  flex: 1 1 0;
  align-items: center;
  justify-content: center;
  min-width: 0;
}

.component-page__scroll-row {
  box-sizing: border-box;
  flex: 0 0 auto;
  width: 100%;
  min-height: 0;
  overflow: hidden;
}

.component-page__scroll-area {
  width: 100%;
  height: 100%;
}

.component-page__content {
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  gap: var(--pui-section-gap);
  width: 100%;
  min-width: 0;
  min-height: 100%;
  padding: var(--pui-panel-padding) var(--pui-panel-padding) var(--pui-section-gap);
}

.component-page__status,
.component-page__empty {
  color: var(--pui-text-secondary);
  font-size: var(--pui-font-size-body-small);
  line-height: var(--pui-line-height-body-small);
}

.component-page__status,
.component-page__empty {
  display: block;
}

.component-page__row,
.component-page__inline,
.component-page__icon-scale {
  display: flex;
  align-items: center;
  gap: var(--pui-content-gap);
  width: 100%;
  min-width: 0;
  flex-wrap: wrap;
}

.component-page__row--actions {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  align-items: stretch;
  gap: var(--pui-content-gap);
}

.component-page__inline--center {
  justify-content: center;
}

.component-page__stack {
  display: flex;
  flex-direction: column;
  gap: var(--pui-content-gap);
  width: 100%;
  min-width: 0;
}

.component-page__block {
  width: 100%;
}

.component-page__icon-preview {
  display: flex;
  align-items: center;
  gap: var(--pui-content-gap);
  min-width: 0;
}

.component-page__icon-preview-copy {
  display: flex;
  flex-direction: column;
  gap: var(--pui-space-xs);
  min-width: 0;
}

.component-page__icon-preview-copy text:first-child {
  color: var(--pui-text-primary);
  font-size: var(--pui-font-size-body-medium);
  font-weight: var(--pui-font-weight-semibold);
  line-height: var(--pui-line-height-body-medium);
}

.component-page__icon-preview-copy text:last-child,
.component-page__icon-scale-label,
.component-page__icon-name {
  color: var(--pui-text-secondary);
  font-size: var(--pui-font-size-caption);
  line-height: var(--pui-line-height-caption);
}

.component-page__icon-scale-item {
  display: inline-flex;
  align-items: center;
  gap: var(--pui-space-xs);
}

.component-page__icon-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: var(--pui-content-gap);
  width: 100%;
  min-width: 0;
}

.component-page__icon-card,
.component-page__icon-card-content {
  width: 100%;
  min-width: 0;
}

.component-page__icon-card-content {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  gap: var(--pui-space-xs);
}

.component-page__icon-name {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
