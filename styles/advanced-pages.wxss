.advanced-page__scroll-owner, .advanced-page__owner { box-sizing: border-box; width: 100%; min-height: 0; }
.advanced-page__content, .advanced-page__owner { display: flex; flex-direction: column; gap: var(--pui-section-gap); box-sizing: border-box; width: 100%; min-width: 0; padding: var(--pui-panel-padding); }
.advanced-page__toolbar { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--pui-content-gap); width: 100%; min-width: 0; }
.advanced-page__watermark-content { box-sizing: border-box; min-height: 320rpx; padding: var(--pui-panel-padding); }
