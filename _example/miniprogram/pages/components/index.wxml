    <pui-card title="Popup 受控显隐" description="页面负责打开与 visible-change 回写；内容、表单和业务结果由默认 slot 组合。" custom-class="section-card">
      <pui-button theme="primary" block bind:click="openPopup">打开 Popup</pui-button>
      <pui-cell title="Popup 状态" description="关闭按钮或遮罩只请求关闭，受控页面决定是否写回 visible。" value="{{popupResult}}" />
      <pui-button variant="text" block bind:click="goBack">返回主题页</pui-button>
    </pui-card>

    <pui-card title="Popover 受控锚点气泡层" description="默认 Slot 是触发元素，content Slot 承载组合内容；页面只回写 visible。" custom-class="section-card">
      <pui-popover
        id="deliveryPopover"
        visible="{{popoverVisible}}"
        placement="bottom"
        content="点击外部区域会请求页面关闭。"
        theme="dark"
        aria-label="组件说明气泡层"
        bind:visible-change="onPopoverVisibleChange"
      >
        <pui-button variant="outline" icon="more-horizontal" bind:click="openPopover">更多操作</pui-button>
        <view slot="content" class="popover-example-content">
          <pui-cell title="组件状态" description="content Slot 由消费者组合" value="ready" left-icon="component" />
          <pui-tag theme="primary" variant="outline">可发布</pui-tag>
        </view>
      </pui-popover>
      <pui-cell title="Popover 状态" description="外部点击仅发 visible-change，页面决定是否关闭。" value="{{popoverResult}}" />
    </pui-card>

    <pui-card title="Tooltip 受控触摸提示" description="默认 slot 作为 reference，content slot 组合 Icon 与 Tag；页面真实回写 visible，并可调用实例方法。" custom-class="section-card">
      <view class="tooltip-example-stage">
        <pui-tooltip
          id="deliveryTooltip"
          visible="{{tooltipVisible}}"
          custom-content
          trigger="tap"
          placement="top"
          align="center"
          close-on-content-click
          duration="0"
          aria-label="组件交付提示"
          motion-duration="180"
          bind:input="onTooltipInput"
          bind:change="onTooltipChange"
          bind:show="onTooltipShow"
          bind:hide="onTooltipHide"
          bind:reference-click="onTooltipReferenceClick"
          bind:reference-longpress="onTooltipReferenceLongpress"
          bind:content-click="onTooltipContentClick"
          bind:after-show="onTooltipAfterShow"
          bind:after-hide="onTooltipAfterHide"
        >
          <pui-button variant="outline" icon="info-circle">查看交付提示</pui-button>
          <view slot="content" class="tooltip-example-content">
            <pui-icon name="info-circle" size="24" />
            <text>Tooltip + Icon + Tag</text>
            <pui-tag theme="primary" variant="outline">可组合</pui-tag>
          </view>
        </pui-tooltip>
      </view>
      <pui-button-group size="small" aria-label="Tooltip 实例方法">
        <pui-button variant="outline" icon="add" bind:click="showTooltip">show()</pui-button>
        <pui-button variant="outline" icon="close" bind:click="hideTooltip">hide()</pui-button>
        <pui-button variant="outline" icon="refresh" bind:click="toggleTooltip">toggle()</pui-button>
      </pui-button-group>
      <pui-cell title="Tooltip 状态" description="duration=0 保持显示；点击内容按策略关闭。" value="{{tooltipResult}}" />
    </pui-card>

    <pui-card title="ActionSheet 受控动作面板" description="列表或宫格动作只表达选择和关闭请求；页面决定后续业务。" custom-class="section-card">
      <pui-button-group size="small" aria-label="ActionSheet 显隐控制">
        <pui-button theme="primary" icon="list" bind:click="openActionSheet">选择操作</pui-button>
        <pui-button variant="outline" icon="close" bind:click="closeActionSheet">关闭面板</pui-button>
      </pui-button-group>
      <pui-cell title="ActionSheet 事件" description="selected → close → visible-change 的关闭顺序由组件真实触发。" value="{{actionSheetResult}}" />
    </pui-card>

    <pui-card title="DropdownMenu 页面筛选" description="一个 items 数组承载单选或多选筛选项；页面收到事件后真实回写 value。" custom-class="section-card">
      <pui-cell title="DropdownMenu 事件" description="单选为 change → close；多选通过确认关闭，禁用项不会触发选择。" value="{{dropdownResult}}" />
    </pui-card>

    <pui-card title="Overlay 受控遮罩" description="页面持有 visible；点击遮罩或默认 Slot 内容后，由 click 请求父级回写关闭。" custom-class="section-card">
      <pui-button theme="primary" icon="layers" bind:click="openOverlay">显示遮罩</pui-button>
      <pui-cell title="受控回写" description="Overlay 只发出 click({ visible: false })，不自行改写页面状态。" value="click → visible=false" />
    </pui-card>

    <pui-card title="PullRefresh 内部滚动下拉刷新" description="组件自身承载 scroll-view；下拉只请求刷新，父级通过 value 回写结束，不伪造业务成功。" custom-class="section-card">
      <pui-pull-refresh
        id="deliveryPullRefresh"
        custom-class="pull-refresh-example-viewport"
        value="{{pullRefreshValue}}"
        disabled="{{pullRefreshDisabled}}"
        loading-bar-height="50"
        max-bar-height="80"
        loading-texts="{{pullRefreshTexts}}"
        refresh-timeout="3000"
        aria-label="组件交付下拉刷新区域"
        bind:dragstart="onPullRefreshDragStart"
        bind:dragging="onPullRefreshDragging"
        bind:dragend="onPullRefreshDragEnd"
        bind:change="onPullRefreshChange"
        bind:refresh="onPullRefreshRequest"
        bind:timeout="onPullRefreshTimeout"
      >
        <pui-cell slot="header" title="header Slot" description="刷新提示之后的补充内容" value="header" left-icon="layers" />
        <pui-cell title="组件源码" description="WXML / WXSS / JS / JSON" value="ready" left-icon="component" />
        <pui-cell title="滚动门禁" description="仅内部滚动区顶部接管向下主轴手势" value="top" left-icon="list" />
        <pui-cell title="受控状态" description="change 由页面真实回写 value" value="{{pullRefreshValue ? 'refreshing' : 'idle'}}" left-icon="refresh" />
        <pui-cell title="发布产物" description="npm + miniprogram_dist + build-npm" value="pending" left-icon="shield-check" />
        <pui-cell title="低动效" description="正常回弹 180ms，reduceMotion 压缩至 1ms" value="ready" left-icon="spark" />
      </pui-pull-refresh>
      <pui-button-group size="small" aria-label="PullRefresh 父级回写与状态控制">
        <pui-button variant="outline" icon="check-circle" bind:click="completePullRefresh">父级回写 value=false</pui-button>
        <pui-button variant="outline" icon="lock" bind:click="togglePullRefreshDisabled">disabled: {{pullRefreshDisabled}}</pui-button>
      </pui-button-group>
      <pui-cell title="PullRefresh 状态" description="事件来自组件内部滚动与真实触摸；业务结果由父级数据流处理。" value="{{pullRefreshStatus}}" />
    </pui-card>

    <pui-card title="VirtualList 固定行高窗口化列表" description="120 条数据只渲染 visible + overscan；受控选择、状态、泛型 item、滚动事件和实例定位均走真实合同。" custom-class="section-card">
      <pui-virtual-list
        id="deliveryVirtualList"
        generic:virtual-item="virtual-list-item"
        items="{{virtualListItems}}"
        value="{{virtualListValue}}"
        default-value="{{0}}"
        multiple="{{virtualListMultiple}}"
        selectable
        item-key="value"
        height="520"
        item-height="96"
        overscan="3"
        scroll-with-animation
        upper-threshold="40"
        lower-threshold="40"
        show-scrollbar
        bordered
        show-index
        show-description
        show-value
        show-item-icon
        show-item-badge
        active-icon="check"
        custom-header
        custom-footer
        custom-empty
        custom-item
        loading="{{virtualListLoading}}"
        error="{{virtualListError}}"
        loading-text="交付记录加载中"
        error-text="交付记录加载失败"
        retry-text="重新加载"
        empty-text="暂无交付记录"
        aria-label="组件交付虚拟列表"
        duration="180"
        easing="standard"
        bind:item-click="onVirtualListItemClick"
        bind:input="onVirtualListInput"
        bind:change="onVirtualListChange"
        bind:selection-change="onVirtualListSelectionChange"
        bind:scroll="onVirtualListScroll"
        bind:scrolltoupper="onVirtualListUpper"
        bind:scrolltolower="onVirtualListLower"
        bind:reach-start="onVirtualListUpper"
        bind:reach-end="onVirtualListLower"
        bind:scroll-to="onVirtualListScrollTo"
        bind:retry="onVirtualListRetry"
        bind:reset="onVirtualListReset"
      >
        <view slot="header" class="virtual-list-example-header"><pui-icon name="component" size="30" /><text>组件交付记录</text><pui-tag theme="primary" variant="outline">{{virtualListItems.length}} items</pui-tag></view>
        <view slot="empty" class="virtual-list-example-empty"><pui-icon name="inbox" size="48" /><text>暂无交付记录</text><pui-tag theme="default" variant="outline">empty slot</pui-tag></view>
        <view slot="footer" class="virtual-list-example-footer"><pui-button size="small" variant="outline" icon="undo" bind:click="resetVirtualListSelection">reset()</pui-button><pui-button size="small" variant="outline" icon="close" bind:click="clearVirtualListSelection">clearSelection()</pui-button></view>
      </pui-virtual-list>
      <pui-button-group size="small" aria-label="VirtualList 实例方法与状态控制">
        <pui-button theme="primary" icon="arrow-up" bind:click="scrollVirtualListTop">scrollToTop()</pui-button>
        <pui-button variant="outline" icon="navigation-pointer" bind:click="scrollVirtualListCenter">scrollToIndex(64)</pui-button>
        <pui-button variant="outline" icon="focus" bind:click="scrollVirtualListFirstKey">scrollToKey(0)</pui-button>
        <pui-button variant="outline" icon="list" bind:click="toggleVirtualListMultiple">multiple: {{virtualListMultiple}}</pui-button>
        <pui-button variant="outline" icon="loading-ring" bind:click="toggleVirtualListLoading">loading: {{virtualListLoading}}</pui-button>
        <pui-button variant="outline" icon="error-circle" bind:click="toggleVirtualListError">error: {{virtualListError}}</pui-button>
        <pui-button variant="outline" icon="inbox" bind:click="toggleVirtualListEmpty">{{virtualListItems.length ? '显示 empty' : '恢复 items'}}</pui-button>
      </pui-button-group>
      <pui-cell title="VirtualList 状态" description="error > loading > content > empty；retry 不伪造恢复。" value="{{virtualListStatus}}" />
    </pui-card>

    <pui-card title="Sticky 页面吸顶" description="默认 slot 会随页面滚动保持在顶部；fixed 后保留占位高度。" custom-class="section-card">
      <view class="sticky-example-boundary">
        <pui-sticky
          offset-top="0"
          z-index="1000"
        >
          <pui-cell title="默认 slot" description="Sticky + Cell" value="ready" left-icon="component" bordered="{{false}}" />
        </pui-sticky>
        <pui-cell wx:for="{{stickyRows}}" wx:key="value" title="{{item.title}}" description="{{item.description}}" value="{{item.value}}" left-icon="list" />
      </view>
    </pui-card>

    <pui-card title="Watermark 内容水印" description="根据真实容器尺寸绘制图文水印；水印层不拦截默认 slot 的交互。" custom-class="section-card">
      <pui-watermark
        custom-class="watermark-example"
        content="内部资料"
        alpha="0.16"
        width="240"
        height="160"
        x="24"
        y="24"
        layout="rectangular"
        watermark-content="{{watermarkContent}}"
        z-index="1"
        aria-label="PoemUI 组件交付水印"
        reduce-motion="{{false}}"
      >
        <view class="watermark-example-content">
          <pui-cell title="受保护内容" description="Watermark + Cell；水印层不会截获内容操作。" value="内部" left-icon="shield-check" bordered="{{false}}" />
        </view>
      </pui-watermark>
    </pui-card>

    <pui-card title="Sheet 受控底部面板" description="真实下拉关闭、独立正文滚动、状态优先级和 footer slot；页面负责受控 visible 回写。" custom-class="section-card">
      <pui-button-group size="small" aria-label="Sheet 显隐与状态控制">
        <pui-button theme="primary" icon="add" bind:click="openSheet">open()</pui-button>
        <pui-button variant="outline" icon="close" bind:click="closeSheet">close()</pui-button>
        <pui-button variant="outline" icon="loading-ring" bind:click="toggleSheetLoading">{{sheetLoading ? '关闭 Loading' : '显示 Loading'}}</pui-button>
        <pui-button variant="outline" icon="error-circle" bind:click="toggleSheetError">{{sheetError ? '清除 Error' : '显示 Error'}}</pui-button>
        <pui-button variant="outline" icon="inbox" bind:click="toggleSheetEmpty">{{sheetEmpty ? '清除 Empty' : '显示 Empty'}}</pui-button>
      </pui-button-group>
      <pui-cell title="Sheet 状态" description="error > loading > empty > content；实例方法在 disabled 下仍可调用。" value="{{sheetResult}}" />
    </pui-card>
  </view>

  <pui-popup
    id="deliveryPopup"
    visible="{{popupVisible}}"
    placement="bottom"
    show-handle
    draggable
    close-btn
    aria-label="组件配置弹出层"
    duration="240"
    bind:visible-change="onPopupVisibleChange"
  >
    <pui-cell title="组件名称" description="Popup 默认 slot 可组合 Cell、Tag、Form 等 PUI 组件。" value="{{name || '未命名'}}" left-icon="component" />
    <pui-tag theme="primary" variant="outline">{{notification ? '通知已开启' : '通知已关闭'}}</pui-tag>
  </pui-popup>

  <pui-action-sheet
    id="deliveryActionSheet"
    visible="{{actionSheetVisible}}"
    description="选择动作后由页面处理真实业务。"
    items="{{actionSheetItems}}"
    aria-label="组件操作动作面板"
    bind:visible-change="onActionSheetVisibleChange"
    bind:close="onActionSheetClose"
    bind:selected="onActionSheetSelected"
    bind:cancel="onActionSheetCancel"
  />

  <pui-dropdown-menu
    items="{{dropdownItems}}"
    value="{{dropdownValue}}"
    default-value="{{dropdownDefaultValue}}"
    show-overlay
    close-on-click-overlay
    aria-label="组件筛选菜单"
    bind:change="onDropdownChange"
    bind:open="onDropdownOpen"
    bind:close="onDropdownClose"
    bind:confirm="onDropdownConfirm"
    bind:reset="onDropdownReset"
  >
    <view class="dropdown-example-content">
      <pui-cell title="补充内容" description="默认 Slot 由页面组合，不会被转成筛选结果。" value="default Slot" left-icon="component" />
      <pui-button size="small" variant="outline" icon="check" bind:click="onDropdownContent">页面回调</pui-button>
    </view>
    <view slot="footer" class="dropdown-example-footer">
      <pui-button size="small" theme="primary" icon="check" bind:click="applyDropdown">页面操作</pui-button>
    </view>
  </pui-dropdown-menu>

  <pui-overlay
    visible="{{overlayVisible}}"
    blur
    prevent-scroll-through
    z-index="11000"
    aria-label="组件交付遮罩层"
    bind:click="onOverlayClick"
  >
    <view class="overlay-example-slot">
      <pui-cell title="页面正在聚焦" description="这是 Overlay 的默认 Slot；点击这里同样会让遮罩根发出关闭请求。" left-icon="layers" />
    </view>
  </pui-overlay>

  <pui-sheet
    id="deliverySheet"
    visible="{{sheetVisible}}"
    title="组件交付操作"
    description="向下拖动把手或点击关闭入口。"
    show-footer
    draggable
    height="360"
    loading="{{sheetLoading}}"
    loading-text="Sheet 内容加载中"
    error="{{sheetError}}"
    error-text="Sheet 内容加载失败"
    retry-text="重新请求"
    empty="{{sheetEmpty}}"
    empty-text="暂无交付动作"
    aria-label="组件交付底部面板"
    duration="180"
    bind:input="onSheetInput"
    bind:change="onSheetChange"
    bind:open="onSheetOpen"
    bind:close="onSheetClose"
    bind:overlay-click="onSheetOverlayClick"
    bind:retry="onSheetRetry"
    bind:drag-start="onSheetDragStart"
    bind:drag-end="onSheetDragEnd"
    bind:scroll="onSheetScroll"
    bind:after-open="onSheetAfterOpen"
    bind:after-close="onSheetAfterClose"
  >
    <view class="sheet-example-content">
      <pui-cell title="组件源码" description="WXML / WXSS / JS / JSON" value="ready" left-icon="component" />
      <pui-cell title="发布门禁" description="check + pack:check + build-npm" value="pending" left-icon="check-circle" />
      <pui-tag theme="primary" variant="outline">Sheet + Cell + Tag</pui-tag>
    </view>
    <view slot="footer" class="sheet-example-footer">
      <pui-button size="small" variant="outline" bind:click="closeSheet">稍后</pui-button>
      <pui-button size="small" theme="primary" bind:click="onSheetFooterPrimary">继续</pui-button>
    </view>
  </pui-sheet>

  <pui-dialog
    id="deliveryDialog"
    visible="{{dialogVisible}}"
    title="确认发布组件？"
    content="确认只发出业务事件；关闭由页面在 close 中回写 visible。"
    cancel-btn="取消"
    confirm-btn="{{dialogConfirmBtn}}"
    close-btn
    close-on-overlay-click
    aria-label="组件发布确认对话框"
    bind:confirm="onDialogConfirm"
    bind:cancel="onDialogCancel"
    bind:close="onDialogClose"
    bind:overlay-click="onDialogOverlayClick"
  />

  <pui-toast id="delivery-toast" bind:close="onToastClose">
    <pui-tag slot="message" theme="primary" variant="outline">Toast + Tag slot</pui-tag>
  </pui-toast>
  <pui-dynamic-message id="delivery-dynamic-message" bind:close="onDynamicMessageClose" />
</pui-config-provider>
