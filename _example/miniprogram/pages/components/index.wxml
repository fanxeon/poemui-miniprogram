<pui-config-provider use-global-config bind:themechange="onGlobalThemeChange">
  <view class="page pui-bg-gradient-flowing-gold-pink">
    <pui-alert visible="{{alertVisible}}" title="原生 Alert 状态机" description="关闭会先请求父级回写，再保留退场帧。" theme="info" closable duration="180" bind:input="onAlertInput" bind:change="onAlertChange" bind:close="onAlertClose">
      <pui-tag theme="primary" variant="outline">Alert + Tag slot</pui-tag>
    </pui-alert>
    <view class="alert-control">
      <pui-button size="small" variant="outline" bind:click="openAlert">重新打开 Alert</pui-button>
      <pui-cell title="Alert 状态" value="{{alertStatus}}" />
    </view>
    <pui-card title="Color npm 主题 Token" description="直接消费 theme.wxss 的品牌、语义、文本、背景和边框变量；不是静态 pui-color 组件。" custom-class="section-card">
      <view class="color-token-example__primary">
        <pui-icon name="palette" size="36" />
        <view><text>Brand action</text><text>--pui-color-brand / --pui-text-inverse</text></view>
      </view>
      <view class="color-token-example__semantic">
        <view class="color-token-example__state color-token-example__state--success"><pui-tag theme="success" variant="outline">Success</pui-tag><text>构建通过</text></view>
        <view class="color-token-example__state color-token-example__state--warning"><pui-tag theme="warning" variant="outline">Warning</pui-tag><text>等待复核</text></view>
        <view class="color-token-example__state color-token-example__state--danger"><pui-tag theme="danger" variant="outline">Danger</pui-tag><text>发布阻塞</text></view>
        <view class="color-token-example__state color-token-example__state--info"><pui-tag theme="primary" variant="outline">Info</pui-tag><text>版本说明</text></view>
      </view>
      <pui-cell title="主题切换" description="ConfigProvider light/dark/auto 改变真实 WXSS Token；视觉开关不改写色值。" value="{{theme}}" left-icon="palette" />
    </pui-card>
    <pui-card title="Typography npm 字体角色" description="直接消费 utilities.wxss 的角色、字重、颜色和溢出类；不是静态 pui-typography 组件。" custom-class="section-card">
      <view class="typography-token-example">
        <view class="pui-text-headline pui-text-primary">原生组件，真实交付</view>
        <view class="pui-text-body-md pui-text-secondary">正文使用固定角色 Token，承载产品信息和操作结果。</view>
        <view class="typography-token-example__status">
          <text class="pui-text-label">构建状态</text>
          <pui-tag theme="success" variant="outline">passed</pui-tag>
        </view>
        <view class="pui-text-caption pui-text-secondary pui-text-truncate">这是一段会在明确宽度内真实单行省略的组件兼容说明。</view>
        <view class="pui-font-mono pui-text-body-sm pui-tabular-nums">98.6% · 12:48:36 · 1,280</view>
      </view>
      <pui-cell title="字体入口" description="旧 small/medium/large 继续映射到 body 角色。" value="10 roles" left-icon="text" />
    </pui-card>
    <pui-card title="Spacing npm 间距节奏" description="直接消费 utilities.wxss 的 padding、gap 和 margin 类；不是静态 pui-spacing 组件。" custom-class="section-card">
      <view class="spacing-token-example pui-p-lg">
        <view class="pui-text-title-sm pui-text-primary">组件交付节奏</view>
        <view class="pui-flex pui-items-center pui-flex-wrap pui-gap-sm">
          <pui-tag variant="outline">源码</pui-tag>
          <pui-tag variant="outline">预览</pui-tag>
          <pui-tag theme="success" variant="outline">npm</pui-tag>
        </view>
        <pui-cell-group title="构建结果" description="CellGroup 统一标题、间距与可选卡片 Surface" card>
          <pui-cell title="站点构建" value="passed" />
          <pui-cell title="微信构建" value="passed" />
        </pui-cell-group>
      </view>
      <pui-cell title="间距入口" description="normal 使用无后缀；不提供负间距工具类。" value="8 scales" left-icon="grid" />
    </pui-card>
    <pui-card title="Style Utilities utility-first 布局" description="直接消费 npm WXSS 的 grid、position、sizing、surface 和 safe-area 工具类；不是静态 pui-style 组件。" custom-class="section-card">
      <view class="pui-grid-layout pui-grid-cols-3 pui-gap-sm pui-p-lg pui-bg-page pui-dark-bg-muted pui-border pui-border-solid pui-dark-border pui-radius-lg">
        <view class="pui-col-span-2 pui-min-w-0">
          <pui-cell title="源码与预览" description="minmax(0, 1fr) 在窄屏安全收缩" value="ready" left-icon="code" />
        </view>
        <view class="pui-flex pui-items-center pui-justify-center pui-min-w-0">
          <pui-tag theme="success" variant="outline">npm</pui-tag>
        </view>
        <view class="pui-col-span-full pui-flex pui-flex-wrap pui-items-center pui-gap-x-sm pui-gap-y-xs pui-pt-sm pui-border-t">
          <pui-tag variant="outline">Grid 1–6</pui-tag>
          <pui-tag variant="outline">Dark 32</pui-tag>
          <pui-tag variant="outline">Safe area</pui-tag>
          <pui-tag variant="outline">Reduce motion</pui-tag>
        </view>
      </view>
      <view class="pui-relative pui-mt-sm pui-p-lg pui-bg-container pui-border pui-border-solid pui-radius-md">
        <view class="pui-absolute pui-top-0 pui-right-0 pui-px-xs pui-py-xxs pui-bg-brand pui-text-inverse pui-radius-full pui-z-10">NEW</view>
        <view class="pui-text-title-sm pui-text-primary">真实 WXSS 组合</view>
        <view class="pui-text-body-sm pui-text-secondary pui-dark-text-success pui-mt-xs">562 selectors · 32 curated colors · 32 dark variants · 9 Background Gradients</view>
        <view class="pui-bg-blue-soft pui-border pui-border-solid pui-border-blue pui-radius-sm pui-p-sm pui-mt-sm">
          <text class="pui-text-blue pui-font-semibold">Blue utility</text>
          <text class="pui-text-secondary pui-ml-xs">主题感知柔和背景</text>
        </view>
      </view>
      <pui-cell title="样式入口" description="@import theme/utilities.wxss" value="11 groups" left-icon="layers" />
    </pui-card>
    <pui-card title="AspectRatio 原生比例与组合" description="百分比占位会在比例更新时平滑变化，内容由真实 slot 铺满。" custom-class="section-card">
      <pui-aspect-ratio bordered>
        <view class="aspect-slot">
          <pui-icon name="image" size="56" />
          <pui-tag theme="primary" variant="outline">AspectRatio + Icon + Tag</pui-tag>
        </view>
      </pui-aspect-ratio>
    </pui-card>
    <view class="divider-demo">
      <pui-divider />
      <pui-divider content="组件状态" align="left" />
      <pui-divider show-content dashed>
        <pui-tag theme="primary" variant="outline">自定义内容</pui-tag>
      </pui-divider>
      <view class="badge-example">
        <view class="badge-row">
          <pui-badge count="128" max-count="99" aria-label="99 条以上未读消息">
            <pui-icon name="bell" size="44" />
          </pui-badge>
          <pui-badge count="{{null}}" theme="success" variant="light" aria-label="Pro 构建状态">
            <view slot="count" class="badge-content-slot"><pui-icon name="spark" size="20" /><text>Pro</text></view>
          </pui-badge>
          <pui-badge dot content="消息" aria-label="有新消息" />
        </view>
      </view>
      <pui-cell title="发布状态" value="ready" />
    </view>
    <pui-card title="Bubble 消息表面与受控展开" description="Bubble 只负责正文、分组、回应与长文折叠；头像、时间、会话和发送状态由上层组合。" custom-class="section-card">
      <view class="bubble-example-thread">
        <pui-bubble content="先核对原生 WXML、WXSS、JS 和 JSON。" variant="secondary" group-position="first" />
        <pui-bubble content="再检查 H5、API 文档与 npm 产物。" variant="muted" group-position="last" />
        <pui-bubble content="验收通过后进入下一个组件。" align="end" />
      </view>
      <pui-bubble
        id="delivery-bubble"
        content="当前 Bubble 只负责消息表面，不伪造发送、已读或 AI 生成状态。长正文通过隐藏测量节点获得完整高度，父级回写 expanded 后再真实展开或收起。"
        variant="secondary"
        reactions="{{bubbleReactions}}"
        collapsible
        expanded="{{bubbleExpanded}}"
        max-lines="3"
        visible="{{bubbleVisible}}"
        clickable
        aria-label="组件交付状态消息"
        aria-live="polite"
        duration="180"
        bind:click="onBubbleClick"
        bind:longpress="onBubbleLongpress"
        bind:reaction="onBubbleReaction"
        bind:input="onBubbleExpandedInput"
        bind:change="onBubbleExpandedChange"
        bind:expand="onBubbleExpand"
        bind:collapse="onBubbleCollapse"
        bind:show="onBubbleShow"
        bind:hide="onBubbleHide"
        bind:after-show="onBubbleAfterShow"
        bind:after-hide="onBubbleAfterHide"
      />
      <view class="bubble-example-actions">
        <pui-button size="small" variant="outline" block bind:click="toggleBubbleExpandedWithMethod">toggle()</pui-button>
        <pui-button size="small" variant="outline" block bind:click="toggleBubbleVisible">{{bubbleVisible ? '隐藏 Bubble' : '显示 Bubble'}}</pui-button>
      </view>
      <pui-cell title="Bubble 状态" description="回应只回传，不修改计数或 active。" value="{{bubbleStatus}}" />
    </pui-card>
    <pui-card title="Button 原生能力与组合" description="根节点是真实微信 button；loading/disabled 会阻断 click、form-type 和 open-type。" custom-class="section-card">
      <form bindsubmit="onDeliveryButtonSubmit">
        <pui-button
          theme="primary"
          block
          icon="check"
          form-type="submit"
          loading="{{deliveryButtonLoading}}"
          disabled="{{deliveryButtonDisabled}}"
          aria-label="提交 Button 交付检查"
          bind:click="onDeliveryButtonClick"
        >
          <text>提交交付检查</text>
          <pui-tag slot="suffix" theme="success" variant="outline">ready</pui-tag>
        </pui-button>
      </form>
      <view class="button-example-actions">
        <pui-button size="small" variant="ghost" icon="loading-ring" bind:click="toggleDeliveryButtonLoading">{{deliveryButtonLoading ? '停止加载' : '加载态'}}</pui-button>
        <pui-button size="small" variant="outline" icon="lock" bind:click="toggleDeliveryButtonDisabled">{{deliveryButtonDisabled ? '启用' : '禁用'}}</pui-button>
        <pui-button size="small" variant="text" open-type="contact" icon="message" bind:click="onDeliveryButtonClick" bind:contact="onDeliveryButtonContact" bind:error="onDeliveryButtonError">联系平台客服</pui-button>
      </view>
      <pui-cell title="Button 状态" description="contact/error 只展示微信真实回调，不伪造平台成功。" value="{{deliveryButtonStatus}}" />
    </pui-card>
    <pui-card title="Checkbox 与 CheckboxGroup" description="Group 真实管理原始数组值、全选半选和禁用已选保留；单项 checked 由页面回写。" custom-class="section-card">
      <pui-checkbox-group
        options="{{deliveryCheckboxOptions}}"
        value="{{deliveryCheckboxValue}}"
        max="3"
        name="release-checks"
        aria-label="组件交付检查"
        bind:change="onDeliveryCheckboxGroupChange"
      />
      <pui-checkbox
        id="deliveryCheckbox"
        checked="{{deliveryCheckboxChecked}}"
        indeterminate="{{deliveryCheckboxIndeterminate}}"
        value="release-terms"
        label="同意组件发布规范"
        content="提交前运行站点、组件和 npm 产物检查。"
        name="release-terms"
        block
        aria-label="同意组件发布规范"
        bind:change="onDeliveryCheckboxChange"
      >
        <pui-tag theme="primary" variant="outline">Checkbox + Tag</pui-tag>
      </pui-checkbox>
      <pui-checkbox
        value="slot-copy"
        label="Slot 组合"
        content="具名 Slot 不需要 custom* 开关"
        icon="line"
        placement="right"
        block
        content-disabled
        bind:change="onDeliveryCheckboxChange"
      >
        <view slot="label" class="checkbox-example__content"><text>PoemUI 组合标签</text><pui-tag theme="success" variant="outline">label slot</pui-tag></view>
      </pui-checkbox>
      <pui-cell title="Checkbox 状态" description="0、false 和空字符串保持严格身份；max/disabled/readonly 阻断不伪造 change。" value="{{deliveryCheckboxStatus}}" />
    </pui-card>
    <pui-card title="Collapsible 单区展开与组合" description="open 由页面真实回写；内容高度由 selector query 测量，节点在收起时保留以完成过渡。" custom-class="section-card">
      <pui-collapsible
        id="deliveryCollapsible"
        open="{{deliveryCollapsibleOpen}}"
        custom-trigger
        custom-content
        theme="primary"
        loading="{{deliveryCollapsibleLoading}}"
        error="{{deliveryCollapsibleError}}"
        readonly="{{deliveryCollapsibleReadonly}}"
        aria-label="发布设置"
        duration="180"
        bind:click="onDeliveryCollapsibleClick"
        bind:input="onDeliveryCollapsibleInput"
        bind:change="onDeliveryCollapsibleChange"
        bind:open="onDeliveryCollapsibleOpen"
        bind:close="onDeliveryCollapsibleClose"
        bind:after-open="onDeliveryCollapsibleAfterOpen"
        bind:after-close="onDeliveryCollapsibleAfterClose"
        bind:retry="onDeliveryCollapsibleRetry"
      >
        <view slot="trigger" class="collapsible-example__trigger">
          <pui-icon name="command" size="28" />
          <text>发布设置</text>
          <pui-tag theme="primary" variant="outline">trigger slot</pui-tag>
        </view>
        <view class="collapsible-example__content">
          <pui-cell title="视觉策略" description="阴影、毛玻璃和圆角由 ConfigProvider 统一控制" value="ready" left-icon="palette" bordered="{{false}}" />
          <view class="collapsible-example__content-actions">
            <pui-tag theme="success" variant="outline">default slot</pui-tag>
            <pui-button size="small" variant="outline" icon="check-circle" bind:click="onDeliveryCollapsibleContentAction">检查设置</pui-button>
          </view>
        </view>
      </pui-collapsible>
      <pui-button-group size="small" aria-label="Collapsible 实例方法" custom-class="collapsible-example__actions">
        <pui-button variant="outline" bind:click="openDeliveryCollapsible">open</pui-button>
        <pui-button variant="outline" bind:click="closeDeliveryCollapsible">close</pui-button>
        <pui-button variant="text" bind:click="toggleDeliveryCollapsible">toggle</pui-button>
        <pui-button variant="text" bind:click="measureDeliveryCollapsible">measure</pui-button>
      </pui-button-group>
      <pui-button-group size="small" aria-label="Collapsible 状态" custom-class="collapsible-example__actions">
        <pui-button variant="text" icon="loading-ring" bind:click="toggleDeliveryCollapsibleLoading">{{deliveryCollapsibleLoading ? '停止加载' : '加载态'}}</pui-button>
        <pui-button variant="text" icon="error-circle" bind:click="toggleDeliveryCollapsibleError">{{deliveryCollapsibleError ? '清除错误' : '错误态'}}</pui-button>
        <pui-button variant="text" icon="lock" bind:click="toggleDeliveryCollapsibleReadonly">{{deliveryCollapsibleReadonly ? '取消只读' : '只读态'}}</pui-button>
      </pui-button-group>
      <pui-cell title="Collapsible 状态" description="error > loading > content > empty；retry 只发请求，不伪造恢复。" value="{{deliveryCollapsibleStatus}}" />
    </pui-card>
    <pui-card title="Combobox 搜索、选择与组合" description="value、query、visible 由页面分别真实回写；分组、创建、多选上限和状态分支共用同一份原生合同。" custom-class="section-card">
      <pui-combobox
        id="deliveryCombobox"
        options="{{deliveryComboboxOptions}}"
        value="{{deliveryComboboxValue}}"
        default-value="next"
        query="{{deliveryComboboxQuery}}"
        visible="{{deliveryComboboxVisible}}"
        multiple="{{deliveryComboboxMultiple}}"
        max-selected="2"
        allow-create
        custom-footer
        loading="{{deliveryComboboxLoading}}"
        error="{{deliveryComboboxError}}"
        placeholder="选择框架"
        search-placeholder="搜索框架或关键词"
        aria-label="框架组合框"
        duration="180"
        bind:query-input="onDeliveryComboboxQueryInput"
        bind:query-change="onDeliveryComboboxQueryChange"
        bind:visible-input="onDeliveryComboboxVisibleInput"
        bind:visible-change="onDeliveryComboboxVisibleChange"
        bind:input="onDeliveryComboboxInput"
        bind:change="onDeliveryComboboxChange"
        bind:select="onDeliveryComboboxSelect"
        bind:remove="onDeliveryComboboxRemove"
        bind:clear="onDeliveryComboboxClear"
        bind:create="onDeliveryComboboxCreate"
        bind:exceed="onDeliveryComboboxExceed"
        bind:open="onDeliveryComboboxOpen"
        bind:close="onDeliveryComboboxClose"
        bind:after-open="onDeliveryComboboxAfterOpen"
        bind:after-close="onDeliveryComboboxAfterClose"
        bind:reset="onDeliveryComboboxReset"
        bind:retry="onDeliveryComboboxRetry"
      >
        <view slot="footer" class="combobox-example__footer">
          <pui-tag variant="outline">Combobox + Tag</pui-tag>
          <pui-button size="small" theme="primary" icon="check" bind:click="onDeliveryComboboxFooter">应用选择</pui-button>
        </view>
      </pui-combobox>
      <pui-button-group size="small" aria-label="Combobox 实例方法" custom-class="combobox-example__actions">
        <pui-button variant="outline" bind:click="openDeliveryCombobox">open</pui-button>
        <pui-button variant="outline" bind:click="closeDeliveryCombobox">close</pui-button>
        <pui-button variant="text" bind:click="clearDeliveryCombobox">clear</pui-button>
        <pui-button variant="text" bind:click="resetDeliveryCombobox">reset</pui-button>
      </pui-button-group>
      <pui-button-group size="small" aria-label="Combobox 选择与焦点方法" custom-class="combobox-example__actions">
        <pui-button variant="outline" bind:click="focusDeliveryCombobox">focus</pui-button>
        <pui-button variant="outline" bind:click="selectNextDeliveryCombobox">select next</pui-button>
        <pui-button variant="text" icon="layers" bind:click="toggleDeliveryComboboxMultiple">{{deliveryComboboxMultiple ? '单选' : '多选'}}</pui-button>
      </pui-button-group>
      <pui-button-group size="small" aria-label="Combobox 状态" custom-class="combobox-example__actions">
        <pui-button variant="text" icon="loading-ring" bind:click="toggleDeliveryComboboxLoading">{{deliveryComboboxLoading ? '停止加载' : '加载态'}}</pui-button>
        <pui-button variant="text" icon="error-circle" bind:click="toggleDeliveryComboboxError">{{deliveryComboboxError ? '清除错误' : '错误态'}}</pui-button>
      </pui-button-group>
      <pui-cell title="Combobox 状态" description="error > loading > content > empty；retry 与 footer 均不伪造业务成功。" value="{{deliveryComboboxStatus}}" />
    </pui-card>
    <pui-card title="ButtonGroup 子按钮事件" description="组级 disabled 由遮罩阻断；点击仍由每个 pui-button 独立回传。" custom-class="section-card">
      <pui-button-group size="small" aria-label="编辑操作">
        <pui-button theme="default" variant="outline" icon="chevron-left" data-action="上一步" bind:click="onButtonGroupAction">上一步</pui-button>
        <pui-button theme="primary" icon="copy" data-action="复制" bind:click="onButtonGroupAction">复制</pui-button>
        <pui-button theme="default" variant="outline" icon="command" data-action="更多" bind:click="onButtonGroupAction">更多</pui-button>
      </pui-button-group>
      <pui-cell title="ButtonGroup 状态" value="{{buttonGroupStatus}}" />
    </pui-card>
    <pui-card title="Avatar 图片、回退与 slot" description="无图片时按 slot、Icon、text/alt 回退；头像本体只展示，操作由外层组件承担。" custom-class="section-card">
      <view class="avatar-example-row">
        <pui-avatar text="PoemUI" size="large" bordered aria-label="PoemUI 文本头像" />
        <pui-avatar icon="profile" size="medium" shape="round" aria-label="个人图标头像" />
        <pui-avatar use-slot size="medium" shape="square" aria-label="星光图标头像">
          <pui-icon name="spark" size="36" />
        </pui-avatar>
        <pui-avatar src="/__poemui__/missing-avatar.png" text="F" aria-label="失败回退头像" bind:error="onAvatarError" />
      </view>
      <pui-tag theme="primary" variant="outline">Avatar + Icon slot</pui-tag>
      <pui-cell title="Avatar 状态" value="{{avatarStatus}}" />
    </pui-card>
    <pui-card title="Image 资源状态与覆盖 slot" description="空 src 显示 empty；缺失资源由原生 image 触发 error。Image 本体只展示，操作应由外层组件承担。" custom-class="section-card">
      <pui-image width="100%" height="220rpx" text="暂无封面" show-slot aria-label="组件封面">
        <pui-tag theme="primary" variant="outline">Image + Tag slot</pui-tag>
      </pui-image>
      <pui-image src="/__poemui__/missing-image.png" width="100%" height="160rpx" text="图片加载失败" aria-label="失败图片" bind:error="onImageError" />
      <pui-cell title="Image 状态" value="{{imageStatus}}" />
    </pui-card>
    <pui-card title="Grid 入口与真实重试" description="点击只发入口事件；错误态重试由页面接管，Grid 不伪造请求成功。" custom-class="section-card">
      <pui-grid items="{{gridItems}}" column="3" gutter="12" error="{{gridError}}" loading="{{gridLoading}}" aria-label="示例功能入口" bind:click="onGridClick" bind:retry="onGridRetry" />
      <view class="example-actions">
        <pui-button size="small" variant="outline" icon="error-circle" bind:click="showGridError">模拟请求失败</pui-button>
        <pui-button size="small" variant="outline" icon="refresh" bind:click="restoreGrid">父级恢复入口</pui-button>
      </view>
      <pui-cell title="Grid 状态" value="{{gridStatus}}" />
    </pui-card>
