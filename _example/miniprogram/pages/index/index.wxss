.page {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 32rpx;
  color: var(--pui-text-primary);
  background:
    radial-gradient(circle at 18% 4%, rgba(255, 255, 255, 0.78), transparent 34%),
    radial-gradient(circle at 90% 18%, rgba(17, 18, 23, 0.08), transparent 30%),
    var(--pui-bg-page);
}

.hero {
  padding: 32rpx 0 20rpx;
}

.hero__title {
  font-size: 48rpx;
  font-weight: 800;
  line-height: 58rpx;
}

.hero__desc {
  margin-top: 8rpx;
  color: var(--pui-text-secondary);
  font-size: 26rpx;
  line-height: 38rpx;
}

.section {
  margin-top: 28rpx;
  padding: var(--pui-panel-padding);
  background: var(--pui-glass-surface);
  border-radius: var(--pui-radius-large);
  box-shadow: var(--pui-shadow-card);
  -webkit-backdrop-filter: var(--pui-frosted-filter);
  backdrop-filter: var(--pui-frosted-filter);
}

.section__title {
  margin-bottom: 20rpx;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 42rpx;
}

.actions,
.tag-row,
.loading-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 20rpx;
}

.section pui-button + pui-button {
  margin-top: 16rpx;
}

.section pui-cell {
  display: block;
  margin-bottom: 20rpx;
}
