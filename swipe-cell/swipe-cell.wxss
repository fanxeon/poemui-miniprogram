.pui-swipe-cell {
  position: relative;
  min-width: 0;
  overflow: hidden;
  border-radius: var(--pui-radius-medium);
  isolation: isolate;
  color: var(--pui-text-primary);
}

.pui-swipe-cell__actions {
  position: absolute;
  top: 0;
  bottom: 0;
  display: flex;
  align-items: stretch;
}

.pui-swipe-cell__actions--left { left: 0; }
.pui-swipe-cell__actions--right { right: 0; }
.pui-swipe-cell__action-wrap { display: flex; flex: 0 0 auto; align-items: stretch; min-height: 100%; overflow: hidden; color: var(--pui-text-inverse); background: var(--pui-color-brand); }
.pui-swipe-cell__action-wrap--default { color: var(--pui-text-primary); background: var(--pui-bg-muted); }
.pui-swipe-cell__action-wrap--success { background: var(--pui-color-success); }
.pui-swipe-cell__action-wrap--warning { color: var(--pui-text-primary); background: var(--pui-color-warning); }
.pui-swipe-cell__action-wrap--danger { background: var(--pui-color-danger); }
.pui-swipe-cell__action-button { width: 100% !important; height: 100% !important; min-height: 100% !important; color: inherit !important; background: transparent !important; border: 0 !important; border-radius: 0 !important; box-shadow: none !important; }
.pui-swipe-cell__action-button::after { border: 0 !important; }
.pui-swipe-cell__content { position: relative; z-index: 1; display: block; width: 100%; min-width: 0; background: var(--pui-page); transform-origin: center; transition-property: transform; transition-timing-function: var(--pui-ease-standard); }
.pui-swipe-cell__content-inner { display: block; width: 100%; min-width: 0; }
.pui-swipe-cell--dragging .pui-swipe-cell__content { will-change: transform; }
.pui-swipe-cell--disabled { opacity: 0.56; }
