  --pui-chart-cell-gradient-blue: linear-gradient(145deg, #60a5fa 0%, rgba(96, 165, 250, 0.58) 100%);
  --pui-chart-cell-gradient-teal: linear-gradient(145deg, #2dd4bf 0%, rgba(45, 212, 191, 0.58) 100%);
  --pui-chart-cell-gradient-pink: linear-gradient(145deg, #f472b6 0%, rgba(244, 114, 182, 0.58) 100%);
  --pui-chart-cell-gradient-amber: linear-gradient(145deg, #fbbf24 0%, rgba(251, 191, 36, 0.58) 100%);
  --pui-chart-area-fill-start: 0.42;
  --pui-chart-area-fill-end: 0.04;
  --pui-chart-fade-outline: rgba(250, 250, 250, 0.18);
  --pui-chart-grid-line: rgba(250, 250, 250, 0.1);
  --pui-chart-track: rgba(161, 161, 170, 0.16);
  --pui-alert-default-tinted-fg: #f4f4f5;
  --pui-alert-default-tinted-secondary: #d4d4d8;
  --pui-alert-info-tinted-fg: #bfdbfe;
  --pui-alert-info-tinted-secondary: #93c5fd;
  --pui-alert-success-tinted-fg: #bbf7d0;
  --pui-alert-success-tinted-secondary: #86efac;
  --pui-alert-warning-tinted-fg: #fde68a;
  --pui-alert-warning-tinted-secondary: #fcd34d;
  --pui-alert-danger-tinted-fg: #fecaca;
  --pui-alert-danger-tinted-secondary: #fca5a5;
  --pui-text-primary: #fafafa;
  --pui-text-secondary: #d4d4d8;
  --pui-text-placeholder: #71717a;
  --pui-text-disabled: #52525b;
  --pui-text-inverse: #18181b;
  --pui-bg-page: #09090b;
  --pui-bg-container: #18181b;
  /* Rebind context-derived aliases inside the dark scope. If this alias only
     inherits from page, WeChat can keep the light root's computed #fff value. */
  --pui-scroll-area-gradient-overlay-material-color: rgba(24, 24, 27, 0.32);
  --pui-scroll-area-gradient-overlay-color-context: var(--pui-bg-container);
  --pui-bg-surface: var(--pui-bg-container);
  --pui-bg-muted: #27272a;
  --pui-bg-active: #3f3f46;
  --pui-bg-inverse: #242424;
  --pui-bg-gradient-neutral: radial-gradient(circle at 12% 6%, rgba(250, 250, 250, 0.08) 0, transparent 32%), radial-gradient(circle at 88% 92%, rgba(113, 113, 122, 0.12) 0, transparent 38%), linear-gradient(145deg, #09090b 0%, #111113 52%, #09090b 100%);
  --pui-bg-gradient-flowing-gold-pink: radial-gradient(circle at 14% 10%, rgba(246, 185, 204, 0.16) 0, transparent 34%), radial-gradient(circle at 88% 88%, rgba(229, 190, 107, 0.2) 0, transparent 40%), linear-gradient(145deg, #151014 0%, #2a1c1c 52%, #171114 100%);
  --pui-bg-gradient-premium-black: radial-gradient(circle at 12% 8%, rgba(255, 255, 255, 0.07) 0, transparent 32%), radial-gradient(circle at 90% 90%, rgba(113, 113, 122, 0.16) 0, transparent 40%), linear-gradient(145deg, #09090b 0%, #18181b 52%, #111113 100%);
  --pui-bg-gradient-cement-white: radial-gradient(circle at 16% 10%, rgba(214, 211, 209, 0.12) 0, transparent 34%), radial-gradient(circle at 88% 88%, rgba(168, 162, 158, 0.14) 0, transparent 42%), linear-gradient(145deg, #141414 0%, #292524 52%, #18181b 100%);
  --pui-bg-gradient-black-gold: radial-gradient(circle at 14% 10%, rgba(227, 193, 114, 0.18) 0, transparent 34%), radial-gradient(circle at 90% 90%, rgba(129, 93, 27, 0.18) 0, transparent 42%), linear-gradient(145deg, #09090b 0%, #211808 52%, #0f0c06 100%);
  --pui-bg-gradient-light-gold: radial-gradient(circle at 12% 8%, rgba(255, 232, 166, 0.13) 0, transparent 34%), radial-gradient(circle at 88% 90%, rgba(216, 169, 69, 0.18) 0, transparent 40%), linear-gradient(145deg, #151108 0%, #2a210f 52%, #131008 100%);
  --pui-bg-gradient-ai-mist-blue-violet: radial-gradient(circle at 12% 8%, rgba(112, 162, 255, 0.22) 0, transparent 34%), radial-gradient(circle at 88% 90%, rgba(185, 135, 255, 0.22) 0, transparent 42%), linear-gradient(145deg, #0b1020 0%, #171632 52%, #120d26 100%);
  --pui-bg-gradient-cyber-pink-blue: radial-gradient(circle at 14% 10%, rgba(255, 106, 181, 0.18) 0, transparent 34%), radial-gradient(circle at 88% 88%, rgba(77, 188, 255, 0.22) 0, transparent 40%), linear-gradient(145deg, #160c20 0%, #102440 52%, #140d24 100%);
  --pui-bg-gradient-aurora-violet: radial-gradient(circle at 10% 12%, rgba(81, 211, 184, 0.15) 0, transparent 34%), radial-gradient(circle at 90% 84%, rgba(167, 106, 255, 0.24) 0, transparent 42%), linear-gradient(145deg, #081615 0%, #171539 52%, #110c23 100%);
  --pui-text-on-inverse: #ffffff;
  --pui-border-color: #27272a;
  --pui-border: var(--pui-border-color);
  --pui-control-outline-color: #71717a;
  --pui-divider-color: #a1a1aa;
  --pui-tabbar-split-color: #3f3f46;
  --pui-glass-surface: #18181b;
  --pui-glass-surface-strong: #18181b;
  --pui-glass-tint: rgba(24, 24, 27, 0.72);
  --pui-glass-border: #27272a;
  --pui-glass-highlight: transparent;
  --pui-glass-shadow: none;
  --pui-glass-shadow-soft: none;
  --pui-shadow-brand: none;
  --pui-shadow-glow: none;
  --pui-shadow-card: none;
  --pui-shadow-floating: none;
  --pui-shadow-edge-top: none;
  --pui-shadow-edge-bottom: none;
  --pui-shadow-edge-left: none;
  --pui-shadow-edge-right: none;
  --pui-ease-standard: cubic-bezier(0.2, 0, 0, 1);
}

.pui-frosted-glass--on {
  --pui-glass-surface: rgba(255, 255, 255, 0.72);
  --pui-glass-surface-strong: rgba(255, 255, 255, 0.86);
  --pui-glass-border: rgba(255, 255, 255, 0.7);
  --pui-scroll-area-gradient-overlay-color-context: var(--pui-scroll-area-gradient-overlay-material-color);
  --pui-frosted-filter: blur(26rpx) saturate(150%);
  --pui-frosted-filter-soft: blur(18rpx) saturate(140%);
}

.pui-theme--dark.pui-frosted-glass--on {
  --pui-glass-surface: rgba(24, 24, 27, 0.72);
  --pui-glass-surface-strong: rgba(24, 24, 27, 0.88);
  --pui-glass-border: rgba(255, 255, 255, 0.13);
  --pui-scroll-area-gradient-overlay-color-context: var(--pui-scroll-area-gradient-overlay-material-color);
}

.pui-shadow--on {
  --pui-glass-shadow: 0 12rpx 32rpx rgba(24, 24, 27, 0.12);
  --pui-glass-shadow-soft: 0 6rpx 18rpx rgba(24, 24, 27, 0.08);
  --pui-shadow-brand: 0 4rpx 12rpx rgba(24, 24, 27, 0.14);
  --pui-shadow-card: var(--pui-glass-shadow);
  --pui-shadow-floating: var(--pui-glass-shadow);
  --pui-shadow-edge-top: 0 10rpx 28rpx rgba(24, 24, 27, 0.12);
  --pui-shadow-edge-bottom: 0 -10rpx 28rpx rgba(24, 24, 27, 0.12);
  --pui-shadow-edge-left: 10rpx 0 28rpx rgba(24, 24, 27, 0.12);
  --pui-shadow-edge-right: -10rpx 0 28rpx rgba(24, 24, 27, 0.12);
}

.pui-theme--dark.pui-shadow--on {
  --pui-glass-shadow: 0 12rpx 32rpx rgba(0, 0, 0, 0.32);
  --pui-glass-shadow-soft: 0 6rpx 18rpx rgba(0, 0, 0, 0.24);
  --pui-shadow-floating: var(--pui-glass-shadow);
  --pui-shadow-edge-top: 0 10rpx 28rpx rgba(0, 0, 0, 0.32);
  --pui-shadow-edge-bottom: 0 -10rpx 28rpx rgba(0, 0, 0, 0.32);
  --pui-shadow-edge-left: 10rpx 0 28rpx rgba(0, 0, 0, 0.32);
  --pui-shadow-edge-right: -10rpx 0 28rpx rgba(0, 0, 0, 0.32);
}

.pui-radius--large {
  --pui-radius-small: 18rpx;
  --pui-radius-medium: 28rpx;
  --pui-radius-large: 40rpx;
  --pui-radius-xlarge: 48rpx;
  --pui-radius-xxlarge: 56rpx;
  --pui-chart-cell-radius: 12rpx;
}

/* Keep the border box in layout; only neutral component boundary tokens become transparent.
   Divider is content hierarchy, not a removable surface boundary. */
.pui-border--off,
.pui-frosted-glass--on.pui-border--off {
  --pui-border-color: transparent;
  --pui-border: transparent;
  --pui-glass-border: transparent;
}
