.pui-aspect-ratio {
  position: relative;
  box-sizing: border-box;
  width: 100%;
  overflow: hidden;
  background: var(--pui-bg-muted);
  border-radius: var(--pui-radius-medium);
  transition-property: padding-top;
}

.pui-aspect-ratio--bordered { border: 1rpx solid var(--pui-border-color); }
.pui-aspect-ratio--radius-none { border-radius: 0; }
.pui-aspect-ratio--radius-small { border-radius: var(--pui-radius-small); }
.pui-aspect-ratio--radius-medium { border-radius: var(--pui-radius-medium); }
.pui-aspect-ratio--radius-large { border-radius: var(--pui-radius-large); }
.pui-aspect-ratio--overflow-visible { overflow: visible; }
.pui-aspect-ratio__content { position: absolute; top: 0; right: 0; bottom: 0; left: 0; box-sizing: border-box; width: 100%; height: 100%; }
