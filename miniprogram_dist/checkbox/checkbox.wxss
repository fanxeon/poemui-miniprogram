.pui-checkbox__mark{position:relative;display:flex;align-items:center;justify-content:center;box-sizing:border-box;width:var(--pui-checkbox-mark-size);height:var(--pui-checkbox-mark-size);overflow:hidden;color:var(--pui-text-inverse);background:var(--pui-bg-container);border:2rpx solid var(--pui-control-outline-color);border-radius:var(--pui-radius-round);transform:scale(1);transition:color var(--pui-checkbox-duration) var(--pui-ease-standard),background-color var(--pui-checkbox-duration) var(--pui-ease-standard),border-color var(--pui-checkbox-duration) var(--pui-ease-standard),transform var(--pui-checkbox-duration) var(--pui-ease-standard)}
