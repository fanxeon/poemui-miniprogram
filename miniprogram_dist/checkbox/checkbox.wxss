.pui-checkbox{--pui-checkbox-mark-size:36rpx;display:inline-flex;align-items:flex-start;box-sizing:border-box;gap:var(--pui-space-xs);min-width:0;max-width:100%;min-height:64rpx;padding:var(--pui-space-sm) var(--pui-space-normal);color:var(--pui-text-primary);background:var(--pui-bg-container);border:2rpx solid var(--pui-border-color);border-radius:var(--pui-radius-medium);transition:color var(--pui-checkbox-duration) var(--pui-ease-standard),background-color var(--pui-checkbox-duration) var(--pui-ease-standard),border-color var(--pui-checkbox-duration) var(--pui-ease-standard),opacity var(--pui-checkbox-duration) var(--pui-ease-standard)}
