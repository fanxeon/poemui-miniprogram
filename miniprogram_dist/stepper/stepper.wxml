<view
  class="{{rootClass}} {{customClass}}"
  style="{{customStyle}};{{rootStyle}}"
  role="group"
  aria-label="{{semanticLabel}}"
  aria-disabled="{{disabled}}"
  aria-readonly="{{readonly}}"
>
  <pui-button
    custom-class="pui-stepper__button {{atMin ? 'pui-stepper__button--limit' : ''}}"
    custom-style="position:absolute;top:0;right:0;"
    theme="default"
    variant="text"
    size="{{buttonSize}}"
    shape="square"
    icon="minus"
    disabled="{{locked}}"
    aria-label="{{minusLabel}}"
    reduce-motion="{{reduceMotion}}"
    color-scheme="{{colorScheme}}"
    bind:click="onMinus"
  />
  <pui-input
    custom-class="pui-stepper__input"
    custom-style="position:absolute;top:50%;left:{{buttonTrackSize}}rpx;width:{{normalizedInputWidth}}rpx;transform:translateY(-50%);"
    value="{{displayValue}}"
    type="{{inputType}}"
    size="{{inputSize}}"
    align="center"
    bordered="{{false}}"
    disabled="{{disabled || disableInput}}"
    readonly="{{readonly}}"
    confirm-type="done"
    aria-label="{{semanticLabel}}"
    reduce-motion="{{reduceMotion}}"
    color-scheme="{{colorScheme}}"
    bind:change="onInputChange"
    bind:enter="onEnter"
    bind:focus="onFocus"
    bind:blur="onBlur"
  />
  <pui-button
    custom-class="pui-stepper__button {{atMax ? 'pui-stepper__button--limit' : ''}}"
    custom-style="position:absolute;top:0;left:0;"
    theme="default"
    variant="text"
    size="{{buttonSize}}"
    shape="square"
    icon="add"
    disabled="{{locked}}"
    aria-label="{{plusLabel}}"
    reduce-motion="{{reduceMotion}}"
    color-scheme="{{colorScheme}}"
    bind:click="onPlus"
  />
</view>
