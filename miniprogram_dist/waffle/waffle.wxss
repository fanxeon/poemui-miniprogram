.pui-waffle{display:flex;flex-direction:column;box-sizing:border-box;width:100%;min-width:0;gap:var(--pui-content-gap);color:var(--pui-text-primary);background:transparent;border:0;box-shadow:none}.pui-waffle__plot{display:flex;flex-direction:column;gap:var(--pui-space-normal)}.pui-waffle__item{display:flex;flex-direction:column;gap:var(--pui-space-xs);min-width:0}.pui-waffle__heading{display:flex;align-items:baseline;justify-content:space-between;gap:var(--pui-space-normal)}.pui-waffle__label{font-size:var(--pui-font-size-body-medium);line-height:var(--pui-line-height-body-medium);font-weight:var(--pui-font-weight-medium)}.pui-waffle__value{color:var(--pui-text-secondary);font-size:var(--pui-font-size-label);line-height:var(--pui-line-height-label);font-variant-numeric:tabular-nums}.pui-waffle__grid{display:grid;grid-template-columns:repeat(var(--pui-waffle-columns),var(--pui-waffle-cell-size));gap:var(--pui-space-xs);max-width:100%}.pui-waffle__cell--group-start{margin-left:var(--pui-space-xs)}
.pui-waffle__cell{box-sizing:border-box;width:var(--pui-waffle-cell-size);height:var(--pui-waffle-cell-size);background:var(--pui-chart-cell-gradient,var(--pui-chart-accent));box-shadow:inset 0 0 0 2rpx var(--pui-chart-fade-outline);opacity:0;transform:translateY(var(--pui-space-xs)) scale(.56);transition:opacity var(--pui-chart-duration) var(--pui-ease-standard),transform var(--pui-chart-duration) var(--pui-ease-standard),background-color var(--pui-chart-duration) var(--pui-ease-standard);transition-delay:var(--pui-chart-delay,0ms)}.pui-waffle--entered .pui-waffle__cell{opacity:var(--pui-waffle-opacity);transform:translateY(0) scale(1)}.pui-waffle--rounded .pui-waffle__cell{border-radius:var(--pui-chart-cell-radius)}.pui-waffle--circle .pui-waffle__cell{border-radius:var(--pui-radius-round)}.pui-waffle--square .pui-waffle__cell{border-radius:0}.pui-waffle--small{--pui-waffle-cell-size:20rpx}.pui-waffle--medium{--pui-waffle-cell-size:24rpx}.pui-waffle--large{--pui-waffle-cell-size:28rpx}
