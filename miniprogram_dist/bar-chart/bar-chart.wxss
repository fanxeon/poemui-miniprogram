.pui-bar-chart{display:flex;flex-direction:column;box-sizing:border-box;width:100%;min-width:0;gap:var(--pui-content-gap);color:var(--pui-text-primary);background:transparent;border:0;box-shadow:none}
.pui-bar-chart__plot{display:flex;flex-direction:column;gap:var(--pui-space-normal);min-width:0}.pui-bar-chart__scale{display:flex;align-items:center;justify-content:space-between;gap:var(--pui-space-normal);color:var(--pui-text-secondary);font-size:var(--pui-font-size-caption);line-height:var(--pui-line-height-caption);font-variant-numeric:tabular-nums}.pui-bar-chart__item{display:flex;flex-direction:column;gap:var(--pui-space-xs);min-width:0}.pui-bar-chart__heading{display:flex;align-items:baseline;justify-content:space-between;gap:var(--pui-space-normal);min-width:0}.pui-bar-chart__label{min-width:0;font-size:var(--pui-font-size-body-medium);line-height:var(--pui-line-height-body-medium);font-weight:var(--pui-font-weight-medium)}.pui-bar-chart__value{flex:none;color:var(--pui-text-secondary);font-size:var(--pui-font-size-label);line-height:var(--pui-line-height-label);font-variant-numeric:tabular-nums}
.pui-bar-chart__tracks{display:flex;flex-direction:column;gap:var(--pui-space-xs);min-width:0}.pui-bar-chart__track{display:flex;width:100%;height:var(--pui-chart-bar-size);min-width:0;overflow:hidden;background:var(--pui-chart-track);border-radius:var(--pui-radius-round)}.pui-bar-chart__segment{flex:0 0 var(--pui-bar-ratio);width:var(--pui-bar-ratio);height:100%;background:var(--pui-chart-gradient);opacity:.28;transform:scaleX(0);transform-origin:left center;transition:flex-basis var(--pui-chart-duration) var(--pui-ease-standard),width var(--pui-chart-duration) var(--pui-ease-standard),height var(--pui-chart-duration) var(--pui-ease-standard),opacity var(--pui-chart-duration) var(--pui-ease-standard),transform var(--pui-chart-duration) var(--pui-ease-standard);transition-delay:var(--pui-chart-delay,0ms)}.pui-bar-chart--entered .pui-bar-chart__segment{opacity:1;transform:scaleX(1)}
.pui-bar-chart__group{display:grid;grid-template-columns:minmax(96rpx,auto) minmax(0,1fr);align-items:center;gap:var(--pui-space-sm)}.pui-bar-chart__segment-label{color:var(--pui-text-secondary);font-size:var(--pui-font-size-caption);line-height:var(--pui-line-height-caption)}.pui-bar-chart--small{--pui-chart-bar-size:16rpx}.pui-bar-chart--medium{--pui-chart-bar-size:24rpx}.pui-bar-chart--large{--pui-chart-bar-size:32rpx}
.pui-bar-chart--grid .pui-bar-chart__track{background-color:var(--pui-chart-track);background-image:linear-gradient(90deg,transparent 24%,var(--pui-chart-grid-line) 25%,transparent 26%,transparent 49%,var(--pui-chart-grid-line) 50%,transparent 51%,transparent 74%,var(--pui-chart-grid-line) 75%,transparent 76%)}
.pui-bar-chart--vertical.pui-bar-chart--grid .pui-bar-chart__track{background-image:linear-gradient(0deg,transparent 24%,var(--pui-chart-grid-line) 25%,transparent 26%,transparent 49%,var(--pui-chart-grid-line) 50%,transparent 51%,transparent 74%,var(--pui-chart-grid-line) 75%,transparent 76%)}
.pui-bar-chart--vertical .pui-bar-chart__plot{display:grid;grid-auto-flow:column;grid-auto-columns:minmax(88rpx,1fr);align-items:end;gap:var(--pui-space-normal);min-height:320rpx}.pui-bar-chart--vertical .pui-bar-chart__item{height:100%;justify-content:flex-end}.pui-bar-chart--vertical .pui-bar-chart__heading{order:2;justify-content:center;flex-wrap:wrap;text-align:center}.pui-bar-chart--vertical .pui-bar-chart__tracks{flex:1;justify-content:flex-end}.pui-bar-chart--vertical .pui-bar-chart__track{flex-direction:column-reverse;align-items:stretch;width:var(--pui-chart-bar-size);height:260rpx;margin:0 auto}.pui-bar-chart--vertical .pui-bar-chart__segment{flex-basis:var(--pui-bar-ratio);width:100%;height:var(--pui-bar-ratio);background:var(--pui-chart-gradient-vertical);transform:scaleY(0);transform-origin:center bottom}.pui-bar-chart--vertical.pui-bar-chart--entered .pui-bar-chart__segment{transform:scaleY(1)}.pui-bar-chart--vertical.pui-bar-chart--grouped .pui-bar-chart__tracks{flex-direction:row;align-items:flex-end;justify-content:center}.pui-bar-chart--vertical .pui-bar-chart__group{display:flex;flex-direction:column-reverse;align-items:center;gap:var(--pui-space-xs)}.pui-bar-chart--vertical .pui-bar-chart__group .pui-bar-chart__track{height:220rpx}
.pui-bar-chart__empty{padding:var(--pui-space-xl) 0;color:var(--pui-text-secondary);font-size:var(--pui-font-size-body-medium);line-height:var(--pui-line-height-body-medium);text-align:center}
.pui-chart-legend{display:flex;align-items:center;flex-wrap:wrap;gap:var(--pui-space-xs) var(--pui-space-normal);color:var(--pui-text-secondary);font-size:var(--pui-font-size-caption);line-height:var(--pui-line-height-caption)}.pui-chart-legend__item{display:inline-flex;align-items:center;gap:var(--pui-space-xs)}.pui-chart-legend__swatch{width:16rpx;height:16rpx;background:var(--pui-chart-accent);border-radius:var(--pui-radius-round)}
.pui-chart-theme--neutral{--pui-chart-accent:var(--pui-chart-accent-neutral);--pui-chart-gradient:var(--pui-chart-gradient-neutral);--pui-chart-gradient-vertical:var(--pui-chart-gradient-vertical-neutral)}.pui-chart-theme--violet{--pui-chart-accent:var(--pui-chart-accent-violet);--pui-chart-gradient:var(--pui-chart-gradient-violet);--pui-chart-gradient-vertical:var(--pui-chart-gradient-vertical-violet)}.pui-chart-theme--blue{--pui-chart-accent:var(--pui-chart-accent-blue);--pui-chart-gradient:var(--pui-chart-gradient-blue);--pui-chart-gradient-vertical:var(--pui-chart-gradient-vertical-blue)}.pui-chart-theme--teal{--pui-chart-accent:var(--pui-chart-accent-teal);--pui-chart-gradient:var(--pui-chart-gradient-teal);--pui-chart-gradient-vertical:var(--pui-chart-gradient-vertical-teal)}.pui-chart-theme--pink{--pui-chart-accent:var(--pui-chart-accent-pink);--pui-chart-gradient:var(--pui-chart-gradient-pink);--pui-chart-gradient-vertical:var(--pui-chart-gradient-vertical-pink)}.pui-chart-theme--amber{--pui-chart-accent:var(--pui-chart-accent-amber);--pui-chart-gradient:var(--pui-chart-gradient-amber);--pui-chart-gradient-vertical:var(--pui-chart-gradient-vertical-amber)}
.pui-bar-chart--reduced-motion .pui-bar-chart__segment{transition-duration:1ms;transition-delay:0ms}
