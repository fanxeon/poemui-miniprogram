.pui-select{--pui-select-title-options-gap:0;box-sizing:border-box;width:100%;color:var(--pui-text-primary)}.pui-select.pui-spacing--equal{--pui-select-title-options-gap:var(--pui-surface-inset)}.pui-select__trigger.pui-button{min-height:84rpx;justify-content:flex-start;padding:0 var(--pui-space-step-12);font-weight:var(--pui-font-weight-regular);text-align:left;transition:opacity var(--pui-select-duration) var(--pui-select-ease),background-color var(--pui-select-duration) var(--pui-select-ease),border-color var(--pui-select-duration) var(--pui-select-ease)}.pui-select__trigger .pui-button__content{flex:1 1 auto;justify-content:flex-start;text-align:left}.pui-select__trigger .pui-button__suffix{color:var(--pui-text-secondary);transition:transform var(--pui-select-duration) var(--pui-select-ease)}.pui-select--open .pui-select__trigger .pui-button__suffix{transform:rotate(180deg)}.pui-select--placeholder .pui-select__trigger,.pui-select--readonly .pui-select__trigger,.pui-select--empty .pui-select__trigger{color:var(--pui-text-secondary)}.pui-select__options{display:flex;flex-direction:column;gap:var(--pui-control-gap);padding:0}.pui-select__option.pui-button{justify-content:flex-start;min-height:80rpx;padding:0 var(--pui-space-step-12);border-radius:var(--pui-radius-medium);font-weight:var(--pui-font-weight-regular);text-align:left}.pui-select__option .pui-button__content{flex:1 1 auto;justify-content:flex-start;text-align:left}.pui-select__option--selected.pui-button{color:var(--pui-color-brand);background:var(--pui-bg-muted)!important}.pui-select__option .pui-button__suffix{color:currentColor}
