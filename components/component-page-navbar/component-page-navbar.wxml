<pui-navbar
  title="{{title}}"
  left-arrow="{{false}}"
  left-btn="{{navbarLeftBtn}}"
  right-btn="{{navbarRightBtn}}"
  fixed="{{false}}"
  capsule="{{true}}"
  safe-area-inset-top="{{true}}"
  bordered="{{false}}"
  bind:leftBtn="onBack"
  bind:rightBtn="onOpenAppearance"
/>

<pui-popup
  visible="{{appearancePopupVisible}}"
  placement="bottom"
  card="{{true}}"
  show-header
  title="外观"
  blur-overlay
  prevent-scroll-through
  z-index="11010"
  aria-label="外观设置"
  bind:visible-change="onAppearancePopupVisibleChange"
>
  <pui-button
    slot="header-left"
    theme="primary"
    variant="base"
    shape="circle"
    size="small"
    icon="refresh"
    icon-only
    aria-label="恢复默认外观"
    bind:click="onResetAppearance"
  />
  <appearance-settings />
</pui-popup>
