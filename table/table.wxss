.pui-table__content { box-sizing: border-box; min-width: 100%; }
.pui-table__row { display: flex; min-height: var(--pui-table-row-height); color: var(--pui-text-primary); background: var(--pui-glass-surface-strong); transition: color var(--pui-table-duration) var(--pui-table-easing), background-color var(--pui-table-duration) var(--pui-table-easing), opacity var(--pui-table-duration) var(--pui-table-easing); }
.pui-table__row--head { min-height: var(--pui-table-header-height); color: var(--pui-text-secondary); background: var(--pui-bg-muted); }
.pui-table__row--head { position: sticky; top: 0; z-index: 5; }
.pui-table--bordered .pui-table__body .pui-table__row { border-top: 1rpx solid var(--pui-border-color); }
.pui-table--stripe .pui-table__body .pui-table__row:nth-child(even) { background: var(--pui-bg-muted); }
