.pui-tour{position:fixed;inset:0;pointer-events:none;color:var(--pui-text-primary)}
.pui-tour__mask{position:fixed;box-sizing:border-box;pointer-events:auto;opacity:0;background:var(--pui-overlay-background,rgba(9,9,11,.46));transition:opacity var(--pui-tour-duration) var(--pui-ease-standard)}
.pui-tour--entered .pui-tour__mask{opacity:1}.pui-tour--overlay-blur .pui-tour__mask,.pui-frosted-glass--on .pui-tour__mask{-webkit-backdrop-filter:var(--pui-overlay-blur);backdrop-filter:var(--pui-overlay-blur)}
.pui-tour__target{position:fixed;box-sizing:border-box;pointer-events:none;border:2rpx solid var(--pui-color-brand);border-radius:var(--pui-radius-large);box-shadow:0 0 0 4rpx rgba(124,58,237,.12);opacity:0;transition:opacity var(--pui-tour-duration) var(--pui-ease-standard)}
.pui-tour--entered .pui-tour__target{opacity:1}
.pui-tour__panel{position:fixed;display:flex;box-sizing:border-box;min-width:0;max-width:calc(100vw - 32px);flex-direction:column;gap:var(--pui-surface-stack-gap);padding:var(--pui-surface-inset);overflow:auto;color:var(--pui-text-primary);pointer-events:auto;background:var(--pui-glass-surface-strong);border:1rpx solid var(--pui-glass-border);border-radius:var(--pui-radius-xlarge);box-shadow:var(--pui-shadow-floating);-webkit-backdrop-filter:var(--pui-frosted-filter);backdrop-filter:var(--pui-frosted-filter);opacity:0;transform:translateY(12rpx) scale(.98);transition:opacity var(--pui-tour-duration) var(--pui-ease-standard),transform var(--pui-tour-duration) var(--pui-ease-standard)}
.pui-tour__panel--top{transform:translateY(-12rpx) scale(.98)}.pui-tour__panel--left{transform:translateX(-12rpx) scale(.98)}.pui-tour__panel--right{transform:translateX(12rpx) scale(.98)}
.pui-tour--entered .pui-tour__panel{opacity:1;transform:translate(0,0) scale(1)}
.pui-tour__header{display:flex;align-items:flex-start;justify-content:space-between;gap:var(--pui-surface-stack-gap)}.pui-tour__heading{display:flex;min-width:0;flex-direction:column;gap:var(--pui-space-step-2)}.pui-tour__title{font-size:var(--pui-font-size-title-small);font-weight:var(--pui-font-weight-semibold);line-height:var(--pui-line-height-title-small);overflow-wrap:anywhere}.pui-tour__indicator{color:var(--pui-text-placeholder);font-size:var(--pui-font-size-caption);line-height:var(--pui-line-height-caption)}
.pui-tour__content{color:var(--pui-text-secondary);font-size:var(--pui-font-size-body-medium);line-height:var(--pui-line-height-body-medium);overflow-wrap:anywhere}.pui-tour__footer{display:flex;align-items:center;justify-content:flex-end;gap:var(--pui-surface-stack-gap)}
.pui-spacing--equal .pui-tour__panel{gap:var(--pui-surface-inset)}
.pui-tour--reduced-motion .pui-tour__mask,.pui-tour--reduced-motion .pui-tour__target,.pui-tour--reduced-motion .pui-tour__panel{transition-duration:1ms}
