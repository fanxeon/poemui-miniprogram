.pui-radar-chart{position:relative;display:flex;box-sizing:border-box;width:100%;min-width:0;flex-direction:column;align-items:center;gap:var(--pui-content-gap);color:var(--pui-text-primary);background:transparent;border:0;box-shadow:none;--pui-radar-chart-size:360rpx}
.pui-radar-chart__plot{position:relative;width:var(--pui-radar-chart-size);height:var(--pui-radar-chart-size);max-width:100%;overflow:hidden}
.pui-radar-chart__canvas{display:block;width:100%;height:100%;opacity:0;transform:scale(.72);transform-origin:center;transition:opacity var(--pui-chart-duration) var(--pui-ease-standard),transform var(--pui-chart-duration) var(--pui-ease-standard)}
.pui-radar-chart--entered .pui-radar-chart__canvas{opacity:1;transform:scale(1)}
.pui-radar-chart__probes{position:absolute;inset:0;overflow:hidden;opacity:0;pointer-events:none}
.pui-radar-chart__probe{position:absolute;width:2rpx;height:2rpx;background:var(--pui-chart-accent)}
.pui-radar-chart__probe--grid{background:var(--pui-chart-grid-line)}.pui-radar-chart__probe--text{color:var(--pui-text-secondary);background:transparent}
.pui-radar-chart--small{--pui-radar-chart-size:280rpx}.pui-radar-chart--medium{--pui-radar-chart-size:360rpx}.pui-radar-chart--large{--pui-radar-chart-size:440rpx}
.pui-radar-chart--reduced-motion .pui-radar-chart__canvas{transition-duration:1ms}
.pui-radar-chart__empty{width:100%;padding:var(--pui-space-xl) 0;color:var(--pui-text-secondary);font-size:var(--pui-font-size-body-medium);line-height:var(--pui-line-height-body-medium);text-align:center}
.pui-chart-legend{display:flex;align-items:center;justify-content:center;flex-wrap:wrap;gap:var(--pui-space-xs) var(--pui-space-normal);color:var(--pui-text-secondary);font-size:var(--pui-font-size-caption);line-height:var(--pui-line-height-caption)}
.pui-chart-legend__item{display:inline-flex;align-items:center;gap:var(--pui-space-xs)}.pui-chart-legend__swatch{width:16rpx;height:16rpx;background:var(--pui-chart-accent);border-radius:var(--pui-radius-round)}
.pui-chart-theme--neutral{--pui-chart-accent:var(--pui-chart-accent-neutral)}.pui-chart-theme--violet{--pui-chart-accent:var(--pui-chart-accent-violet)}.pui-chart-theme--blue{--pui-chart-accent:var(--pui-chart-accent-blue)}.pui-chart-theme--teal{--pui-chart-accent:var(--pui-chart-accent-teal)}.pui-chart-theme--pink{--pui-chart-accent:var(--pui-chart-accent-pink)}.pui-chart-theme--amber{--pui-chart-accent:var(--pui-chart-accent-amber)}
