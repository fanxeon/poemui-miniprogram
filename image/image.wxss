.pui-image {
  position: relative;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 120rpx;
  min-height: 120rpx;
  overflow: hidden;
  color: var(--pui-text-secondary);
  background: var(--pui-bg-muted);
  border: 2rpx solid var(--pui-border-color);
  opacity: 1;
  transform: scale(1);
  transition: opacity var(--pui-image-duration, var(--pui-duration-normal)) var(--pui-ease-standard), transform var(--pui-image-duration, var(--pui-duration-normal)) var(--pui-ease-standard);
}

.pui-image--rectangle { border-radius: var(--pui-radius-medium); }
.pui-image--round { border-radius: var(--pui-radius-large); }
.pui-image--circle { border-radius: var(--pui-radius-round); }

.pui-image__node {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 100%;
  opacity: 0;
  transition: opacity var(--pui-image-duration, var(--pui-duration-normal)) var(--pui-ease-standard);
}
.pui-image__node--loaded { opacity: 1; }

.pui-image__state {
  position: absolute;
  z-index: 1;
  inset: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: var(--pui-space-xs);
  box-sizing: border-box;
  padding: var(--pui-space-normal);
  color: var(--pui-text-secondary);
  font-size: var(--pui-font-size-small);
  line-height: var(--pui-line-height-small);
  text-align: center;
  background: var(--pui-bg-muted);
}
.pui-image__state--error { color: var(--pui-color-danger); }
.pui-image__slot { position: absolute; z-index: 2; inset: 0; pointer-events: auto; }
