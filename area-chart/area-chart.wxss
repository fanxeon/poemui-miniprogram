.pui-area-chart{position:relative;display:flex;flex-direction:column;box-sizing:border-box;width:100%;min-width:0;gap:var(--pui-content-gap);color:var(--pui-text-primary);background:transparent;border:0;box-shadow:none;--pui-area-chart-height:320rpx}
.pui-area-chart__plot{display:flex;flex-direction:column;gap:var(--pui-space-xs);min-width:0}.pui-area-chart__canvas-wrap{position:relative;width:100%;height:var(--pui-area-chart-height);min-width:0;overflow:hidden}.pui-area-chart__canvas{display:block;width:100%;height:100%;opacity:0;transform:translateY(var(--pui-space-sm));transition:opacity var(--pui-chart-duration) var(--pui-ease-standard),transform var(--pui-chart-duration) var(--pui-ease-standard)}.pui-area-chart--entered .pui-area-chart__canvas{opacity:1;transform:translateY(0)}
.pui-area-chart__axis{display:flex;align-items:flex-start;width:100%;min-width:0;color:var(--pui-text-secondary);font-size:var(--pui-font-size-caption);line-height:var(--pui-line-height-caption)}.pui-area-chart__axis-label{flex:1;min-width:0;text-align:center}.pui-area-chart__axis-label:first-child{text-align:left}.pui-area-chart__axis-label:last-child{text-align:right}
.pui-area-chart__probes{position:absolute;inset:0;overflow:hidden;opacity:0;pointer-events:none}.pui-area-chart__probe{position:absolute;width:2rpx;height:2rpx;background:transparent}.pui-area-chart__probe--series{background:var(--pui-chart-accent)}.pui-area-chart__probe--grid{background:var(--pui-chart-grid-line)}.pui-area-chart__probe--fill-start{opacity:var(--pui-chart-area-fill-start)}.pui-area-chart__probe--fill-end{opacity:var(--pui-chart-area-fill-end)}
.pui-area-chart--small{--pui-area-chart-height:240rpx}.pui-area-chart--medium{--pui-area-chart-height:320rpx}.pui-area-chart--large{--pui-area-chart-height:400rpx}.pui-area-chart--reduced-motion .pui-area-chart__canvas{transition-duration:1ms}.pui-area-chart__empty{padding:var(--pui-space-xl) 0;color:var(--pui-text-secondary);font-size:var(--pui-font-size-body-medium);line-height:var(--pui-line-height-body-medium);text-align:center}
.pui-chart-legend{display:flex;align-items:center;flex-wrap:wrap;gap:var(--pui-space-xs) var(--pui-space-normal);color:var(--pui-text-secondary);font-size:var(--pui-font-size-caption);line-height:var(--pui-line-height-caption)}.pui-chart-legend__item{display:inline-flex;align-items:center;gap:var(--pui-space-xs)}.pui-chart-legend__swatch{width:16rpx;height:16rpx;background:var(--pui-chart-accent);border-radius:var(--pui-radius-round)}
.pui-chart-theme--neutral{--pui-chart-accent:var(--pui-chart-accent-neutral)}.pui-chart-theme--violet{--pui-chart-accent:var(--pui-chart-accent-violet)}.pui-chart-theme--blue{--pui-chart-accent:var(--pui-chart-accent-blue)}.pui-chart-theme--teal{--pui-chart-accent:var(--pui-chart-accent-teal)}.pui-chart-theme--pink{--pui-chart-accent:var(--pui-chart-accent-pink)}.pui-chart-theme--amber{--pui-chart-accent:var(--pui-chart-accent-amber)}
