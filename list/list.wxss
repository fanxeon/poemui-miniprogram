  padding: var(--pui-space-xs) var(--pui-space-sm);
  overflow: hidden;
  background: var(--pui-glass-surface-strong);
  border-top: 1rpx solid var(--pui-border-color);
  opacity: 1;
  transition: max-height var(--pui-list-duration) var(--pui-list-easing), min-height var(--pui-list-duration) var(--pui-list-easing), padding var(--pui-list-duration) var(--pui-list-easing), background-color var(--pui-list-duration) var(--pui-list-easing), border-color var(--pui-list-duration) var(--pui-list-easing), opacity var(--pui-list-duration) var(--pui-list-easing);
}

.pui-list__footer--inactive { max-height: 0; min-height: 0; padding-top: 0; padding-bottom: 0; border-color: transparent; opacity: 0; pointer-events: none; }
.pui-list .pui-list__footer-button { width: 100%; min-height: 60rpx; }

.pui-list--reduced,
.pui-list--reduced .pui-list__header,
.pui-list--reduced .pui-list__content,
.pui-list--reduced .pui-list__item-wrap--entering,
.pui-list--reduced .pui-list__item,
.pui-list--reduced .pui-list__state,
.pui-list--reduced .pui-list__footer {
  transition-duration: 1ms;
  animation-duration: 1ms;
}
