  border: 1rpx solid transparent;
  border-radius: var(--pui-radius-large);
  box-shadow: var(--pui-glass-shadow-soft);
  -webkit-backdrop-filter: var(--pui-frosted-filter);
  backdrop-filter: var(--pui-frosted-filter);
  transition: color var(--pui-list-duration) var(--pui-list-easing), background-color var(--pui-list-duration) var(--pui-list-easing), border-color var(--pui-list-duration) var(--pui-list-easing), border-radius var(--pui-list-duration) var(--pui-list-easing), box-shadow var(--pui-list-duration) var(--pui-list-easing), opacity var(--pui-list-duration) var(--pui-list-easing);
}

.pui-list--bordered { border-color: var(--pui-border-color); }
.pui-list--borderless { border-color: transparent; box-shadow: none; }
.pui-list--disabled { opacity: 0.56; }

.pui-list__header {
