.pui-scroll-area {
  position: relative;
  box-sizing: border-box;
  width: 100%;
}

.pui-scroll-area__viewport {
  box-sizing: border-box;
  width: 100%;
  height: 100%;
}

.pui-scroll-area__content {
  box-sizing: border-box;
  width: 100%;
  min-height: 100%;
}

.pui-scroll-area__gradient {
  position: absolute;
  z-index: 1;
  right: 0;
  left: 0;
  height: var(--pui-scroll-area-gradient-overlay-size);
  pointer-events: none;
}

.pui-scroll-area__edge-sentinel {
  width: 100%;
  height: 1px;
  pointer-events: none;
  opacity: 0;
}

.pui-scroll-area__gradient--top {
  top: 0;
  background: linear-gradient(to bottom, var(--pui-scroll-area-gradient-overlay-color), transparent);
}

.pui-scroll-area__gradient--bottom {
  bottom: 0;
  background: linear-gradient(to top, var(--pui-scroll-area-gradient-overlay-color), transparent);
}
