.pui-progress{display:flex;flex-direction:column;gap:var(--pui-space-sm);box-sizing:border-box;max-width:100%;color:var(--pui-text-primary)}
.pui-progress__body{box-sizing:border-box;min-width:0}.pui-progress__body--line{display:flex;align-items:center;width:100%;gap:var(--pui-space-normal)}
.pui-progress__track{position:relative;flex:1;min-width:0;overflow:hidden;background:var(--pui-progress-track);border-radius:var(--pui-radius-round)}
.pui-progress__bar{position:relative;height:100%;overflow:hidden;background:var(--pui-progress-color);border-radius:inherit;transition:width var(--pui-progress-duration) var(--pui-progress-ease),background-color var(--pui-progress-duration) var(--pui-progress-ease)}
.pui-progress__info{display:inline-flex;align-items:center;justify-content:flex-end;flex:0 0 auto;gap:var(--pui-space-xs);min-width:72rpx;max-width:45%;color:var(--pui-text-secondary);font-size:24rpx;line-height:34rpx;text-align:right;overflow-wrap:anywhere;transition:color var(--pui-progress-duration) var(--pui-progress-ease)}
.pui-progress--success .pui-progress__info{color:var(--pui-color-success)}.pui-progress--warning .pui-progress__info{color:var(--pui-color-warning)}.pui-progress--error .pui-progress__info{color:var(--pui-color-danger)}
.pui-progress__body--plump{display:flex;align-items:center;width:100%;gap:var(--pui-space-normal)}.pui-progress__track--plump{height:100%;min-height:32rpx}.pui-progress__info--inside{position:absolute;top:0;right:var(--pui-space-xs);height:100%;max-width:calc(100% - var(--pui-space-normal));color:var(--pui-text-on-inverse);font-size:24rpx}.pui-progress__info--outside{min-width:72rpx}
.pui-progress__body--circle{display:inline-flex;align-self:flex-start}.pui-progress__circle{position:relative;box-sizing:border-box;overflow:hidden;border-radius:var(--pui-radius-round)}.pui-progress__circle-track,.pui-progress__circle-mask,.pui-progress__circle-fill{position:absolute;top:0;left:0;box-sizing:border-box;border-radius:var(--pui-radius-round)}.pui-progress__circle-track{background:var(--pui-progress-track);transition:background-color var(--pui-progress-duration) var(--pui-progress-ease)}.pui-progress__circle-progress{position:absolute;top:0;right:0;bottom:0;left:0;transform:rotate(-90deg)}.pui-progress__circle-mask,.pui-progress__circle-fill{transition:transform var(--pui-progress-duration) var(--pui-progress-ease),background-color var(--pui-progress-duration) var(--pui-progress-ease)}.pui-progress__circle-fill{background:var(--pui-progress-color)}.pui-progress__circle-inner{position:absolute;z-index:2;display:flex;align-items:center;justify-content:center;overflow:hidden;background:var(--pui-bg-container);border-radius:var(--pui-radius-round);transition:background-color var(--pui-progress-duration) var(--pui-progress-ease)}.pui-progress__info--circle{flex-direction:column;justify-content:center;min-width:0;max-width:100%;padding:var(--pui-space-xs);color:var(--pui-text-primary);font-size:24rpx;line-height:32rpx;text-align:center}
.pui-progress--reduced-motion .pui-progress__bar,.pui-progress--reduced-motion .pui-progress__info,.pui-progress--reduced-motion .pui-progress__circle-track,.pui-progress--reduced-motion .pui-progress__circle-mask,.pui-progress--reduced-motion .pui-progress__circle-fill,.pui-progress--reduced-motion .pui-progress__circle-inner{transition-duration:1ms}
